# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supremeshare_db
DB_USER=postgres
DB_PASSWORD=

# Connection String (PostgreSQL)
CONNECTION_STRING=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# JWT Settings (if using authentication)
JWT_SECRET=
JWT_ISSUER=SupremeShare
JWT_AUDIENCE=SupremeShare
JWT_EXPIRATION_MINUTES=60

# Email Settings (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@supremeshare.com

# Other Settings
ALLOWED_HOSTS=*
