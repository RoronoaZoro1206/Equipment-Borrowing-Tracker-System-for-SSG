# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supremeshare_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ===========================================
# Connection String (Auto-built from above)
# ===========================================
# Format: Host=<host>;Port=<port>;Database=<db>;Username=<user>;Password=<pass>
CONNECTION_STRING=Host=localhost;Port=5432;Database=supremeshare_db;Username=postgres;Password=your_password_here

# ===========================================
# Application Settings
# ===========================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# ===========================================
# Session Settings
# ===========================================
SESSION_TIMEOUT_MINUTES=30

# ===========================================
# Rate Limiting Settings
# ===========================================
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_SECOND=10
