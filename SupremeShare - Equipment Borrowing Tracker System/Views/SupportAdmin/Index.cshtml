@{
    ViewData["Title"] = "Support Admin Dashboard";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<!-- Hero Banner -->
<div class="dashboard-hero">
    <div class="hero-bg" style="background-image: url('/File_Images/admin-MAIN.png');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <div class="hero-logo">
            <img src="~/File_Images/533693089_1177970501030425_4668075712780998242_n.jpg" alt="SSG Logo" />
        </div>
        <div class="hero-text">
            <h1>Supreme Student Government</h1>
            <p>Cebu Technological University - Main Campus</p>
        </div>
    </div>
    <div class="hero-stripe"></div>
</div>

<!-- Dashboard Stats -->
<div class="dashboard-section">
    <div class="section-header">
        <h2 class="section-title"><i class="bi bi-grid-3x3-gap-fill"></i> Dashboard</h2>
    </div>
    
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="status-card borrowed">
                <div class="status-icon"><i class="bi bi-box-arrow-up-right"></i></div>
                <div class="status-label">Borrowed</div>
                <div class="status-value">@(ViewBag.BorrowedCount ?? 0)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="status-card available">
                <div class="status-icon"><i class="bi bi-check-circle"></i></div>
                <div class="status-label">Returned</div>
                <div class="status-value">@(ViewBag.ReturnedCount ?? 0)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="status-card review">
                <div class="status-icon"><i class="bi bi-clock-history"></i></div>
                <div class="status-label">Overdue</div>
                <div class="status-value">@(ViewBag.OverdueCount ?? 0)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="status-card lost">
                <div class="status-icon"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="status-label">Lost/Missing</div>
                <div class="status-value">@(ViewBag.LostCount ?? 0)</div>
            </div>
        </div>
    </div>
</div>

<!-- Transaction Search -->
<div class="transaction-search-section">
    <div class="search-box">
        <input type="text" id="transactionCode" class="form-control" placeholder="Transaction Code" />
        <button class="btn-search" onclick="searchTransaction()">
            <i class="bi bi-search"></i>
        </button>
    </div>
</div>

<!-- Transaction Details Card -->
<div class="transaction-details-card" id="transactionDetails" style="display: none;">
    <div class="card-header">
        <h4 class="card-title">Transaction Details</h4>
        <button class="btn-close-card" onclick="closeTransactionDetails()">Close X</button>
    </div>
    
    <!-- Transaction Code Banner -->
    <div class="transaction-code-banner">
        <span class="label">Transaction Code:</span>
        <span class="code" id="txnCode">--</span>
    </div>
    
    <!-- Borrower Information -->
    <div class="borrower-info-section">
        <h5 class="info-title">Borrower Information</h5>
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Student ID:</span>
                <span class="info-value" id="studentId">--</span>
            </div>
            <div class="info-item">
                <span class="info-label">Full Name:</span>
                <span class="info-value" id="studentName">--</span>
            </div>
            <div class="info-item">
                <span class="info-label">College:</span>
                <span class="info-value" id="studentCollege">--</span>
            </div>
            <div class="info-item">
                <span class="info-label">Course:</span>
                <span class="info-value" id="studentCourse">--</span>
            </div>
            <div class="info-item">
                <span class="info-label">E-mail:</span>
                <span class="info-value" id="studentEmail">--</span>
            </div>
            <div class="info-item">
                <span class="info-label">Contact No:</span>
                <span class="info-value" id="studentContact">--</span>
            </div>
            <div class="info-item">
                <span class="info-label">Status:</span>
                <span class="info-value" id="studentStatus">--</span>
            </div>
        </div>
    </div>
    
    <!-- Remarks -->
    <div class="remarks-section">
        <label class="remarks-label">Remarks:</label>
        <div class="remarks-box" id="txnRemarks">--</div>
    </div>
    
    <!-- Transaction Meta -->
    <div class="transaction-meta">
        <div class="meta-item">
            <span class="meta-label">Recorded by:</span>
            <span class="meta-value" id="recordedBy">--</span>
        </div>
        <div class="meta-item">
            <span class="meta-label">Date Borrowed:</span>
            <span class="meta-value" id="dateBorrowed">--</span>
        </div>
        <div class="meta-item">
            <span class="meta-label">Transaction Last Updated:</span>
            <span class="meta-value" id="lastUpdated">--</span>
        </div>
    </div>
    
    <!-- Borrowing Information Table -->
    <div class="borrowing-info-section">
        <h5 class="info-title">Borrowing Information</h5>
        <div class="table-responsive">
            <table class="borrowing-table">
                <thead>
                    <tr>
                        <th>Equipment Category</th>
                        <th>Equipment</th>
                        <th>Serial No.</th>
                        <th>Current Status</th>
                        <th>Date Borrowed</th>
                        <th>Due Date</th>
                        <th>Date Returned</th>
                        <th>Return Condition</th>
                        <th>Last Updated</th>
                    </tr>
                </thead>
                <tbody id="borrowingTableBody">
                    <tr>
                        <td colspan="9" class="text-center text-muted">No items found</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Timeline -->
    <div class="timeline-section">
        <h5 class="info-title">Timeline</h5>
        <div class="table-responsive">
            <table class="timeline-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Action Taken</th>
                        <th>By</th>
                    </tr>
                </thead>
                <tbody id="timelineTableBody">
                    <tr>
                        <td colspan="3" class="text-center text-muted">No timeline data</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function() {
    loadDashboardStats();
});

function loadDashboardStats() {
    $.get('/SupportAdmin/Transactions/Stats', function(res) {
        if (res.success) {
            // Update the status cards with actual data
            $('.status-card.borrowed .status-value').text(res.data.activeBorrows);
            $('.status-card.available .status-value').text(res.data.returnedToday);
            $('.status-card.review .status-value').text(res.data.overdueCount);
            $('.status-card.lost .status-value').text(res.data.lostCount);
        }
    });
}

function searchTransaction() {
    const code = document.getElementById('transactionCode').value.trim();
    if (!code) return;

    $.get(`/SupportAdmin/Transactions/SearchByCode?code=${encodeURIComponent(code)}`, function(res) {
        if (res.success && res.data) {
            const d = res.data;
            document.getElementById('transactionDetails').style.display = 'block';
            document.getElementById('txnCode').textContent = d.transactionCode;
            document.getElementById('studentId').textContent = d.student.studentIdNumber;
            document.getElementById('studentName').textContent = d.student.fullName;
            document.getElementById('studentCollege').textContent = d.student.studentCollege || '-';
            document.getElementById('studentCourse').textContent = '-';
            document.getElementById('studentEmail').textContent = '-';
            document.getElementById('studentContact').textContent = '-';
            document.getElementById('studentStatus').textContent = 'Active';
            document.getElementById('txnRemarks').textContent = d.transactionRemarks || 'No remarks';
            document.getElementById('recordedBy').textContent = '-';
            document.getElementById('dateBorrowed').textContent = new Date(d.transactionDateBorrowed).toLocaleString();
            document.getElementById('lastUpdated').textContent = '-';

            // Populate borrowing table
            let itemsHtml = '';
            d.items.forEach(i => {
                const statusCls = i.borrowStatus === 'returned' ? 'text-success' : 
                                  i.borrowStatus === 'overdue' ? 'text-danger' : 'text-info';
                itemsHtml += `<tr>
                    <td>-</td>
                    <td>${i.equipmentName || '-'}</td>
                    <td>${i.serialNo || '-'}</td>
                    <td class="${statusCls}">${i.borrowStatus}</td>
                    <td>${new Date(d.transactionDateBorrowed).toLocaleDateString()}</td>
                    <td>${new Date(i.borrowDueDate).toLocaleDateString()}</td>
                    <td>${i.borrowDateReturned ? new Date(i.borrowDateReturned).toLocaleDateString() : '-'}</td>
                    <td>${i.borrowReturnCondition !== null ? (i.borrowReturnCondition ? 'Good' : 'Damaged') : '-'}</td>
                    <td>-</td>
                </tr>`;
            });
            document.getElementById('borrowingTableBody').innerHTML = itemsHtml || '<tr><td colspan="9" class="text-center text-muted">No items found</td></tr>';
        } else {
            alert(res.message || 'Transaction not found');
        }
    });
}

function closeTransactionDetails() {
    document.getElementById('transactionDetails').style.display = 'none';
}

// Allow Enter key to search
document.getElementById('transactionCode').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
        searchTransaction();
    }
});
</script>
}
