@{
    ViewData["Title"] = "Transactions";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="page-icon-trans">
                <i class="bi bi-arrow-left-right"></i>
            </div>
            <div>
                <h2 class="page-title mb-0">Transactions</h2>
                <p class="text-muted mb-0 small">View and manage all borrowing transactions</p>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/SupportAdmin/Transactions/Borrow" class="btn btn-action-borrow">
                <i class="bi bi-box-arrow-up me-1"></i>New Borrow
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card-trans active-borrows">
                <div class="stat-icon-trans"><i class="bi bi-clock-history"></i></div>
                <div class="stat-content-trans">
                    <span class="stat-value-trans" id="statActiveBorrows">0</span>
                    <span class="stat-label-trans">Active Borrows</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card-trans overdue">
                <div class="stat-icon-trans"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="stat-content-trans">
                    <span class="stat-value-trans" id="statOverdue">0</span>
                    <span class="stat-label-trans">Overdue</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card-trans returned">
                <div class="stat-icon-trans"><i class="bi bi-check-circle"></i></div>
                <div class="stat-content-trans">
                    <span class="stat-value-trans" id="statReturnedToday">0</span>
                    <span class="stat-label-trans">Returned Today</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card-trans borrowed">
                <div class="stat-icon-trans"><i class="bi bi-box-arrow-up"></i></div>
                <div class="stat-content-trans">
                    <span class="stat-value-trans" id="statBorrowedToday">0</span>
                    <span class="stat-label-trans">Borrowed Today</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="trans-card">
        <div class="trans-card-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-table"></i>
                <span>Recent Transactions</span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-update-overdue-trans" id="btnUpdateOverdue">
                    <i class="bi bi-clock-history me-1"></i>Update Overdue
                </button>
                <button class="btn btn-refresh-trans" id="btnRefresh" title="Refresh">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                </button>
            </div>
        </div>
        <div class="trans-card-body">
            <!-- Filter Row -->
            <div class="filter-row-trans mb-3">
                <div class="filter-group-trans">
                    <label class="filter-label-trans"><i class="bi bi-funnel me-1"></i>Filters:</label>
                    <select id="filterStatus" class="filter-select-trans">
                        <option value="">All Status</option>
                        <option value="borrowed">Borrowed</option>
                        <option value="returned">Returned</option>
                        <option value="overdue">Overdue</option>
                    </select>
                    <select id="filterDateRange" class="filter-select-trans">
                        <option value="">All Time</option>
                        <option value="today">Today</option>
                        <option value="week">This Week</option>
                        <option value="month">This Month</option>
                    </select>
                    <button class="btn btn-clear-filter-trans" id="btnClearFilters" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-trans mb-0" id="transactionsTable">
                    <thead>
                        <tr>
                            <th>Transaction Code</th>
                            <th>Student ID</th>
                            <th>Borrower Name</th>
                            <th>Recorded By</th>
                            <th>Date Borrowed</th>
                            <th>Last Updated</th>
                            <th>Remarks</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="spinner-border text-danger" role="status"></div>
                                <p class="text-muted mt-2 mb-0">Loading transactions...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Transaction Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content modal-trans">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-receipt me-2"></i>Transaction Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailsContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-danger" role="status"></div>
                    <p class="text-muted mt-2">Loading details...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Borrow Record Modal -->
<div class="modal fade" id="editBorrowModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-trans">
            <div class="modal-header">
                <h5 class="modal-title" style="font-family: 'Playfair Display', serif;"><i class="bi bi-pencil-square me-2"></i>Edit Borrow Record</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="editBorrowContent">
                <form id="editBorrowForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editBorrowId" name="borrowId">
                    
                    <!-- Read-only Info -->
                    <div class="edit-info-section mb-4">
                        <h6 class="edit-section-title"><i class="bi bi-info-circle me-2"></i>Item Information (Read-only)</h6>
                        <div class="edit-info-grid">
                            <div class="edit-info-item">
                                <label>Transaction Code</label>
                                <span id="editTransactionCode" class="fw-bold text-danger">-</span>
                            </div>
                            <div class="edit-info-item">
                                <label>Student</label>
                                <span id="editStudentInfo">-</span>
                            </div>
                            <div class="edit-info-item">
                                <label>Equipment</label>
                                <span id="editEquipmentName" class="fw-bold">-</span>
                            </div>
                            <div class="edit-info-item">
                                <label>Serial Number</label>
                                <code id="editSerialNo">-</code>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Editable Fields -->
                    <div class="edit-fields-section">
                        <h6 class="edit-section-title"><i class="bi bi-pencil me-2"></i>Editable Fields</h6>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Current Status <span class="text-danger">*</span></label>
                                <select class="form-select edit-select" id="editStatus" name="status" required>
                                    <option value="borrowed">Borrowed</option>
                                    <option value="returned">Returned</option>
                                    <option value="overdue">Overdue</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Due Date <span class="text-danger">*</span></label>
                                <input type="datetime-local" class="form-control edit-input" id="editDueDate" name="dueDate" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Date Returned</label>
                                <input type="datetime-local" class="form-control edit-input" id="editDateReturned" name="dateReturned">
                                <small class="text-muted">Leave empty if not yet returned</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Return Condition</label>
                                <div class="condition-select-group">
                                    <label class="condition-option good">
                                        <input type="radio" name="returnCondition" value="true">
                                        <span><i class="bi bi-check-circle-fill me-1"></i>Good</span>
                                    </label>
                                    <label class="condition-option damaged">
                                        <input type="radio" name="returnCondition" value="false">
                                        <span><i class="bi bi-x-circle-fill me-1"></i>Damaged</span>
                                    </label>
                                    <label class="condition-option none">
                                        <input type="radio" name="returnCondition" value="" checked>
                                        <span><i class="bi bi-dash-circle me-1"></i>N/A</span>
                                    </label>
                                </div>
                                <small class="text-muted">Set condition when item is returned</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="edit-note-box mt-4">
                        <i class="bi bi-info-circle me-2"></i>
                        <span>The <strong>Last Updated</strong> field will automatically update when changes are saved.</span>
                    </div>
                    
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-save-edit" id="btnSaveEdit">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<style>
/* Transactions Page - Maroon Theme */
.page-icon-trans { width: 56px; height: 56px; background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); border-radius: 16px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem; box-shadow: 0 8px 24px rgba(139, 0, 0, 0.25); }

/* Action Buttons */
.btn-action-borrow { background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 600; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(139, 0, 0, 0.25); }
.btn-action-borrow:hover { box-shadow: 0 6px 20px rgba(139, 0, 0, 0.35); color: white; }
.btn-action-return { background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 600; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(22, 163, 74, 0.25); }
.btn-action-return:hover { box-shadow: 0 6px 20px rgba(22, 163, 74, 0.35); color: white; }

/* Stat Cards */
.stat-card-trans { background: white; border-radius: 16px; padding: 20px; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06); border: 1px solid rgba(0, 0, 0, 0.05); transition: all 0.3s ease; overflow: hidden; position: relative; }
.stat-card-trans::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; }
.stat-card-trans.active-borrows::before { background: var(--primary-red); }
.stat-card-trans.overdue::before { background: #ef4444; }
.stat-card-trans.returned::before { background: #22c55e; }
.stat-card-trans.borrowed::before { background: #3b82f6; }
.stat-card-trans:hover { transform: translateY(-4px); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1); }
.stat-icon-trans { width: 52px; height: 52px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
.stat-card-trans.active-borrows .stat-icon-trans { background: rgba(139, 0, 0, 0.1); color: var(--primary-red); }
.stat-card-trans.overdue .stat-icon-trans { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
.stat-card-trans.returned .stat-icon-trans { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
.stat-card-trans.borrowed .stat-icon-trans { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
.stat-content-trans { display: flex; flex-direction: column; }
.stat-value-trans { font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 700; color: var(--text-dark); line-height: 1; }
.stat-label-trans { font-size: 0.8rem; color: #6b7280; margin-top: 4px; }

/* Transaction Card */
.trans-card { background: white; border-radius: 16px; box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06); overflow: hidden; border: 1px solid rgba(139, 0, 0, 0.08); }
.trans-card-header { display: flex; justify-content: space-between; align-items: center; padding: 18px 24px; background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); color: white; font-weight: 600; }
.trans-card-body { padding: 24px; }
.btn-refresh-trans { background: rgba(255, 255, 255, 0.2); border: none; color: white; padding: 8px 16px; border-radius: 8px; font-size: 0.85rem; font-weight: 500; transition: all 0.3s ease; }
.btn-refresh-trans:hover { background: rgba(255, 255, 255, 0.3); color: white; }
.btn-update-overdue-trans { background: rgba(255, 255, 255, 0.2); border: none; color: white; padding: 8px 16px; border-radius: 8px; font-size: 0.85rem; font-weight: 500; transition: all 0.3s ease; }
.btn-update-overdue-trans:hover { background: rgba(255, 255, 255, 0.3); color: white; }

/* Item Action Buttons */
.btn-item-return { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); color: white; border: none; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; transition: all 0.3s ease; }
.btn-item-return:hover { box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3); color: white; transform: translateY(-1px); }

/* Lost status badge */
.status-badge-trans.lost { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; }

/* Filter Row */
.filter-row-trans { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding: 16px; background: linear-gradient(135deg, #fafafa 0%, #fff 100%); border-radius: 12px; border: 1px solid rgba(139, 0, 0, 0.08); }
.filter-group-trans { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
.filter-label-trans { font-weight: 600; font-size: 0.85rem; color: var(--primary-red); margin: 0; white-space: nowrap; }
.filter-select-trans { padding: 8px 16px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 0.85rem; background: white; cursor: pointer; transition: all 0.3s ease; min-width: 130px; }
.filter-select-trans:focus { border-color: var(--primary-red); outline: none; box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1); }
.btn-clear-filter-trans { background: transparent; border: 2px solid #e5e7eb; color: #6b7280; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease; }
.btn-clear-filter-trans:hover { background: #ef4444; border-color: #ef4444; color: white; }

/* Table Styling */
.table-trans thead th { background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); color: white; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; padding: 14px 12px; border: none; white-space: nowrap; }
.table-trans tbody td { padding: 14px 12px; vertical-align: middle; border-bottom: 1px solid rgba(0, 0, 0, 0.05); }
.table-trans tbody tr { cursor: pointer; transition: all 0.2s ease; }
.table-trans tbody tr:hover { background: rgba(139, 0, 0, 0.05); }

/* Status Badges */
.status-badge-trans { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
.status-badge-trans.borrowed { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; }
.status-badge-trans.returned { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); color: white; }
.status-badge-trans.overdue { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; }

/* Action Buttons */
.btn-open-trans { background: transparent; border: 2px solid var(--primary-red); color: var(--primary-red); padding: 6px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 600; transition: all 0.3s ease; }
.btn-open-trans:hover { background: var(--primary-red); color: white; }
.btn-edit-trans { background: transparent; border: 2px solid #f59e0b; color: #f59e0b; padding: 6px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 600; transition: all 0.3s ease; }
.btn-edit-trans:hover { background: #f59e0b; color: white; }
.action-btn-group { display: flex; gap: 6px; justify-content: center; }

/* Modal Styling */
.modal-trans { border-radius: 16px; overflow: hidden; border: none; }
.modal-trans .modal-header { background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); color: white; border: none; padding: 20px 24px; }
.modal-trans .modal-body { padding: 24px; background: #f8f9fa; }

/* Transaction Header Card */
.trans-header-card { background: white; border-radius: 16px; padding: 24px; margin-bottom: 20px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06); border: 1px solid rgba(139, 0, 0, 0.08); }
.trans-code-display { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--primary-red); margin-bottom: 16px; }
.borrower-info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
.borrower-info-item { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: #fafafa; border-radius: 10px; }
.borrower-info-icon { width: 40px; height: 40px; background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1rem; }
.borrower-info-content { display: flex; flex-direction: column; }
.borrower-info-label { font-size: 0.7rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px; }
.borrower-info-value { font-weight: 600; color: var(--text-dark); font-size: 0.9rem; }

/* Remarks Section */
.remarks-section { background: white; border-radius: 16px; padding: 20px; margin-bottom: 20px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06); border: 1px solid rgba(139, 0, 0, 0.08); }
.remarks-title { font-weight: 600; color: var(--primary-red); margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
.remarks-textarea { width: 100%; min-height: 80px; padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 0.9rem; resize: vertical; transition: all 0.3s ease; }
.remarks-textarea:focus { border-color: var(--primary-red); outline: none; box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1); }
.remarks-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 12px; }
.btn-save-remarks { background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); color: white; border: none; padding: 8px 20px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; transition: all 0.3s ease; }
.btn-save-remarks:hover { box-shadow: 0 4px 12px rgba(139, 0, 0, 0.3); color: white; }
.btn-save-remarks:disabled { opacity: 0.6; cursor: not-allowed; }

/* Borrowing Information Table */
.borrow-info-section { background: white; border-radius: 16px; overflow: hidden; margin-bottom: 20px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06); border: 1px solid rgba(139, 0, 0, 0.08); }
.borrow-info-header { background: linear-gradient(135deg, #fafafa 0%, #fff 100%); padding: 16px 20px; border-bottom: 1px solid rgba(139, 0, 0, 0.1); }
.borrow-info-title { font-weight: 600; color: var(--primary-red); margin: 0; display: flex; align-items: center; gap: 8px; }
.table-borrow-info thead th { background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); color: white; font-weight: 600; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; padding: 12px 10px; border: none; }
.table-borrow-info tbody td { padding: 12px 10px; vertical-align: middle; border-bottom: 1px solid rgba(0, 0, 0, 0.05); font-size: 0.85rem; }
.table-borrow-info tbody tr:hover { background: rgba(139, 0, 0, 0.03); }

/* Condition Badges */
.badge-condition { padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; }
.badge-condition.good { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); color: white; }
.badge-condition.damaged { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; }

/* Timeline Section */
.timeline-section { background: white; border-radius: 16px; padding: 20px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06); border: 1px solid rgba(139, 0, 0, 0.08); }
.timeline-title { font-weight: 600; color: var(--primary-red); margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
.timeline-list { position: relative; padding-left: 24px; }
.timeline-list::before { content: ''; position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, var(--primary-red), #e5e7eb); }
.timeline-item { position: relative; padding-bottom: 20px; }
.timeline-item:last-child { padding-bottom: 0; }
.timeline-dot { position: absolute; left: -20px; top: 4px; width: 12px; height: 12px; background: var(--primary-red); border-radius: 50%; border: 2px solid white; box-shadow: 0 0 0 2px var(--primary-red); }
.timeline-content { background: #fafafa; padding: 12px 16px; border-radius: 10px; }
.timeline-action { font-weight: 600; color: var(--text-dark); font-size: 0.9rem; }
.timeline-meta { display: flex; gap: 16px; margin-top: 4px; font-size: 0.75rem; color: #6b7280; }
.timeline-meta span { display: flex; align-items: center; gap: 4px; }

/* Edit Modal Styles */
.edit-info-section { background: #f8f9fa; border-radius: 12px; padding: 20px; border: 1px solid rgba(139, 0, 0, 0.1); }
.edit-section-title { font-weight: 600; color: var(--primary-red); margin-bottom: 16px; display: flex; align-items: center; }
.edit-info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
.edit-info-item { display: flex; flex-direction: column; gap: 4px; }
.edit-info-item label { font-size: 0.75rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px; }
.edit-info-item span, .edit-info-item code { font-size: 0.9rem; color: var(--text-dark); }
.edit-fields-section { background: white; border-radius: 12px; padding: 20px; border: 2px solid rgba(139, 0, 0, 0.15); }
.edit-select, .edit-input { border: 2px solid #e5e7eb; border-radius: 8px; padding: 10px 14px; transition: all 0.3s ease; }
.edit-select:focus, .edit-input:focus { border-color: var(--primary-red); box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1); outline: none; }
.condition-select-group { display: flex; gap: 8px; flex-wrap: wrap; }
.condition-option { cursor: pointer; margin: 0; }
.condition-option input { display: none; }
.condition-option span { display: inline-flex; align-items: center; padding: 8px 14px; border-radius: 8px; border: 2px solid #e5e7eb; font-size: 0.85rem; font-weight: 500; transition: all 0.3s ease; }
.condition-option.good input:checked + span { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-color: #22c55e; color: #16a34a; }
.condition-option.damaged input:checked + span { background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); border-color: #ef4444; color: #dc2626; }
.condition-option.none input:checked + span { background: #f3f4f6; border-color: #9ca3af; color: #6b7280; }
.condition-option span:hover { border-color: #9ca3af; }
.edit-note-box { padding: 12px 16px; background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-radius: 10px; font-size: 0.85rem; color: #92400e; display: flex; align-items: center; }
.btn-save-edit { background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); color: white; border: none; padding: 10px 24px; border-radius: 10px; font-weight: 600; transition: all 0.3s ease; }
.btn-save-edit:hover { box-shadow: 0 4px 12px rgba(139, 0, 0, 0.3); color: white; }

/* Item Selector Styles */
.item-selector-list { display: flex; flex-direction: column; gap: 10px; max-height: 300px; overflow-y: auto; }
.item-selector-card { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; background: #f8f9fa; border: 2px solid #e5e7eb; border-radius: 10px; cursor: pointer; transition: all 0.3s ease; }
.item-selector-card:hover { border-color: var(--primary-red); background: rgba(139, 0, 0, 0.05); transform: translateX(4px); }
.item-selector-info { display: flex; flex-direction: column; }
.item-selector-popup { width: 450px !important; }

/* Responsive */
@@media (max-width: 991px) { .stat-card-trans { padding: 16px; } .stat-value-trans { font-size: 1.5rem; } }
@@media (max-width: 768px) { .filter-row-trans { padding: 12px; } .filter-group-trans { width: 100%; } .filter-select-trans { flex: 1; min-width: 100px; } .borrower-info-grid { grid-template-columns: 1fr; } .action-btn-group { flex-direction: column; } .edit-info-grid { grid-template-columns: 1fr; } }
</style>


@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
let transactionsTable;
let signalRConnection;
let currentTransactionId = null;

$(document).ready(function() {
    loadStats();
    initTransactionsTable();
    setupFilterHandlers();
    initSignalR();
});

function initSignalR() {
    signalRConnection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/dashboard")
        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
        .build();

    signalRConnection.on("StatsUpdated", function() {
        loadStats();
        if (transactionsTable) transactionsTable.ajax.reload(null, false);
    });

    signalRConnection.on("OverdueAlert", function(count) {
        if (count > 0) {
            showToast("⚠️ " + count + " item(s) are now overdue!", "warning");
        }
        loadStats();
        if (transactionsTable) transactionsTable.ajax.reload(null, false);
    });

    signalRConnection.on("NewTransaction", function(data) {
        loadStats();
        if (transactionsTable) transactionsTable.ajax.reload(null, false);
    });

    signalRConnection.start().catch(function(err) { console.error("SignalR error:", err); });
    signalRConnection.onreconnected(function() { loadStats(); });
}

function loadStats() {
    $.get('/SupportAdmin/Transactions/Stats', function(res) {
        if (res.success) {
            $('#statActiveBorrows').text(res.data.activeBorrows);
            $('#statOverdue').text(res.data.overdueCount);
            $('#statReturnedToday').text(res.data.returnedToday);
            $('#statBorrowedToday').text(res.data.borrowedToday);
        }
    });
}

function initTransactionsTable() {
    transactionsTable = $('#transactionsTable').DataTable({
        ajax: {
            url: '/SupportAdmin/Transactions/GetAll',
            dataSrc: function(json) {
                return json.success && json.data ? json.data : [];
            }
        },
        responsive: true,
        pageLength: 10,
        lengthMenu: [[5, 10, 25, 50], [5, 10, 25, 50]],
        order: [[4, 'desc']],
        language: {
            search: "",
            searchPlaceholder: "Search transactions...",
            lengthMenu: "Show _MENU_",
            info: "Showing _START_ to _END_ of _TOTAL_ transactions",
            emptyTable: '<div class="text-center py-5"><i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i><p class="text-muted mt-3 mb-0">No transactions found</p></div>'
        },
        columns: [
            { 
                data: 'transactionCode',
                render: function(data) {
                    return '<strong class="text-danger">' + data + '</strong>';
                }
            },
            { 
                data: 'studentIdNumber',
                render: function(data) {
                    return '<code class="text-dark">' + data + '</code>';
                }
            },
            { 
                data: 'studentName',
                render: function(data) {
                    return '<strong>' + data + '</strong>';
                }
            },
            { 
                data: 'processedBy',
                render: function(data) {
                    return '<span class="text-muted">' + data + '</span>';
                }
            },
            { 
                data: 'dateBorrowed',
                render: function(data) {
                    return '<small class="text-muted">' + data + '</small>';
                }
            },
            { 
                data: 'lastUpdated',
                render: function(data) {
                    return '<small class="text-muted">' + (data || '-') + '</small>';
                }
            },
            { 
                data: 'remarks',
                render: function(data) {
                    if (!data || data.trim() === '') return '<span class="text-muted">-</span>';
                    var truncated = data.length > 30 ? data.substring(0, 30) + '...' : data;
                    return '<span title="' + data.replace(/"/g, '&quot;') + '">' + truncated + '</span>';
                }
            },
            {
                data: 'transactionId',
                orderable: false,
                className: 'text-center',
                render: function(data) {
                    return '<div class="action-btn-group">' +
                        '<button class="btn btn-open-trans btn-open" data-id="' + data + '" title="View Details"><i class="bi bi-folder2-open me-1"></i>Open</button>' +
                        '<button class="btn btn-edit-trans btn-edit" data-id="' + data + '" title="Edit Transaction"><i class="bi bi-pencil me-1"></i>Edit</button>' +
                    '</div>';
                }
            }
        ]
    });
}

function setupFilterHandlers() {
    $('#filterStatus').on('change', applyFilters);
    $('#filterDateRange').on('change', applyFilters);
    
    $('#btnClearFilters').on('click', function() {
        $('#filterStatus').val('');
        $('#filterDateRange').val('');
        transactionsTable.search('').columns().search('').draw();
        showToast('Filters cleared', 'info');
    });
    
    $('#btnRefresh').on('click', function() {
        showToast('Refreshing...', 'info');
        loadStats();
        transactionsTable.ajax.reload();
    });
    
    // Update Overdue button handler
    $('#btnUpdateOverdue').on('click', function() {
        var $btn = $(this);
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Updating...');
        
        $.post('/SupportAdmin/Transactions/UpdateOverdue', { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function(res) {
            $btn.prop('disabled', false).html('<i class="bi bi-clock-history me-1"></i>Update Overdue');
            if (res.success) {
                showToast('Overdue records updated', 'success');
                transactionsTable.ajax.reload();
                loadStats();
            } else {
                showToast(res.message, 'error');
            }
        }).fail(function() {
            $btn.prop('disabled', false).html('<i class="bi bi-clock-history me-1"></i>Update Overdue');
            showToast('Failed to update overdue records', 'error');
        });
    });
}

// Return item button handler
$(document).on('click', '.btn-item-return', function() {
    var borrowId = $(this).data('id');
    var serial = $(this).data('serial');
    
    Swal.fire({
        title: 'Process Return',
        html: 'Return item <strong>' + serial + '</strong>?<br><br>' +
              '<label class="form-label">Return Condition:</label>' +
              '<select id="returnCondition" class="form-select">' +
              '<option value="true">✓ Good Condition</option>' +
              '<option value="false">✗ Damaged (will be sent for review)</option>' +
              '</select>',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#22c55e',
        cancelButtonColor: '#6b7280',
        confirmButtonText: '<i class="bi bi-check-circle me-1"></i>Process Return',
        cancelButtonText: 'Cancel',
        preConfirm: function() {
            return document.getElementById('returnCondition').value;
        }
    }).then(function(result) {
        if (result.isConfirmed) {
            var condition = result.value === 'true';
            $.post('/SupportAdmin/Transactions/ProcessReturn', {
                BorrowId: borrowId,
                Condition: condition,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function(res) {
                if (res.success) {
                    showToast(res.message, 'success');
                    if (currentTransactionId) {
                        openTransactionDetails(currentTransactionId);
                    }
                    transactionsTable.ajax.reload();
                    loadStats();
                } else {
                    showToast(res.message, 'error');
                }
            }).fail(function() {
                showToast('Failed to process return', 'error');
            });
        }
    });
});

function applyFilters() {
    var statusFilter = $('#filterStatus').val();
    transactionsTable.search('').columns().search('');
    if (statusFilter) {
        // Filter will be applied on statuses column if we add it back
    }
    transactionsTable.draw();
}

// Open Transaction Details - via button click
$(document).on('click', '.btn-open', function(e) {
    e.stopPropagation();
    var id = $(this).data('id');
    openTransactionDetails(id);
});

// Open Transaction Details - via row click
$('#transactionsTable tbody').on('click', 'tr', function(e) {
    // Don't trigger if clicking on a button
    if ($(e.target).closest('button').length) return;
    
    var data = transactionsTable.row(this).data();
    if (data && data.transactionId) {
        openTransactionDetails(data.transactionId);
    }
});

function openTransactionDetails(id) {
    currentTransactionId = id;
    
    $('#detailsContent').html('<div class="text-center py-4"><div class="spinner-border text-danger" role="status"></div><p class="text-muted mt-2">Loading details...</p></div>');
    new bootstrap.Modal('#detailsModal').show();
    
    $.get('/SupportAdmin/Transactions/GetDetails/' + id, function(res) {
        if (res.success) {
            renderTransactionDetails(res.data);
        } else {
            $('#detailsContent').html('<div class="alert alert-danger">Failed to load transaction details.</div>');
        }
    }).fail(function() {
        $('#detailsContent').html('<div class="alert alert-danger">An error occurred. Please try again.</div>');
    });
}

function renderTransactionDetails(d) {
    var itemsHtml = '';
    d.items.forEach(function(i) {
        var statusClass = i.borrowStatus === 'returned' ? 'returned' : i.borrowStatus === 'overdue' ? 'overdue' : i.borrowStatus === 'lost' ? 'lost' : 'borrowed';
        var conditionHtml = i.borrowReturnCondition !== null 
            ? (i.borrowReturnCondition ? '<span class="badge-condition good"><i class="bi bi-check-circle-fill me-1"></i>Good</span>' : '<span class="badge-condition damaged"><i class="bi bi-x-circle-fill me-1"></i>Damaged</span>')
            : '<span class="text-muted">-</span>';
        var dateReturned = i.borrowDateReturned ? formatDate(i.borrowDateReturned) : '<span class="text-muted">-</span>';
        var lastUpdated = i.borrowLastUpdated ? formatDate(i.borrowLastUpdated) : '<span class="text-muted">-</span>';
        
        // Return button for active items (borrowed/overdue)
        var canReturn = i.borrowStatus === 'borrowed' || i.borrowStatus === 'overdue';
        var actionHtml = canReturn 
            ? '<button class="btn btn-item-return" data-id="' + i.borrowId + '" data-serial="' + i.serialNo + '"><i class="bi bi-box-arrow-in-down me-1"></i>Return</button>'
            : '<span class="text-muted small">-</span>';
        
        itemsHtml += '<tr>' +
            '<td><span class="badge bg-secondary">' + (i.equipmentCategory || '-') + '</span></td>' +
            '<td><strong>' + (i.equipmentName || '-') + '</strong></td>' +
            '<td><code class="text-danger">' + (i.serialNo || '-') + '</code></td>' +
            '<td><span class="status-badge-trans ' + statusClass + '">' + i.borrowStatus + '</span></td>' +
            '<td>' + formatDate(i.borrowDueDate) + (i.daysOverdue > 0 && i.borrowStatus !== 'returned' ? ' <span class="text-danger small">(' + i.daysOverdue + ' days)</span>' : '') + '</td>' +
            '<td>' + dateReturned + '</td>' +
            '<td>' + conditionHtml + '</td>' +
            '<td>' + actionHtml + '</td>' +
        '</tr>';
    });

    var timelineHtml = '';
    if (d.timeline && d.timeline.length > 0) {
        d.timeline.forEach(function(t) {
            timelineHtml += '<div class="timeline-item">' +
                '<div class="timeline-dot"></div>' +
                '<div class="timeline-content">' +
                    '<div class="timeline-action">' + t.action + '</div>' +
                    '<div class="timeline-meta">' +
                        '<span><i class="bi bi-calendar3"></i>' + (t.date ? formatDate(t.date) : '-') + '</span>' +
                        '<span><i class="bi bi-person"></i>' + (t.by || 'System') + '</span>' +
                    '</div>' +
                '</div>' +
            '</div>';
        });
    } else {
        timelineHtml = '<p class="text-muted mb-0">No timeline activity recorded.</p>';
    }

    var html = 
        '<!-- Transaction Header -->' +
        '<div class="trans-header-card">' +
            '<div class="trans-code-display"><i class="bi bi-receipt me-2"></i>' + d.transactionCode + '</div>' +
            '<div class="borrower-info-grid">' +
                '<div class="borrower-info-item">' +
                    '<div class="borrower-info-icon"><i class="bi bi-person-badge"></i></div>' +
                    '<div class="borrower-info-content">' +
                        '<span class="borrower-info-label">Student ID</span>' +
                        '<span class="borrower-info-value">' + (d.student.studentIdNumber || '-') + '</span>' +
                    '</div>' +
                '</div>' +
                '<div class="borrower-info-item">' +
                    '<div class="borrower-info-icon"><i class="bi bi-person"></i></div>' +
                    '<div class="borrower-info-content">' +
                        '<span class="borrower-info-label">Borrower Name</span>' +
                        '<span class="borrower-info-value">' + (d.student.fullName || '-') + '</span>' +
                    '</div>' +
                '</div>' +
                '<div class="borrower-info-item">' +
                    '<div class="borrower-info-icon"><i class="bi bi-building"></i></div>' +
                    '<div class="borrower-info-content">' +
                        '<span class="borrower-info-label">College</span>' +
                        '<span class="borrower-info-value">' + (d.student.studentCollege || '-') + '</span>' +
                    '</div>' +
                '</div>' +
                '<div class="borrower-info-item">' +
                    '<div class="borrower-info-icon"><i class="bi bi-calendar-event"></i></div>' +
                    '<div class="borrower-info-content">' +
                        '<span class="borrower-info-label">Date Borrowed</span>' +
                        '<span class="borrower-info-value">' + formatDate(d.transactionDateBorrowed) + '</span>' +
                    '</div>' +
                '</div>' +
                '<div class="borrower-info-item">' +
                    '<div class="borrower-info-icon"><i class="bi bi-person-check"></i></div>' +
                    '<div class="borrower-info-content">' +
                        '<span class="borrower-info-label">Recorded By</span>' +
                        '<span class="borrower-info-value">' + (d.recordedBy || '-') + '</span>' +
                    '</div>' +
                '</div>' +
                '<div class="borrower-info-item">' +
                    '<div class="borrower-info-icon"><i class="bi bi-clock-history"></i></div>' +
                    '<div class="borrower-info-content">' +
                        '<span class="borrower-info-label">Last Updated</span>' +
                        '<span class="borrower-info-value">' + (d.transactionLastUpdated ? formatDate(d.transactionLastUpdated) : '-') + '</span>' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</div>' +
        
        '<!-- Remarks Section -->' +
        '<div class="remarks-section">' +
            '<div class="remarks-title"><i class="bi bi-chat-left-text"></i>Remarks</div>' +
            '<textarea class="remarks-textarea" id="remarksInput" placeholder="Add remarks for this transaction...">' + (d.transactionRemarks || '') + '</textarea>' +
            '<div class="remarks-actions">' +
                '<button class="btn btn-save-remarks" id="btnSaveRemarks" data-id="' + d.transactionId + '"><i class="bi bi-check-lg me-1"></i>Save Remarks</button>' +
            '</div>' +
        '</div>' +
        
        '<!-- Borrowing Information Table -->' +
        '<div class="borrow-info-section">' +
            '<div class="borrow-info-header">' +
                '<h6 class="borrow-info-title"><i class="bi bi-box-seam"></i>Borrowing Information</h6>' +
            '</div>' +
            '<div class="table-responsive">' +
                '<table class="table table-borrow-info mb-0">' +
                    '<thead>' +
                        '<tr>' +
                            '<th>Equipment Category</th>' +
                            '<th>Equipment</th>' +
                            '<th>Serial No.</th>' +
                            '<th>Current Status</th>' +
                            '<th>Due Date</th>' +
                            '<th>Date Returned</th>' +
                            '<th>Return Condition</th>' +
                            '<th>Actions</th>' +
                        '</tr>' +
                    '</thead>' +
                    '<tbody>' + (itemsHtml || '<tr><td colspan="8" class="text-center text-muted py-4">No items found</td></tr>') + '</tbody>' +
                '</table>' +
            '</div>' +
        '</div>' +
        
        '<!-- Timeline Section -->' +
        '<div class="timeline-section">' +
            '<div class="timeline-title"><i class="bi bi-clock-history"></i>Timeline</div>' +
            '<div class="timeline-list">' + timelineHtml + '</div>' +
        '</div>';

    $('#detailsContent').html(html);
}

// Save Remarks
$(document).on('click', '#btnSaveRemarks', function() {
    var $btn = $(this);
    var transactionId = $btn.data('id');
    var remarks = $('#remarksInput').val();
    
    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');
    
    $.post('/SupportAdmin/Transactions/UpdateRemarks', {
        transactionId: transactionId,
        remarks: remarks
    }, function(res) {
        $btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i>Save Remarks');
        if (res.success) {
            showToast('Remarks saved successfully', 'success');
            transactionsTable.ajax.reload(null, false);
        } else {
            showToast(res.message || 'Failed to save remarks', 'error');
        }
    }).fail(function() {
        $btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i>Save Remarks');
        showToast('An error occurred', 'error');
    });
});

// Edit button click - opens edit modal with transaction items
$(document).on('click', '.btn-edit', function(e) {
    e.stopPropagation();
    var transactionId = $(this).data('id');
    openEditModal(transactionId);
});

let currentEditData = null;

function openEditModal(transactionId) {
    // First fetch transaction details
    $.get('/SupportAdmin/Transactions/GetDetails/' + transactionId, function(res) {
        if (res.success && res.data.items && res.data.items.length > 0) {
            currentEditData = res.data;
            
            // If multiple items, show item selector
            if (res.data.items.length > 1) {
                showItemSelector(res.data);
            } else {
                var item = res.data.items[0];
                populateEditModal(res.data, item);
                new bootstrap.Modal('#editBorrowModal').show();
            }
        } else {
            showToast('No borrow records found for this transaction', 'warning');
        }
    }).fail(function() {
        showToast('Failed to load transaction details', 'error');
    });
}

function showItemSelector(transaction) {
    var itemsHtml = '<div class="item-selector-list">';
    transaction.items.forEach(function(item, index) {
        var statusClass = item.borrowStatus === 'returned' ? 'success' : item.borrowStatus === 'overdue' ? 'danger' : 'primary';
        itemsHtml += '<div class="item-selector-card" data-index="' + index + '">' +
            '<div class="item-selector-info">' +
                '<strong>' + (item.equipmentName || 'Unknown') + '</strong>' +
                '<small class="text-muted d-block">Serial: ' + (item.serialNo || '-') + '</small>' +
            '</div>' +
            '<span class="badge bg-' + statusClass + '">' + item.borrowStatus + '</span>' +
        '</div>';
    });
    itemsHtml += '</div>';
    
    Swal.fire({
        title: 'Select Item to Edit',
        html: itemsHtml,
        showCancelButton: true,
        showConfirmButton: false,
        cancelButtonText: 'Cancel',
        cancelButtonColor: '#6b7280',
        customClass: { popup: 'item-selector-popup' },
        didOpen: function() {
            $('.item-selector-card').on('click', function() {
                var index = $(this).data('index');
                Swal.close();
                var item = currentEditData.items[index];
                populateEditModal(currentEditData, item);
                new bootstrap.Modal('#editBorrowModal').show();
            });
        }
    });
}

function populateEditModal(transaction, item) {
    $('#editBorrowId').val(item.borrowId);
    $('#editTransactionCode').text(transaction.transactionCode);
    $('#editStudentInfo').text(transaction.student.studentIdNumber + ' - ' + transaction.student.fullName);
    $('#editEquipmentName').text(item.equipmentName || '-');
    $('#editSerialNo').text(item.serialNo || '-');
    
    // Set status
    $('#editStatus').val(item.borrowStatus);
    
    // Set due date
    if (item.borrowDueDate) {
        var dueDate = new Date(item.borrowDueDate);
        $('#editDueDate').val(formatDateTimeLocal(dueDate));
    }
    
    // Set date returned
    if (item.borrowDateReturned) {
        var returnedDate = new Date(item.borrowDateReturned);
        $('#editDateReturned').val(formatDateTimeLocal(returnedDate));
    } else {
        $('#editDateReturned').val('');
    }
    
    // Set return condition
    if (item.borrowReturnCondition === true) {
        $('input[name="returnCondition"][value="true"]').prop('checked', true);
    } else if (item.borrowReturnCondition === false) {
        $('input[name="returnCondition"][value="false"]').prop('checked', true);
    } else {
        $('input[name="returnCondition"][value=""]').prop('checked', true);
    }
}

function formatDateTimeLocal(date) {
    var year = date.getFullYear();
    var month = String(date.getMonth() + 1).padStart(2, '0');
    var day = String(date.getDate()).padStart(2, '0');
    var hours = String(date.getHours()).padStart(2, '0');
    var minutes = String(date.getMinutes()).padStart(2, '0');
    return year + '-' + month + '-' + day + 'T' + hours + ':' + minutes;
}

// Handle edit form submission
$('#editBorrowForm').on('submit', function(e) {
    e.preventDefault();
    
    var $btn = $('#btnSaveEdit');
    var borrowId = $('#editBorrowId').val();
    var status = $('#editStatus').val();
    var dueDate = $('#editDueDate').val();
    var dateReturned = $('#editDateReturned').val();
    var returnCondition = $('input[name="returnCondition"]:checked').val();
    
    // Validation
    if (status === 'returned' && !dateReturned) {
        showToast('Please set Date Returned when status is Returned', 'warning');
        return;
    }
    
    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');
    
    $.ajax({
        url: '/SupportAdmin/Transactions/UpdateBorrowRecord',
        method: 'POST',
        data: {
            borrowId: borrowId,
            status: status,
            dueDate: dueDate,
            dateReturned: dateReturned || null,
            returnCondition: returnCondition === '' ? null : returnCondition,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(res) {
            $btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i>Save Changes');
            if (res.success) {
                Swal.fire({
                    title: 'Success!',
                    text: 'Borrow record updated successfully',
                    icon: 'success',
                    confirmButtonColor: '#8B0000'
                });
                bootstrap.Modal.getInstance(document.getElementById('editBorrowModal')).hide();
                transactionsTable.ajax.reload(null, false);
                loadStats();
            } else {
                showToast(res.message || 'Failed to update record', 'error');
            }
        },
        error: function() {
            $btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i>Save Changes');
            showToast('An error occurred while saving', 'error');
        }
    });
});

// Auto-set date returned when status changes to 'returned'
$('#editStatus').on('change', function() {
    if ($(this).val() === 'returned' && !$('#editDateReturned').val()) {
        var now = new Date();
        $('#editDateReturned').val(formatDateTimeLocal(now));
    }
});

// Modal cleanup for edit modal
$('#editBorrowModal').on('hidden.bs.modal', function() {
    currentEditData = null;
    $('#editBorrowForm')[0].reset();
    $('.modal-backdrop').remove();
    $('body').removeClass('modal-open').css('padding-right', '');
});

function formatDate(dateStr) {
    if (!dateStr) return '-';
    var d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
}

// Modal cleanup
$('#detailsModal').on('hidden.bs.modal', function() {
    currentTransactionId = null;
    $('.modal-backdrop').remove();
    $('body').removeClass('modal-open').css('padding-right', '');
});

function showToast(message, type) {
    var bgColors = {
        success: 'linear-gradient(135deg, #22c55e, #16a34a)',
        error: 'linear-gradient(135deg, #ef4444, #dc2626)',
        warning: 'linear-gradient(135deg, #f59e0b, #d97706)',
        info: 'linear-gradient(135deg, #8b0000, #5c0000)'
    };
    Toastify({
        text: message,
        duration: 3000,
        gravity: "top",
        position: "right",
        style: { background: bgColors[type] || bgColors.info, borderRadius: '10px', boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }
    }).showToast();
}

// SignalR real-time updates listener
document.addEventListener('signalr:update', function(e) {
    if (e.detail.type === 'transaction' || e.detail.type === 'all' || e.detail.type === 'stats' || e.detail.type === 'overdue') {
        console.log('[SupportAdmin Transactions] SignalR update received:', e.detail.type);
        loadStats();
        if (transactionsTable) {
            transactionsTable.ajax.reload(null, false);
        }
    }
});

// Expose loadTransactions globally for SignalR client compatibility
window.loadTransactions = function() {
    loadStats();
    if (transactionsTable) {
        transactionsTable.ajax.reload(null, false);
    }
};
</script>
}
