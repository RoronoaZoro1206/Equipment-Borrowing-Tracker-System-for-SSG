</style>

@section Scripts {
<script>
// Global state
let selectedStudent = null;
let borrowItems = [];
let studentsData = [];
let equipmentData = [];
let categoriesSet = new Set();
let studentsDataTable = null;

$(document).ready(function() {
    // Initialize
    loadStudents();
    loadEquipment();
    setDefaultDates();

    // Equipment category change
    $(document).on('change', '#equipmentCategory', function() {
        const category = $(this).val();
        
        $('#equipmentSelect').empty().append('<option value="">Select Equipment</option>');
        $('#serialNoSelect').empty().append('<option value="">Select Serial No.</option>').prop('disabled', true);
        
        if (category) {
            const filteredEquipment = equipmentData.filter(e => e.equipmentCategory === category);
            
            if (filteredEquipment.length > 0) {
                filteredEquipment.forEach(e => {
                    const stockText = e.availableStock > 0 ? `(${e.availableStock} available)` : '(No stock)';
                    const disabled = e.availableStock <= 0 ? 'disabled' : '';
                    $('#equipmentSelect').append(`<option value="${e.equipmentId}" data-name="${e.equipmentName}" ${disabled}>${e.equipmentName} ${stockText}</option>`);
                });
                $('#equipmentSelect').prop('disabled', false);
            } else {
                $('#equipmentSelect').append('<option value="" disabled>No equipment in this category</option>');
                $('#equipmentSelect').prop('disabled', true);
            }
        } else {
            $('#equipmentSelect').prop('disabled', true);
        }
        checkAddItemEnabled();
    });

    // Equipment change - load units
    $(document).on('change', '#equipmentSelect', function() {
        const equipmentId = $(this).val();
        
        $('#serialNoSelect').empty().append('<option value="">Select Serial No.</option>').prop('disabled', true);
        
        if (equipmentId) {
            $.ajax({
                url: `/SupportAdmin/Equipment/AvailableUnits/${equipmentId}`,
                type: 'GET',
                dataType: 'json',
                success: function(res) {
                    if (res.success && res.data && res.data.length > 0) {
                        res.data.forEach(u => {
                            $('#serialNoSelect').append(`<option value="${u.eunitId}" data-serial="${u.eunitSerialNo}" data-condition="${u.condition}">${u.eunitSerialNo} (${u.condition})</option>`);
                        });
                        $('#serialNoSelect').prop('disabled', false);
                    } else {
                        $('#serialNoSelect').append('<option value="" disabled>No available units</option>');
                    }
                },
                error: function() {
                    showToast('Error loading units', 'error');
                }
            });
        }
        checkAddItemEnabled();
    });

    // Serial number change
    $(document).on('change', '#serialNoSelect', function() {
        checkAddItemEnabled();
    });

    // Quick due date buttons
    $('.btn-due').click(function() {
        $('.btn-due').removeClass('active');
        $(this).addClass('active');
        const days = $(this).data('days');
        const due = new Date();
        due.setDate(due.getDate() + days);
        $('#dueDate').val(due.toISOString().slice(0, 16));
        checkAddItemEnabled();
    });

    // Add item to table
    $('#btnAddItem').click(addItemToTable);

    // Navigation
    $('#btnBackStep1').click(() => goToStep(1));
    $('#btnNextStep3').click(() => goToStep(3));
    $('#btnBackStep2').click(() => goToStep(2));

    // Confirm borrow with SweetAlert2
    $('#btnConfirmBorrow').click(confirmBorrow);

    // Save new student
    $('#btnSaveStudent').click(saveNewStudent);

    // Update student
    $('#btnUpdateStudent').click(updateStudent);

    // Select student from modal
    $('#btnSelectStudent').click(selectStudentFromModal);
});

function loadStudents() {
    $.get('/SupportAdmin/Students/GetAll', function(res) {
        if (res.success) {
            studentsData = res.data;
            populateFilterDropdowns(studentsData);
            initStudentsDataTable(studentsData);
            setupFilterHandlers();
        }
    });
}

function populateFilterDropdowns(data) {
    // Get unique colleges and courses
    const colleges = [...new Set(data.map(s => s.studentCollege).filter(c => c))].sort();
    const courses = [...new Set(data.map(s => s.studentCourse).filter(c => c))].sort();
    
    // Populate college dropdown
    $('#filterCollege').empty().append('<option value="">All Colleges</option>');
    colleges.forEach(c => {
        $('#filterCollege').append(`<option value="${c}">${c}</option>`);
    });
    
    // Populate course dropdown
    $('#filterCourse').empty().append('<option value="">All Courses</option>');
    courses.forEach(c => {
        $('#filterCourse').append(`<option value="${c}">${c}</option>`);
    });
}

function setupFilterHandlers() {
    // Filter change handlers
    $('#filterCollege, #filterCourse, #filterStatus').on('change', applyFilters);
    
    // Clear filters button
    $('#btnClearFilters').on('click', function() {
        $('#filterCollege').val('');
        $('#filterCourse').val('');
        $('#filterStatus').val('');
        applyFilters();
        showToast('Filters cleared', 'info');
    });
}

function applyFilters() {
    const collegeFilter = $('#filterCollege').val();
    const courseFilter = $('#filterCourse').val();
    const statusFilter = $('#filterStatus').val();
    
    // Filter the data
    let filteredData = studentsData.filter(s => {
        const matchCollege = !collegeFilter || s.studentCollege === collegeFilter;
        const matchCourse = !courseFilter || s.studentCourse === courseFilter;
        const matchStatus = statusFilter === '' || s.studentStatus.toString() === statusFilter;
        return matchCollege && matchCourse && matchStatus;
    });
    
    // Reinitialize DataTable with filtered data
    initStudentsDataTable(filteredData);
    
    // Update course dropdown based on selected college
    if (collegeFilter) {
        const coursesInCollege = [...new Set(
            studentsData
                .filter(s => s.studentCollege === collegeFilter)
                .map(s => s.studentCourse)
                .filter(c => c)
        )].sort();
        
        const currentCourse = $('#filterCourse').val();
        $('#filterCourse').empty().append('<option value="">All Courses</option>');
        coursesInCollege.forEach(c => {
            $('#filterCourse').append(`<option value="${c}" ${c === currentCourse ? 'selected' : ''}>${c}</option>`);
        });
    }
}

function initStudentsDataTable(data) {
    // Destroy existing DataTable if exists
    if (studentsDataTable) {
        studentsDataTable.destroy();
        $('#studentsTable tbody').empty();
    }

    studentsDataTable = $('#studentsTable').DataTable({
        data: data,
        responsive: true,
        pageLength: 10,
        lengthMenu: [[5, 10, 25, 50], [5, 10, 25, 50]],
        order: [[1, 'asc']],
        language: {
            search: "",
            searchPlaceholder: "Search students...",
            lengthMenu: "Show _MENU_",
            info: "Showing _START_ to _END_ of _TOTAL_ students",
            infoEmpty: "No students found",
            emptyTable: '<div class="text-center py-4"><i class="bi bi-people text-muted" style="font-size: 2.5rem;"></i><p class="text-muted mt-2 mb-0">No students found</p></div>'
        },
        columns: [
            { data: 'studentIdNumber' },
            { data: 'fullName' },
            { data: 'studentCollege', defaultContent: '-' },
            { data: 'studentCourse', defaultContent: '-' },
            { 
                data: 'studentEmail', 
                defaultContent: '-',
                className: 'd-none d-lg-table-cell'
            },
            { 
                data: 'studentContactNo', 
                defaultContent: '-',
                className: 'd-none d-md-table-cell'
            },
            { 
                data: 'studentStatus',
                render: function(data) {
                    return data 
                        ? '<span class="badge-status badge-active">Active</span>' 
                        : '<span class="badge-status badge-blocked">Blocked</span>';
                }
            },
            { 
                data: null,
                orderable: false,
                render: function(data, type, row) {
                    const selectBtn = row.studentStatus 
                        ? `<button class="btn btn-action-select btn-sm btn-choose-student" data-id="${row.studentId}" title="Select as Borrower">
                               <i class="bi bi-check2-square"></i>
                           </button>`
                        : `<button class="btn btn-secondary btn-sm" disabled title="Student is blocked">
                               <i class="bi bi-check2-square"></i>
                           </button>`;
                    
                    const editBtn = `<button class="btn btn-action-edit btn-sm btn-edit-student ms-1" data-id="${row.studentId}" title="View Details">
                                        <i class="bi bi-eye"></i>
                                     </button>`;
                    
                    return `<div class="d-flex">${selectBtn}${editBtn}</div>`;
                }
            }
        ],
        drawCallback: function() {
            // Rebind click events after each draw
            $('.btn-choose-student').off('click').on('click', function(e) {
                e.stopPropagation();
                const studentId = $(this).data('id');
                chooseStudent(studentId);
            });
            
            $('.btn-edit-student').off('click').on('click', function(e) {
                e.stopPropagation();
                const studentId = $(this).data('id');
                openStudentModal(studentId);
            });
        }
    });
}

function chooseStudent(studentId) {
    const student = studentsData.find(s => s.studentId === studentId);
    
    if (!student) {
        showToast('Student not found', 'error');
        return;
    }
    
    if (!student.studentStatus) {
        Swal.fire({
            icon: 'warning',
            title: 'Student Blocked',
            text: 'Cannot select blocked student. Please contact an administrator.',
            confirmButtonColor: 'var(--primary-red)'
        });
        return;
    }
    
    selectedStudent = student;
    $('#selectedStudentId').val(student.studentId);
    $('#selectedBorrowerName').text(student.fullName);
    
    // Update summary fields
    $('#sumStudentId').text(student.studentIdNumber);
    $('#sumFullName').text(student.fullName);
    $('#sumCollege').text(student.studentCollege || '-');
    $('#sumCourse').text(student.studentCourse || '-');
    
    goToStep(2);
    
    showToast(`Selected: ${student.fullName}`, 'success');
}

function openStudentModal(studentId) {
    const student = studentsData.find(s => s.studentId === studentId);
    if (!student) return;
    
    $('#editStudentId').val(student.studentId);
    $('#editStudentIdNumber').val(student.studentIdNumber);
    $('#editFirstName').val(student.fullName.split(' ')[0]);
    $('#editLastName').val(student.fullName.split(' ').slice(-1)[0]);
    $('#editCollege').val(student.studentCollege);
    $('#editCourse').val(student.studentCourse);
    $('#editEmail').val(student.studentEmail);
    $('#editContactNo').val(student.studentContactNo);
    $('#editStatus').val(student.studentStatus.toString());
    
    $('#btnSelectStudent').prop('disabled', !student.studentStatus);
    
    new bootstrap.Modal('#editStudentModal').show();
}

function selectStudentFromModal() {
    const studentId = parseInt($('#editStudentId').val());
    const student = studentsData.find(s => s.studentId === studentId);
    
    if (!student || !student.studentStatus) {
        showToast('Cannot select blocked student', 'error');
        return;
    }
    
    selectedStudent = student;
    $('#selectedStudentId').val(student.studentId);
    $('#selectedBorrowerName').text(student.fullName);
    
    $('#sumStudentId').text(student.studentIdNumber);
    $('#sumFullName').text(student.fullName);
    $('#sumCollege').text(student.studentCollege || '-');
    $('#sumCourse').text(student.studentCourse || '-');
    
    bootstrap.Modal.getInstance('#editStudentModal').hide();
    goToStep(2);
    
    showToast(`Selected: ${student.fullName}`, 'success');
}

function loadEquipment() {
    $.ajax({
        url: '/SupportAdmin/Equipment/GetAll',
        type: 'GET',
        dataType: 'json',
        success: function(res) {
            if (res.success && res.data) {
                equipmentData = res.data;
                
                $('#equipmentCategory').empty().append('<option value="">Select Category</option>');
                categoriesSet.clear();
                
                res.data.forEach(e => {
                    if (e.equipmentCategory) {
                        categoriesSet.add(e.equipmentCategory);
                    }
                });
                
                categoriesSet.forEach(c => {
                    $('#equipmentCategory').append(`<option value="${c}">${c}</option>`);
                });
                
                $('#equipmentCategory').prop('disabled', false);
            }
        },
        error: function() {
            showToast('Error loading equipment', 'error');
        }
    });
}

function setDefaultDates() {
    const now = new Date();
    $('#dateBorrowed').val(now.toLocaleString());
    $('#lastUpdated').val(now.toLocaleString());
    
    const defaultDue = new Date();
    defaultDue.setDate(defaultDue.getDate() + 7);
    $('#dueDate').val(defaultDue.toISOString().slice(0, 16));
}

function checkAddItemEnabled() {
    const hasEquipment = $('#equipmentSelect').val();
    const hasSerial = $('#serialNoSelect').val();
    const hasDue = $('#dueDate').val();
    $('#btnAddItem').prop('disabled', !(hasEquipment && hasSerial && hasDue));
}

function addItemToTable() {
    const category = $('#equipmentCategory option:selected').text();
    const equipmentName = $('#equipmentSelect option:selected').data('name');
    const serial = $('#serialNoSelect option:selected').data('serial');
    const unitId = $('#serialNoSelect').val();
    const dueDate = $('#dueDate').val();
    
    // Check if already added
    if (borrowItems.find(i => i.unitId === unitId)) {
        Swal.fire({
            icon: 'warning',
            title: 'Duplicate Item',
            text: 'This item is already added to the list.',
            confirmButtonColor: 'var(--primary-red)'
        });
        return;
    }
    
    borrowItems.push({
        unitId: unitId,
        category: category,
        equipmentName: equipmentName,
        serial: serial,
        dueDate: dueDate
    });
    
    renderItemsTable();
    
    // Reset form
    $('#equipmentCategory').val('');
    $('#equipmentSelect').empty().append('<option value="">Select Equipment</option>').prop('disabled', true);
    $('#serialNoSelect').empty().append('<option value="">Select Serial No.</option>').prop('disabled', true);
    $('.btn-due').removeClass('active');
    
    checkNextEnabled();
    showToast('Item added successfully', 'success');
}

function renderItemsTable() {
    if (borrowItems.length === 0) {
        $('#itemsTable tbody').html(`
            <tr class="empty-row">
                <td colspan="6" class="text-center py-4">
                    <i class="bi bi-inbox text-muted" style="font-size: 2rem;"></i>
                    <p class="text-muted mb-0 mt-2">No items added yet</p>
                </td>
            </tr>
        `);
        return;
    }
    
    let html = '';
    borrowItems.forEach((item, index) => {
        const dueDate = new Date(item.dueDate).toLocaleString('en-US', {
            year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
        });
        
        html += `<tr data-index="${index}">
            <td>${item.category}</td>
            <td><strong>${item.equipmentName}</strong></td>
            <td><code>${item.serial}</code></td>
            <td><span class="badge-status badge-borrowed">Borrowed</span></td>
            <td>${dueDate}</td>
            <td>
                <button class="btn btn-action-remove btn-sm btn-remove-item" data-index="${index}" title="Remove">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        </tr>`;
    });
    
    $('#itemsTable tbody').html(html);
    
    // Bind remove button
    $('.btn-remove-item').off('click').on('click', function() {
        const index = $(this).data('index');
        removeItem(index);
    });
}

function removeItem(index) {
    Swal.fire({
        title: 'Remove Item?',
        text: 'Are you sure you want to remove this item from the list?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, remove it',
        cancelButtonText: 'Cancel'
    }).then((result) => {
        if (result.isConfirmed) {
            borrowItems.splice(index, 1);
            renderItemsTable();
            checkNextEnabled();
            showToast('Item removed', 'info');
        }
    });
}

function checkNextEnabled() {
    $('#btnNextStep3').prop('disabled', borrowItems.length === 0);
}

function goToStep(step) {
    $('.step-content-panel').addClass('d-none');
    $(`#step${step}Content`).removeClass('d-none');
    
    // Update indicators
    for (let i = 1; i <= 3; i++) {
        const indicator = $(`#step${i}Indicator`);
        indicator.removeClass('active completed');
        if (i < step) indicator.addClass('completed');
        if (i === step) indicator.addClass('active');
    }
    
    if (step === 3) {
        populateSummary();
    }
    
    // Scroll to top
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function populateSummary() {
    $('#sumProcessedBy').text($('#processedBy').val());
    $('#sumDateBorrowed').text($('#dateBorrowed').val());
    $('#sumRemarks').text($('#remarks').val() || '-');
    
    let html = '';
    borrowItems.forEach(item => {
        const dueDate = new Date(item.dueDate).toLocaleString('en-US', {
            year: 'numeric', month: 'short', day: 'numeric'
        });
        
        html += `<tr>
            <td>${item.category}</td>
            <td><strong>${item.equipmentName}</strong></td>
            <td><code>${item.serial}</code></td>
            <td><span class="badge-status badge-borrowed">Borrowed</span></td>
            <td>${dueDate}</td>
        </tr>`;
    });
    $('#summaryItemsTable tbody').html(html);
}

function confirmBorrow() {
    if (!selectedStudent || borrowItems.length === 0) {
        Swal.fire({
            icon: 'warning',
            title: 'Incomplete',
            text: 'Please select a student and add at least one item.',
            confirmButtonColor: 'var(--primary-red)'
        });
        return;
    }
    
    // Build items list for confirmation
    let itemsList = borrowItems.map(item => `• ${item.equipmentName} (${item.serial})`).join('<br>');
    
    Swal.fire({
        title: 'Confirm Borrow Transaction',
        html: `
            <div class="text-start">
                <p class="mb-2"><strong>Borrower:</strong> ${selectedStudent.fullName}</p>
                <p class="mb-2"><strong>Student ID:</strong> ${selectedStudent.studentIdNumber}</p>
                <p class="mb-2"><strong>Items (${borrowItems.length}):</strong></p>
                <div class="ps-3 text-muted small">${itemsList}</div>
            </div>
        `,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#22c55e',
        cancelButtonColor: '#6b7280',
        confirmButtonText: '<i class="bi bi-check-circle me-1"></i> Confirm & Submit',
        cancelButtonText: 'Cancel',
        reverseButtons: true,
        customClass: {
            popup: 'swal-wide'
        }
    }).then((result) => {
        if (result.isConfirmed) {
            processBorrow();
        }
    });
}

function processBorrow() {
    // Show loading
    Swal.fire({
        title: 'Processing...',
        html: 'Please wait while we process your transaction.',
        allowOutsideClick: false,
        allowEscapeKey: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });
    
    let processed = 0;
    let transactionCode = '';
    let hasError = false;
    
    borrowItems.forEach((item, index) => {
        const formData = new FormData();
        formData.append('StudentId', selectedStudent.studentId);
        formData.append('UnitId', item.unitId);
        formData.append('DueDate', item.dueDate);
        formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
        
        $.ajax({
            url: '/SupportAdmin/Transactions/ProcessBorrow',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(res) {
                processed++;
                if (res.success && res.transactionCode) {
                    transactionCode = res.transactionCode;
                }
                
                if (processed === borrowItems.length) {
                    if (!hasError) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Transaction Successful!',
                            html: `
                                <div class="text-center">
                                    <p class="mb-2">Transaction Code:</p>
                                    <h4 class="text-success fw-bold">${transactionCode}</h4>
                                    <p class="text-muted small mt-3">${borrowItems.length} item(s) borrowed successfully</p>
                                </div>
                            `,
                            confirmButtonColor: '#22c55e',
                            confirmButtonText: 'View Transactions'
                        }).then(() => {
                            window.location.href = '/SupportAdmin/Transactions';
                        });
                    }
                }
            },
            error: function() {
                hasError = true;
                processed++;
                
                if (processed === borrowItems.length) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred while processing the transaction. Please try again.',
                        confirmButtonColor: 'var(--primary-red)'
                    });
                }
            }
        });
    });
}

function saveNewStudent() {
    const form = $('#addStudentForm');
    
    Swal.fire({
        title: 'Saving...',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
    });
    
    $.post('/SupportAdmin/Students/Create', form.serialize(), function(res) {
        if (res.success) {
            Swal.fire({
                icon: 'success',
                title: 'Student Added',
                text: 'The student has been added successfully.',
                confirmButtonColor: '#22c55e'
            });
            bootstrap.Modal.getInstance('#addStudentModal').hide();
            form[0].reset();
            loadStudents();
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: res.message || 'Failed to add student.',
                confirmButtonColor: 'var(--primary-red)'
            });
        }
    }).fail(function() {
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred. Please try again.',
            confirmButtonColor: 'var(--primary-red)'
        });
    });
}

function updateStudent() {
    const form = $('#editStudentForm');
    
    Swal.fire({
        title: 'Saving...',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
    });
    
    $.post('/SupportAdmin/Students/Update', form.serialize(), function(res) {
        if (res.success) {
            Swal.fire({
                icon: 'success',
                title: 'Student Updated',
                text: 'The student information has been updated.',
                confirmButtonColor: '#22c55e'
            });
            bootstrap.Modal.getInstance('#editStudentModal').hide();
            loadStudents();
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: res.message || 'Failed to update student.',
                confirmButtonColor: 'var(--primary-red)'
            });
        }
    }).fail(function() {
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred. Please try again.',
            confirmButtonColor: 'var(--primary-red)'
        });
    });
}

// Toast notification helper
function showToast(message, type = 'info') {
    const bgColors = {
        success: 'linear-gradient(135deg, #22c55e, #16a34a)',
        error: 'linear-gradient(135deg, #ef4444, #dc2626)',
        warning: 'linear-gradient(135deg, #f59e0b, #d97706)',
        info: 'linear-gradient(135deg, #8b0000, #5c0000)'
    };
    
    Toastify({
        text: message,
        duration: 3000,
        gravity: "top",
        position: "right",
        style: {
            background: bgColors[type] || bgColors.info,
            borderRadius: '10px',
            boxShadow: '0 4px 12px rgba(0,0,0,0.15)'
        }
    }).showToast();
}
</script>
}
