@{
    ViewData["Title"] = "Borrow an Item";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="page-icon">
                <i class="bi bi-box-arrow-up"></i>
            </div>
            <div>
                <h2 class="page-title mb-0">Borrow an Item</h2>
                <p class="text-muted mb-0 small">Process equipment borrowing transactions</p>
            </div>
        </div>
        <a href="/SupportAdmin/Transactions" class="btn btn-outline-secondary btn-back">
            <i class="bi bi-arrow-left me-1"></i>Back to Transactions
        </a>
    </div>

    <div class="row g-4">
        <!-- Left Panel: Wizard Steps -->
        <div class="col-lg-3 col-md-4">
            <div class="wizard-card">
                <div class="wizard-header">
                    <span class="wizard-badge">BORROW AN ITEM</span>
                </div>
                <div class="wizard-body">
                    <!-- Step 1 -->
                    <div class="wizard-step active" id="step1Indicator">
                        <div class="step-connector"></div>
                        <div class="step-content">
                            <span class="step-circle">
                                <i class="bi bi-check"></i>
                            </span>
                            <div class="step-info">
                                <span class="step-title">Borrower Details</span>
                                <span class="step-desc">Select a student</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Step 2 -->
                    <div class="wizard-step" id="step2Indicator">
                        <div class="step-connector"></div>
                        <div class="step-content">
                            <span class="step-circle">2</span>
                            <div class="step-info">
                                <span class="step-title">Transaction Details</span>
                                <span class="step-desc">Add equipment items</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Step 3 -->
                    <div class="wizard-step" id="step3Indicator">
                        <div class="step-content">
                            <span class="step-circle">3</span>
                            <div class="step-info">
                                <span class="step-title">Summary</span>
                                <span class="step-desc">Review & confirm</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Content -->
        <div class="col-lg-9 col-md-8">
            <!-- Step 1: Borrower Details (Students Table) -->
            <div class="step-content-panel" id="step1Content">
                <div class="luxury-card">
                    <div class="luxury-card-header">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-people-fill"></i>
                            <span>Select Borrower</span>
                        </div>
                        <button class="btn btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#addStudentModal">
                            <i class="bi bi-plus-circle me-1"></i>Add Student
                        </button>
                    </div>
                    <div class="luxury-card-body">
                        <!-- Filter Row -->
                        <div class="filter-row mb-3">
                            <div class="filter-group">
                                <label class="filter-label"><i class="bi bi-funnel me-1"></i>Filters:</label>
                                <select id="filterCollege" class="filter-select">
                                    <option value="">All Colleges</option>
                                </select>
                                <select id="filterCourse" class="filter-select">
                                    <option value="">All Courses</option>
                                </select>
                                <select id="filterStatus" class="filter-select">
                                    <option value="">All Status</option>
                                    <option value="true">Active</option>
                                    <option value="false">Blocked</option>
                                </select>
                                <button class="btn btn-clear-filters" id="btnClearFilters" title="Clear Filters">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </div>
                        </div>
                        
                        <!-- Students Table with DataTables -->
                        <div class="table-responsive">
                            <table class="table table-luxury" id="studentsTable">
                                <thead>
                                    <tr>
                                        <th>Student ID</th>
                                        <th>Full Name</th>
                                        <th>College</th>
                                        <th>Course</th>
                                        <th class="d-none d-lg-table-cell">E-mail</th>
                                        <th class="d-none d-md-table-cell">Contact No.</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Populated via DataTables -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 2: Transaction Details -->
            <div class="step-content-panel d-none" id="step2Content">
                <div class="luxury-card">
                    <div class="luxury-card-header header-primary">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-clipboard-data"></i>
                            <span>Transaction Details</span>
                        </div>
                        <span class="selected-borrower-badge" id="selectedBorrowerBadge">
                            <i class="bi bi-person-check me-1"></i>
                            <span id="selectedBorrowerName">-</span>
                        </span>
                    </div>
                    <div class="luxury-card-body">
                        <form id="borrowForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="StudentId" id="selectedStudentId">

                            <!-- Transaction Info Row -->
                            <div class="info-grid mb-4">
                                <div class="info-box">
                                    <label class="info-label">Transaction Code</label>
                                    <input type="text" id="transactionCode" class="form-control-luxury" readonly placeholder="Auto-generated">
                                </div>
                                <div class="info-box">
                                    <label class="info-label">Processed by</label>
                                    <input type="text" id="processedBy" class="form-control-luxury" readonly value="@Context.Session.GetString("FullName")">
                                </div>
                                <div class="info-box">
                                    <label class="info-label">Date Borrowed</label>
                                    <input type="text" id="dateBorrowed" class="form-control-luxury" readonly>
                                </div>
                                <div class="info-box">
                                    <label class="info-label">Last Updated</label>
                                    <input type="text" id="lastUpdated" class="form-control-luxury" readonly>
                                </div>
                            </div>

                            <!-- Remarks -->
                            <div class="mb-4">
                                <label class="form-label-luxury">Remarks <span class="text-muted">(Optional)</span></label>
                                <textarea id="remarks" name="Remarks" class="form-control form-control-luxury-input" rows="2" placeholder="Add any notes about this transaction..."></textarea>
                            </div>

                            <div class="section-divider">
                                <span><i class="bi bi-box-seam me-2"></i>Equipment Selection</span>
                            </div>

                            <!-- Equipment Selection -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label-luxury">Equipment Category <span class="text-danger">*</span></label>
                                    <select id="equipmentCategory" class="form-select form-select-luxury">
                                        <option value="">Select Category</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label-luxury">Equipment <span class="text-danger">*</span></label>
                                    <select id="equipmentSelect" class="form-select form-select-luxury" disabled>
                                        <option value="">Select Equipment</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label-luxury">Serial No. <span class="text-danger">*</span></label>
                                    <select id="serialNoSelect" name="UnitId" class="form-select form-select-luxury" disabled>
                                        <option value="">Select Serial No.</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <label class="form-label-luxury">Due Date <span class="text-danger">*</span></label>
                                    <input type="datetime-local" name="DueDate" id="dueDate" class="form-control form-control-luxury-input" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label-luxury">Quick Due Date</label>
                                    <div class="quick-date-btns">
                                        <button type="button" class="btn-quick-date btn-due" data-days="1">1 Day</button>
                                        <button type="button" class="btn-quick-date btn-due" data-days="3">3 Days</button>
                                        <button type="button" class="btn-quick-date btn-due" data-days="7">1 Week</button>
                                    </div>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <button type="button" id="btnAddItem" class="btn btn-gold w-100" disabled>
                                        <i class="bi bi-plus-circle me-1"></i>Add to List
                                    </button>
                                </div>
                            </div>

                            <!-- Items Table -->
                            <div class="items-table-container">
                                <div class="table-responsive">
                                    <table class="table table-luxury-dark" id="itemsTable">
                                        <thead>
                                            <tr>
                                                <th>Category</th>
                                                <th>Equipment</th>
                                                <th>Serial No.</th>
                                                <th>Status</th>
                                                <th>Due Date</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr class="empty-row">
                                                <td colspan="6" class="text-center py-4">
                                                    <i class="bi bi-inbox text-muted" style="font-size: 2rem;"></i>
                                                    <p class="text-muted mb-0 mt-2">No items added yet</p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Navigation Buttons -->
                            <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                                <button type="button" class="btn btn-outline-secondary" id="btnBackStep1">
                                    <i class="bi bi-arrow-left me-1"></i>Back
                                </button>
                                <button type="button" class="btn btn-primary btn-next" id="btnNextStep3" disabled>
                                    Review Summary<i class="bi bi-arrow-right ms-1"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Step 3: Summary -->
            <div class="step-content-panel d-none" id="step3Content">
                <div class="luxury-card">
                    <div class="luxury-card-header header-success">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle"></i>
                            <span>Transaction Summary</span>
                        </div>
                    </div>
                    <div class="luxury-card-body">
                        <!-- Borrower Summary -->
                        <div class="summary-section">
                            <h6 class="summary-title"><i class="bi bi-person me-2"></i>Borrower Information</h6>
                            <div class="summary-grid">
                                <div class="summary-item">
                                    <span class="summary-label">Student ID</span>
                                    <span class="summary-value" id="sumStudentId">-</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Full Name</span>
                                    <span class="summary-value" id="sumFullName">-</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">College</span>
                                    <span class="summary-value" id="sumCollege">-</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Course</span>
                                    <span class="summary-value" id="sumCourse">-</span>
                                </div>
                            </div>
                        </div>

                        <!-- Transaction Summary -->
                        <div class="summary-section">
                            <h6 class="summary-title"><i class="bi bi-receipt me-2"></i>Transaction Details</h6>
                            <div class="summary-grid">
                                <div class="summary-item">
                                    <span class="summary-label">Transaction Code</span>
                                    <span class="summary-value fw-bold" id="sumTransactionCode">Auto-generated</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Processed by</span>
                                    <span class="summary-value" id="sumProcessedBy">-</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Date Borrowed</span>
                                    <span class="summary-value" id="sumDateBorrowed">-</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Remarks</span>
                                    <span class="summary-value" id="sumRemarks">-</span>
                                </div>
                            </div>
                        </div>

                        <!-- Items Summary -->
                        <div class="summary-section">
                            <h6 class="summary-title"><i class="bi bi-box-seam me-2"></i>Borrowed Items</h6>
                            <div class="table-responsive">
                                <table class="table table-luxury" id="summaryItemsTable">
                                    <thead>
                                        <tr>
                                            <th>Category</th>
                                            <th>Equipment</th>
                                            <th>Serial No.</th>
                                            <th>Status</th>
                                            <th>Due Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Summary items -->
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Navigation Buttons -->
                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <button type="button" class="btn btn-outline-secondary" id="btnBackStep2">
                                <i class="bi bi-arrow-left me-1"></i>Back
                            </button>
                            <button type="button" class="btn btn-success btn-submit" id="btnConfirmBorrow">
                                <i class="bi bi-check-circle me-1"></i>Confirm & Submit
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Student Modal -->
<div class="modal fade" id="addStudentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-luxury">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Add New Student</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addStudentForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-luxury">Student ID Number <span class="text-danger">*</span></label>
                            <input type="text" name="StudentIdNumber" class="form-control form-control-luxury-input" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-luxury">College <span class="text-danger">*</span></label>
                            <input type="text" name="College" class="form-control form-control-luxury-input" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-luxury">First Name <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" class="form-control form-control-luxury-input" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-luxury">Middle Name</label>
                            <input type="text" name="MiddleName" class="form-control form-control-luxury-input">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-luxury">Last Name <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" class="form-control form-control-luxury-input" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-luxury">Course</label>
                            <input type="text" name="Course" class="form-control form-control-luxury-input">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-luxury">Email</label>
                            <input type="email" name="Email" class="form-control form-control-luxury-input">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-luxury">Contact No.</label>
                            <input type="text" name="ContactNo" class="form-control form-control-luxury-input">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-gold" id="btnSaveStudent">
                    <i class="bi bi-check-circle me-1"></i>Save Student
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Student Modal -->
<div class="modal fade" id="editStudentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-luxury">
            <div class="modal-header header-warning">
                <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Student Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editStudentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="StudentId" id="editStudentId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-luxury">Student ID Number <span class="text-danger">*</span></label>
                            <input type="text" name="StudentIdNumber" id="editStudentIdNumber" class="form-control form-control-luxury-input" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-luxury">College <span class="text-danger">*</span></label>
                            <input type="text" name="College" id="editCollege" class="form-control form-control-luxury-input" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-luxury">First Name <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" id="editFirstName" class="form-control form-control-luxury-input" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-luxury">Middle Name</label>
                            <input type="text" name="MiddleName" id="editMiddleName" class="form-control form-control-luxury-input">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-luxury">Last Name <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" id="editLastName" class="form-control form-control-luxury-input" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-luxury">Course</label>
                            <input type="text" name="Course" id="editCourse" class="form-control form-control-luxury-input">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-luxury">Email</label>
                            <input type="email" name="Email" id="editEmail" class="form-control form-control-luxury-input">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-luxury">Contact No.</label>
                            <input type="text" name="ContactNo" id="editContactNo" class="form-control form-control-luxury-input">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-luxury">Status</label>
                            <select name="Status" id="editStatus" class="form-select form-select-luxury" disabled>
                                <option value="true">Active</option>
                                <option value="false">Blocked</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="btnUpdateStudent">
                    <i class="bi bi-check-circle me-1"></i>Save Changes
                </button>
                <button type="button" class="btn btn-success" id="btnSelectStudent">
                    <i class="bi bi-check2-square me-1"></i>Select as Borrower
                </button>
            </div>
        </div>
    </div>
</div>


<style>
/* ===========================================
   Luxury Borrow Page Styles
   =========================================== */

/* Page Header */
.page-icon {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
    box-shadow: 0 8px 24px rgba(139, 0, 0, 0.25);
}

.page-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--text-dark);
}

.btn-back {
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 500;
    transition: all 0.3s ease;
}

.btn-back:hover {
    background: var(--primary-red);
    color: white;
    border-color: var(--primary-red);
}

/* Wizard Card */
.wizard-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.05);
}

.wizard-header {
    padding: 20px 24px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.wizard-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--primary-red);
}

.wizard-body {
    padding: 24px;
}

.wizard-step {
    position: relative;
    padding-bottom: 24px;
}

.wizard-step:last-child {
    padding-bottom: 0;
}

.step-connector {
    position: absolute;
    left: 19px;
    top: 40px;
    bottom: 0;
    width: 2px;
    background: #e5e7eb;
}

.wizard-step.completed .step-connector {
    background: linear-gradient(180deg, #22c55e 0%, #e5e7eb 100%);
}

.wizard-step.active .step-connector {
    background: linear-gradient(180deg, var(--primary-red) 0%, #e5e7eb 100%);
}

.step-content {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    position: relative;
    z-index: 1;
}

.step-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    font-weight: 600;
    background: #f3f4f6;
    color: #9ca3af;
    transition: all 0.3s ease;
    flex-shrink: 0;
}

.wizard-step.active .step-circle {
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    box-shadow: 0 4px 12px rgba(139, 0, 0, 0.3);
}

.wizard-step.completed .step-circle {
    background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
    color: white;
    box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
}

.step-info {
    display: flex;
    flex-direction: column;
    padding-top: 4px;
}

.step-title {
    font-weight: 600;
    color: #6b7280;
    font-size: 0.9rem;
    transition: color 0.3s ease;
}

.wizard-step.active .step-title,
.wizard-step.completed .step-title {
    color: var(--text-dark);
}

.step-desc {
    font-size: 0.75rem;
    color: #9ca3af;
    margin-top: 2px;
}

/* Filter Row */
.filter-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 16px;
    background: linear-gradient(135deg, #fafafa 0%, #fff 100%);
    border-radius: 12px;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.filter-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}

.filter-label {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--primary-red);
    margin: 0;
    white-space: nowrap;
}

.filter-select {
    padding: 8px 32px 8px 12px;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-size: 0.85rem;
    background: white;
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 140px;
}

.filter-select:focus {
    border-color: var(--primary-red);
    outline: none;
