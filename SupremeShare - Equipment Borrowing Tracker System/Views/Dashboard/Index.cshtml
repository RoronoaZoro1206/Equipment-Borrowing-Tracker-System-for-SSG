@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<!-- Hero Banner -->
<div class="dashboard-hero">
    <div class="hero-bg" style="background-image: url('/File_Images/admin-MAIN.png');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <div class="hero-logo">
            <img src="~/File_Images/533693089_1177970501030425_4668075712780998242_n.jpg" alt="SSG Logo" />
        </div>
        <div class="hero-text">
            <h1>Supreme Student Government</h1>
            <p>Cebu Technological University - Main Campus</p>
        </div>
    </div>
    <div class="hero-stripe"></div>
</div>

<!-- Dashboard Stats -->
<div class="dashboard-section">
    <div class="section-header">
        <h2 class="section-title"><i class="bi bi-grid-3x3-gap-fill"></i> Dashboard</h2>
    </div>
    
    <div class="row g-3 mb-4">
        <div class="col">
            <div class="status-card borrowed">
                <div class="status-icon"><i class="bi bi-box-arrow-up-right"></i></div>
                <div class="status-label">Borrowed</div>
                <div class="status-value">@(ViewBag.BorrowedCount ?? 0)</div>
            </div>
        </div>
        <div class="col">
            <div class="status-card available">
                <div class="status-icon"><i class="bi bi-check-circle"></i></div>
                <div class="status-label">Available</div>
                <div class="status-value">@(ViewBag.AvailableCount ?? 0)</div>
            </div>
        </div>
        <div class="col">
            <div class="status-card review">
                <div class="status-icon"><i class="bi bi-hourglass-split"></i></div>
                <div class="status-label">For Review</div>
                <div class="status-value">@(ViewBag.ForReviewCount ?? 0)</div>
            </div>
        </div>
        <div class="col">
            <div class="status-card maintenance">
                <div class="status-icon"><i class="bi bi-tools"></i></div>
                <div class="status-label">Maintenance</div>
                <div class="status-value">@(ViewBag.MaintenanceCount ?? 0)</div>
            </div>
        </div>
        <div class="col">
            <div class="status-card lost">
                <div class="status-icon"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="status-label">Lost/Missing</div>
                <div class="status-value">@(ViewBag.LostCount ?? 0)</div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4">
    <!-- Borrowers per College -->
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="bi bi-pie-chart-fill"></i> Borrowers per College</h5>
                <button class="btn-refresh" onclick="refreshChart('collegeChart')">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            <div class="chart-body">
                <canvas id="collegeChart"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Equipment per Category -->
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="bi bi-bar-chart-fill"></i> Equipment per Category</h5>
                <button class="btn-refresh" onclick="refreshChart('categoryChart')">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            <div class="chart-body">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Good vs Damaged -->
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="bi bi-bar-chart-fill"></i> Good vs Damaged Units</h5>
                <button class="btn-refresh" onclick="refreshChart('conditionChart')">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            <div class="chart-body">
                <canvas id="conditionChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row g-4 mt-2">
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="bi bi-graph-up"></i> Monthly Transactions</h5>
            </div>
            <div class="chart-body">
                <canvas id="monthlyChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="bi bi-clock-history"></i> Recent Activity</h5>
            </div>
            <div class="chart-body activity-list">
                <div class="activity-empty">
                    <i class="bi bi-inbox"></i>
                    <p>No recent activity</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Theme colors
        const themeColors = {
            primary: '#8B0000',
            primaryLight: '#A52A2A',
            gold: '#D4AF37',
            green: '#059669',
            red: '#DC2626',
            blue: '#3B82F6',
            orange: '#F59E0B',
            purple: '#8B5CF6',
            teal: '#14B8A6'
        };

        // Borrowers per College - Doughnut Chart
        const collegeCtx = document.getElementById('collegeChart').getContext('2d');
        new Chart(collegeCtx, {
            type: 'doughnut',
            data: {
                labels: ['COT', 'COE', 'CAS', 'CCICT', 'CME', 'COED'],
                datasets: [{
                    data: [33, 17, 13, 7, 20, 10],
                    backgroundColor: [
                        themeColors.gold,
                        themeColors.teal,
                        themeColors.green,
                        themeColors.primary,
                        themeColors.orange,
                        themeColors.blue
                    ],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '60%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            padding: 15,
                            usePointStyle: true,
                            font: { size: 11 }
                        }
                    }
                }
            }
        });

        // Equipment per Category - Horizontal Bar Chart
        const categoryCtx = document.getElementById('categoryChart').getContext('2d');
        new Chart(categoryCtx, {
            type: 'bar',
            data: {
                labels: ['Electronics', 'Furniture', 'Sports', 'Audio/Visual', 'Tools'],
                datasets: [{
                    label: 'Units',
                    data: [18, 12, 15, 8, 10],
                    backgroundColor: themeColors.teal,
                    borderRadius: 4,
                    barThickness: 20
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        grid: { display: false }
                    },
                    y: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Good vs Damaged - Bar Chart
        const conditionCtx = document.getElementById('conditionChart').getContext('2d');
        new Chart(conditionCtx, {
            type: 'bar',
            data: {
                labels: ['Good', 'Damaged'],
                datasets: [{
                    label: 'Units',
                    data: [22, 12],
                    backgroundColor: [themeColors.green, themeColors.red],
                    borderRadius: 6,
                    barThickness: 60
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            generateLabels: function(chart) {
                                return [
                                    { text: 'Good', fillStyle: themeColors.green, strokeStyle: themeColors.green },
                                    { text: 'Damaged', fillStyle: themeColors.red, strokeStyle: themeColors.red }
                                ];
                            },
                            usePointStyle: true
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, grid: { color: '#f0f0f0' } }
                }
            }
        });

        // Monthly Transactions - Line Chart
        const monthlyCtx = document.getElementById('monthlyChart').getContext('2d');
        new Chart(monthlyCtx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [{
                    label: 'Borrowed',
                    data: [12, 19, 15, 25, 22, 30, 28, 35, 40, 32, 28, 24],
                    borderColor: themeColors.primary,
                    backgroundColor: 'rgba(139, 0, 0, 0.1)',
                    fill: true,
                    tension: 0.4
                }, {
                    label: 'Returned',
                    data: [10, 15, 13, 20, 18, 25, 24, 30, 35, 28, 25, 22],
                    borderColor: themeColors.green,
                    backgroundColor: 'rgba(5, 150, 105, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { usePointStyle: true }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, grid: { color: '#f0f0f0' } }
                }
            }
        });

        function refreshChart(chartId) {
            console.log('Refreshing:', chartId);
        }
    </script>
}
