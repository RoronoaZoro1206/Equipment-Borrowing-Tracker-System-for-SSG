@{
    ViewData["Title"] = "Equipment Inventory";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4 fade-in">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <h2><i class="bi bi-box-seam-fill me-2"></i>Equipment Inventory</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createEquipmentModal">
            <i class="bi bi-plus-lg me-1"></i>Add Equipment Type
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md">
            <div class="card card-hover bg-primary text-white">
                <div class="card-body text-center py-3">
                    <h3 id="statTypes" class="mb-1">-</h3>
                    <small>Equipment Types</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card card-hover bg-info text-white">
                <div class="card-body text-center py-3">
                    <h3 id="statTotal" class="mb-1">-</h3>
                    <small>Total Units</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card card-hover bg-success text-white">
                <div class="card-body text-center py-3">
                    <h3 id="statAvailable" class="mb-1">-</h3>
                    <small>Available</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card card-hover bg-warning text-dark">
                <div class="card-body text-center py-3">
                    <h3 id="statBorrowed" class="mb-1">-</h3>
                    <small>Borrowed</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card card-hover bg-danger text-white">
                <div class="card-body text-center py-3">
                    <h3 id="statDamaged" class="mb-1">-</h3>
                    <small>Damaged</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Equipment Types Table -->
    <div class="card card-hover shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-ul me-2"></i>Equipment Types</span>
            <button class="btn btn-sm btn-outline-light" onclick="refreshData()">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover" id="equipmentTable" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th class="text-center">Total</th>
                        <th class="text-center">Available</th>
                        <th class="hide-mobile">Date Added</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Equipment Modal -->
<div class="modal fade" id="createEquipmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="createEquipmentForm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add Equipment Type</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Equipment Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" required placeholder="e.g., Laptop, Projector">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        <input type="text" name="Category" class="form-control" required placeholder="e.g., Electronics, Audio">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Initial Quantity</label>
                        <input type="number" name="Quantity" class="form-control" value="0" min="0">
                        <small class="text-muted">You can add individual units later</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="createEquipBtn">
                        <i class="bi bi-plus-circle me-1"></i>Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Equipment Modal -->
<div class="modal fade" id="editEquipmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editEquipmentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EquipmentId" id="editEquipmentId">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Edit Equipment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Equipment Name</label>
                        <input type="text" name="Name" id="editName" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <input type="text" name="Category" id="editCategory" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantity</label>
                        <input type="number" name="Quantity" id="editQuantity" class="form-control" min="0">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning" id="editEquipBtn">
                        <i class="bi bi-check-circle me-1"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Unit Modal -->
<div class="modal fade" id="addUnitModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="addUnitForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EquipmentId" id="addUnitEquipmentId">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-plus-square me-2"></i>Add Equipment Unit</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Serial Number <span class="text-danger">*</span></label>
                        <input type="text" name="SerialNo" class="form-control" required placeholder="e.g., SN-001">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Condition</label>
                        <select name="Condition" class="form-select">
                            <option value="true">✓ Good</option>
                            <option value="false">✗ Damaged</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-select">
                            <option value="available">Available</option>
                            <option value="maintenance">Under Maintenance</option>
                            <option value="retired">Retired</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success" id="addUnitBtn">
                        <i class="bi bi-plus-circle me-1"></i>Add Unit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Units Modal -->
<div class="modal fade" id="viewUnitsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="bi bi-list-check me-2"></i>Units: <span id="viewUnitsTitle"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-sm table-striped table-hover" id="unitsTable" style="width:100%">
                    <thead class="table-light">
                        <tr>
                            <th>Serial No</th>
                            <th>Condition</th>
                            <th>Status</th>
                            <th class="hide-mobile">Date Added</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let equipmentTable;

$(document).ready(function() {
    loadStats();
    
    // Initialize DataTable
    equipmentTable = DataTableConfig.init('#equipmentTable', {
        ajax: {
            url: '/Admin/Equipment/GetAll',
            dataSrc: json => json.success ? json.data : []
        },
        columns: [
            { data: 'equipmentName', render: data => `<strong>${data}</strong>` },
            { data: 'equipmentCategory', render: data => `<span class="badge bg-secondary">${data}</span>` },
            { data: 'equipmentQuantity', className: 'text-center' },
            { data: 'availableStock', className: 'text-center', render: data => `<span class="badge bg-success">${data}</span>` },
            { data: 'equipmentDateAdded' },
            {
                data: 'equipmentId',
                orderable: false,
                render: function(data, type, row) {
                    return `
                        <div class="btn-action-group">
                            <button class="btn btn-sm btn-outline-info btn-action btn-view-units" data-id="${data}" data-name="${row.equipmentName}" title="View Units">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-success btn-action btn-add-unit" data-id="${data}" title="Add Unit">
                                <i class="bi bi-plus"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-primary btn-action btn-edit" data-id="${data}" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger btn-action btn-delete" data-id="${data}" data-name="${row.equipmentName}" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>`;
                }
            }
        ],
        order: [[0, 'asc']]
    });

    // View units
    $('#equipmentTable').on('click', '.btn-view-units', async function() {
        const id = $(this).data('id');
        const name = $(this).data('name');
        $('#viewUnitsTitle').text(name);
        Loading.show('Loading units...');
        
        try {
            const res = await Api.get(`/Admin/Equipment/Units/${id}`);
            Loading.hide();
            
            if (res.success) {
                let html = '';
                res.data.forEach(u => {
                    const condBadge = u.conditionBool 
                        ? '<span class="status-badge available">Good</span>' 
                        : '<span class="status-badge overdue">Damaged</span>';
                    const statusClass = u.eunitStatus === 'available' ? 'available' : 
                                       (u.eunitStatus === 'borrowed' ? 'borrowed' : 'maintenance');
                    html += `<tr class="fade-in">
                        <td><strong class="text-primary">${u.eunitSerialNo}</strong></td>
                        <td>${condBadge}</td>
                        <td><span class="status-badge ${statusClass}">${u.eunitStatus}</span></td>
                        <td class="hide-mobile">${u.eunitDateAdded}</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger btn-action btn-delete-unit" 
                                    data-id="${u.eunitId}" data-serial="${u.eunitSerialNo}" 
                                    ${u.eunitStatus === 'borrowed' ? 'disabled title="Cannot delete borrowed unit"' : ''}>
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>`;
                });
                $('#unitsTable tbody').html(html || '<tr><td colspan="5" class="text-center text-muted py-4">No units found</td></tr>');
                new bootstrap.Modal('#viewUnitsModal').show();
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.hide();
            Toast.error('Failed to load units');
        }
    });

    // Add unit
    $('#equipmentTable').on('click', '.btn-add-unit', function() {
        $('#addUnitEquipmentId').val($(this).data('id'));
        $('#addUnitForm')[0].reset();
        new bootstrap.Modal('#addUnitModal').show();
    });

    // Edit equipment
    $('#equipmentTable').on('click', '.btn-edit', async function() {
        const id = $(this).data('id');
        Loading.show('Loading...');
        
        try {
            const res = await Api.get(`/Admin/Equipment/Get/${id}`);
            Loading.hide();
            
            if (res.success) {
                $('#editEquipmentId').val(res.data.equipmentId);
                $('#editName').val(res.data.equipmentName);
                $('#editCategory').val(res.data.equipmentCategory);
                $('#editQuantity').val(res.data.equipmentQuantity);
                new bootstrap.Modal('#editEquipmentModal').show();
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.hide();
            Toast.error('Failed to load equipment');
        }
    });

    // Delete equipment with SweetAlert2
    $('#equipmentTable').on('click', '.btn-delete', async function() {
        const id = $(this).data('id');
        const name = $(this).data('name');
        
        const confirmed = await Confirm.delete(name);
        if (!confirmed) return;
        
        Loading.show('Deleting...');
        
        try {
            const res = await Api.post('/Admin/Equipment/Delete', { equipmentId: id });
            Loading.hide();
            
            if (res.success) {
                Toast.success('Equipment deleted');
                equipmentTable.ajax.reload();
                loadStats();
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.hide();
            Toast.error('Failed to delete equipment');
        }
    });

    // Delete unit
    $(document).on('click', '.btn-delete-unit', async function() {
        const id = $(this).data('id');
        const serial = $(this).data('serial');
        
        const confirmed = await Confirm.delete(`Unit ${serial}`);
        if (!confirmed) return;
        
        Loading.show('Deleting...');
        
        try {
            const res = await Api.post('/Admin/Equipment/DeleteUnit', { unitId: id });
            Loading.hide();
            
            if (res.success) {
                Toast.success('Unit deleted');
                $(this).closest('tr').fadeOut(() => $(this).closest('tr').remove());
                equipmentTable.ajax.reload();
                loadStats();
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.hide();
            Toast.error('Failed to delete unit');
        }
    });

    // Form submissions
    $('#createEquipmentForm').submit(async function(e) {
        e.preventDefault();
        const btn = document.getElementById('createEquipBtn');
        Loading.button(btn, true);
        
        try {
            const res = await $.post('/Admin/Equipment/Create', $(this).serialize());
            Loading.button(btn, false);
            
            if (res.success) {
                bootstrap.Modal.getInstance('#createEquipmentModal').hide();
                this.reset();
                equipmentTable.ajax.reload();
                loadStats();
                Toast.success('Equipment created successfully');
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.button(btn, false);
            Toast.error('Failed to create equipment');
        }
    });

    $('#editEquipmentForm').submit(async function(e) {
        e.preventDefault();
        const btn = document.getElementById('editEquipBtn');
        Loading.button(btn, true);
        
        try {
            const res = await $.post('/Admin/Equipment/Update', $(this).serialize());
            Loading.button(btn, false);
            
            if (res.success) {
                bootstrap.Modal.getInstance('#editEquipmentModal').hide();
                equipmentTable.ajax.reload();
                Toast.success('Equipment updated');
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.button(btn, false);
            Toast.error('Failed to update equipment');
        }
    });

    $('#addUnitForm').submit(async function(e) {
        e.preventDefault();
        const btn = document.getElementById('addUnitBtn');
        Loading.button(btn, true);
        
        try {
            const res = await $.post('/Admin/Equipment/CreateUnit', $(this).serialize());
            Loading.button(btn, false);
            
            if (res.success) {
                bootstrap.Modal.getInstance('#addUnitModal').hide();
                this.reset();
                equipmentTable.ajax.reload();
                loadStats();
                Toast.success('Unit added successfully');
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.button(btn, false);
            Toast.error('Failed to add unit');
        }
    });
});

async function loadStats() {
    try {
        const res = await Api.get('/Admin/Equipment/Stats');
        if (res.success) {
            $('#statTypes').text(res.data.totalEquipmentTypes);
            $('#statTotal').text(res.data.totalUnits);
            $('#statAvailable').text(res.data.availableUnits);
            $('#statBorrowed').text(res.data.borrowedUnits);
            $('#statDamaged').text(res.data.damagedUnits);
        }
    } catch (error) {
        console.error('Failed to load stats');
    }
}

function refreshData() {
    Toast.info('Refreshing...');
    equipmentTable.ajax.reload();
    loadStats();
}
</script>
}
