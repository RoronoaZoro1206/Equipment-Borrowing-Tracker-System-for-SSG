@{
    ViewData["Title"] = "Equipment Inventory";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-box-seam-fill me-2"></i>Equipment Inventory</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createEquipmentModal">
            <i class="bi bi-plus-lg me-1"></i>Add Equipment Type
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h3 id="statTypes">-</h3>
                    <small>Equipment Types</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h3 id="statTotal">-</h3>
                    <small>Total Units</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h3 id="statAvailable">-</h3>
                    <small>Available</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <h3 id="statBorrowed">-</h3>
                    <small>Borrowed</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-danger text-white">
                <div class="card-body text-center">
                    <h3 id="statDamaged">-</h3>
                    <small>Damaged</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Equipment Types Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <i class="bi bi-list-ul me-2"></i>Equipment Types
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover" id="equipmentTable" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Total Qty</th>
                        <th>Available</th>
                        <th>Date Added</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Equipment Modal -->
<div class="modal fade" id="createEquipmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createEquipmentForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Equipment Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Equipment Name *</label>
                        <input type="text" name="Name" class="form-control" required placeholder="e.g., Laptop, Projector">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category *</label>
                        <input type="text" name="Category" class="form-control" required placeholder="e.g., Electronics, Audio">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Initial Quantity</label>
                        <input type="number" name="Quantity" class="form-control" value="0" min="0">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Equipment Modal -->
<div class="modal fade" id="editEquipmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editEquipmentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EquipmentId" id="editEquipmentId">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Equipment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Equipment Name</label>
                        <input type="text" name="Name" id="editName" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <input type="text" name="Category" id="editCategory" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantity</label>
                        <input type="number" name="Quantity" id="editQuantity" class="form-control" min="0">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Unit Modal -->
<div class="modal fade" id="addUnitModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addUnitForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EquipmentId" id="addUnitEquipmentId">
                <div class="modal-header">
                    <h5 class="modal-title">Add Equipment Unit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Serial Number *</label>
                        <input type="text" name="SerialNo" class="form-control" required placeholder="e.g., SN-001">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Condition</label>
                        <select name="Condition" class="form-select">
                            <option value="true">Good</option>
                            <option value="false">Damaged</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-select">
                            <option value="available">Available</option>
                            <option value="maintenance">Under Maintenance</option>
                            <option value="retired">Retired</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Unit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Units Modal -->
<div class="modal fade" id="viewUnitsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Units: <span id="viewUnitsTitle"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-sm table-striped" id="unitsTable" style="width:100%">
                    <thead class="table-light">
                        <tr>
                            <th>Serial No</th>
                            <th>Condition</th>
                            <th>Status</th>
                            <th>Date Added</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let equipmentTable;

$(document).ready(function() {
    // Load stats
    $.get('/Admin/Equipment/Stats', function(res) {
        if (res.success) {
            $('#statTypes').text(res.data.totalEquipmentTypes);
            $('#statTotal').text(res.data.totalUnits);
            $('#statAvailable').text(res.data.availableUnits);
            $('#statBorrowed').text(res.data.borrowedUnits);
            $('#statDamaged').text(res.data.damagedUnits);
        }
    });

    // Initialize DataTable
    equipmentTable = $('#equipmentTable').DataTable({
        ajax: {
            url: '/Admin/Equipment/GetAll',
            dataSrc: function(json) {
                return json.success ? json.data : [];
            }
        },
        columns: [
            { data: 'equipmentName', render: function(data) { return `<strong>${data}</strong>`; } },
            { data: 'equipmentCategory', render: function(data) { return `<span class="badge bg-secondary">${data}</span>`; } },
            { data: 'equipmentQuantity' },
            { data: 'availableStock' },
            { data: 'equipmentDateAdded' },
            {
                data: 'equipmentId',
                render: function(data, type, row) {
                    return `
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-info btn-view-units" data-id="${data}" data-name="${row.equipmentName}" title="View Units">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="btn btn-outline-success btn-add-unit" data-id="${data}" title="Add Unit">
                                <i class="bi bi-plus"></i>
                            </button>
                            <button class="btn btn-outline-primary btn-edit" data-id="${data}" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-delete" data-id="${data}" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>`;
                }
            }
        ],
        order: [[0, 'asc']],
        responsive: true,
        language: {
            emptyTable: "No equipment found",
            search: "Search:"
        }
    });

    // View units
    $('#equipmentTable').on('click', '.btn-view-units', function() {
        const id = $(this).data('id');
        const name = $(this).data('name');
        $('#viewUnitsTitle').text(name);
        $.get(`/Admin/Equipment/Units/${id}`, function(res) {
            if (res.success) {
                let html = '';
                res.data.forEach(u => {
                    const condBadge = u.conditionBool ? '<span class="badge bg-success">Good</span>' : '<span class="badge bg-danger">Damaged</span>';
                    const statusBadge = u.eunitStatus === 'available' ? 'bg-success' : (u.eunitStatus === 'borrowed' ? 'bg-warning' : 'bg-secondary');
                    html += `<tr>
                        <td><strong>${u.eunitSerialNo}</strong></td>
                        <td>${condBadge}</td>
                        <td><span class="badge ${statusBadge}">${u.eunitStatus}</span></td>
                        <td>${u.eunitDateAdded}</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger btn-delete-unit" data-id="${u.eunitId}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>`;
                });
                $('#unitsTable tbody').html(html || '<tr><td colspan="5" class="text-center text-muted">No units found</td></tr>');
                $('#viewUnitsModal').modal('show');
            }
        });
    });

    // Add unit
    $('#equipmentTable').on('click', '.btn-add-unit', function() {
        $('#addUnitEquipmentId').val($(this).data('id'));
        $('#addUnitModal').modal('show');
    });

    // Edit equipment
    $('#equipmentTable').on('click', '.btn-edit', function() {
        const id = $(this).data('id');
        $.get(`/Admin/Equipment/Get/${id}`, function(res) {
            if (res.success) {
                $('#editEquipmentId').val(res.data.equipmentId);
                $('#editName').val(res.data.equipmentName);
                $('#editCategory').val(res.data.equipmentCategory);
                $('#editQuantity').val(res.data.equipmentQuantity);
                $('#editEquipmentModal').modal('show');
            }
        });
    });

    // Delete equipment
    $('#equipmentTable').on('click', '.btn-delete', function() {
        if (confirm('Delete this equipment type? All units must be removed first.')) {
            $.post('/Admin/Equipment/Delete', { 
                equipmentId: $(this).data('id'), 
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
            }, function(res) {
                if (res.success) equipmentTable.ajax.reload();
                else alert(res.message);
            });
        }
    });

    // Delete unit
    $(document).on('click', '.btn-delete-unit', function() {
        if (confirm('Delete this unit?')) {
            $.post('/Admin/Equipment/DeleteUnit', { 
                unitId: $(this).data('id'), 
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
            }, function(res) {
                if (res.success) location.reload();
                else alert(res.message);
            });
        }
    });

    // Form submissions
    $('#createEquipmentForm').submit(function(e) {
        e.preventDefault();
        $.post('/Admin/Equipment/Create', $(this).serialize(), function(res) {
            if (res.success) {
                $('#createEquipmentModal').modal('hide');
                equipmentTable.ajax.reload();
                alert('Equipment created successfully');
            } else {
                alert(res.message);
            }
        });
    });

    $('#editEquipmentForm').submit(function(e) {
        e.preventDefault();
        $.post('/Admin/Equipment/Update', $(this).serialize(), function(res) {
            if (res.success) {
                $('#editEquipmentModal').modal('hide');
                equipmentTable.ajax.reload();
            } else {
                alert(res.message);
            }
        });
    });

    $('#addUnitForm').submit(function(e) {
        e.preventDefault();
        $.post('/Admin/Equipment/CreateUnit', $(this).serialize(), function(res) {
            if (res.success) {
                $('#addUnitModal').modal('hide');
                equipmentTable.ajax.reload();
                alert('Unit added successfully');
            } else {
                alert(res.message);
            }
        });
    });
});
</script>
}
