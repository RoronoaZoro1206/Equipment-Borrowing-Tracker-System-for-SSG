@{
    ViewData["Title"] = "Student Management";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4 fade-in">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <h2><i class="bi bi-mortarboard-fill me-2"></i>Student Management</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createStudentModal">
            <i class="bi bi-plus-lg me-1"></i>Add Student
        </button>
    </div>

    <div class="card card-hover shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover" id="studentsTable" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>ID Number</th>
                        <th>Full Name</th>
                        <th>College</th>
                        <th class="hide-mobile">Course</th>
                        <th class="hide-mobile">Email</th>
                        <th class="hide-mobile">Contact</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Student Modal -->
<div class="modal fade" id="createStudentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="createStudentForm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Add New Student</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Student ID Number <span class="text-danger">*</span></label>
                            <input type="text" name="StudentIdNumber" class="form-control" required placeholder="e.g., 2021-0001">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">First Name <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Last Name <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Middle Name</label>
                            <input type="text" name="MiddleName" class="form-control">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Suffix</label>
                            <input type="text" name="Suffix" class="form-control" placeholder="Jr., III">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">College <span class="text-danger">*</span></label>
                            <input type="text" name="College" class="form-control" required placeholder="e.g., CCICT">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Course</label>
                            <input type="text" name="Course" class="form-control" placeholder="e.g., BSIT">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contact No</label>
                            <input type="text" name="ContactNo" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="createBtn">
                        <i class="bi bi-plus-circle me-1"></i>Add Student
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Student Modal -->
<div class="modal fade" id="editStudentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="editStudentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="StudentId" id="editStudentId">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Edit Student</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Student ID Number</label>
                            <input type="text" name="StudentIdNumber" id="editIdNumber" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">First Name</label>
                            <input type="text" name="FirstName" id="editFirstName" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Last Name</label>
                            <input type="text" name="LastName" id="editLastName" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Middle Name</label>
                            <input type="text" name="MiddleName" id="editMiddleName" class="form-control">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Suffix</label>
                            <input type="text" name="Suffix" id="editSuffix" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">College</label>
                            <input type="text" name="College" id="editCollege" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Course</label>
                            <input type="text" name="Course" id="editCourse" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" id="editEmail" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contact No</label>
                            <input type="text" name="ContactNo" id="editContactNo" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning" id="editBtn">
                        <i class="bi bi-check-circle me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
let studentsTable;

$(document).ready(function() {
    // Initialize DataTable with custom config
    studentsTable = DataTableConfig.init('#studentsTable', {
        ajax: {
            url: '/Admin/Students/GetAll',
            dataSrc: function(json) {
                return json.success ? json.data : [];
            }
        },
        columns: [
            { data: 'studentIdNumber', render: data => `<strong class="text-primary">${data}</strong>` },
            { data: 'fullName' },
            { data: 'studentCollege' },
            { data: 'studentCourse', defaultContent: '<span class="text-muted">-</span>' },
            { data: 'studentEmail', defaultContent: '<span class="text-muted">-</span>' },
            { data: 'studentContactNo', defaultContent: '<span class="text-muted">-</span>' },
            { 
                data: 'studentStatus',
                render: data => `<span class="status-badge ${data ? 'available' : 'overdue'}">${data ? 'Active' : 'Blocked'}</span>`
            },
            {
                data: 'studentId',
                orderable: false,
                render: function(data, type, row) {
                    return `
                        <div class="btn-action-group">
                            <button class="btn btn-sm btn-outline-primary btn-action btn-edit" data-id="${data}" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-${row.studentStatus ? 'secondary' : 'success'} btn-action btn-toggle" 
                                    data-id="${data}" data-name="${row.fullName}" data-status="${row.studentStatus}" 
                                    title="${row.studentStatus ? 'Block' : 'Activate'}">
                                <i class="bi bi-${row.studentStatus ? 'slash-circle' : 'check-circle'}"></i>
                            </button>
                        </div>`;
                }
            }
        ],
        order: [[0, 'asc']]
    });

    // Edit student
    $('#studentsTable').on('click', '.btn-edit', async function() {
        const id = $(this).data('id');
        Loading.show('Loading student data...');
        
        try {
            const res = await Api.get(`/Admin/Students/Get/${id}`);
            Loading.hide();
            
            if (res.success) {
                const s = res.data;
                $('#editStudentId').val(s.studentId);
                $('#editIdNumber').val(s.studentIdNumber);
                $('#editFirstName').val(s.studentFirstName);
                $('#editLastName').val(s.studentLastName);
                $('#editMiddleName').val(s.studentMiddleName);
                $('#editSuffix').val(s.studentSuffix);
                $('#editCollege').val(s.studentCollege);
                $('#editCourse').val(s.studentCourse);
                $('#editEmail').val(s.studentEmail);
                $('#editContactNo').val(s.studentContactNo);
                new bootstrap.Modal('#editStudentModal').show();
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.hide();
            Toast.error('Failed to load student data');
        }
    });

    // Toggle status with SweetAlert2
    $('#studentsTable').on('click', '.btn-toggle', async function() {
        const id = $(this).data('id');
        const name = $(this).data('name');
        const isActive = $(this).data('status');
        
        const action = isActive ? 'block' : 'activate';
        const confirmed = await Confirm.action(
            `${isActive ? 'Block' : 'Activate'} Student`,
            `Are you sure you want to ${action} <strong>${name}</strong>?${isActive ? '<br><small class="text-muted">Blocked students cannot borrow equipment.</small>' : ''}`,
            `<i class="bi bi-${isActive ? 'slash-circle' : 'check-circle'} me-1"></i>${isActive ? 'Block' : 'Activate'}`,
            'question'
        );
        
        if (!confirmed) return;
        
        Loading.show('Updating status...');
        
        try {
            const res = await Api.post('/Admin/Students/ToggleStatus', { studentId: id });
            Loading.hide();
            
            if (res.success) {
                Toast.success(`Student ${action}d successfully`);
                studentsTable.ajax.reload(null, false);
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.hide();
            Toast.error('Failed to update status');
        }
    });

    // Create form submission
    $('#createStudentForm').submit(async function(e) {
        e.preventDefault();
        const btn = document.getElementById('createBtn');
        Loading.button(btn, true);
        
        try {
            const res = await $.post('/Admin/Students/Create', $(this).serialize());
            Loading.button(btn, false);
            
            if (res.success) {
                bootstrap.Modal.getInstance('#createStudentModal').hide();
                this.reset();
                studentsTable.ajax.reload();
                Toast.success('Student added successfully');
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.button(btn, false);
            Toast.error('Failed to add student');
        }
    });

    // Edit form submission
    $('#editStudentForm').submit(async function(e) {
        e.preventDefault();
        const btn = document.getElementById('editBtn');
        Loading.button(btn, true);
        
        try {
            const res = await $.post('/Admin/Students/Update', $(this).serialize());
            Loading.button(btn, false);
            
            if (res.success) {
                bootstrap.Modal.getInstance('#editStudentModal').hide();
                studentsTable.ajax.reload(null, false);
                Toast.success('Student updated successfully');
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.button(btn, false);
            Toast.error('Failed to update student');
        }
    });
});
</script>
}
