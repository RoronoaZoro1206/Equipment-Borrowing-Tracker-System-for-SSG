@{
    ViewData["Title"] = "Student Management";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="page-icon-student">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div>
                <h2 class="page-title mb-0">Student Management</h2>
                <p class="text-muted mb-0 small">Manage student records and borrowing eligibility</p>
            </div>
        </div>
        <button class="btn btn-add-student" data-bs-toggle="modal" data-bs-target="#createStudentModal">
            <i class="bi bi-plus-lg me-1"></i>Add Student
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card-student total">
                <div class="stat-icon-student"><i class="bi bi-people-fill"></i></div>
                <div class="stat-content-student">
                    <span class="stat-value-student" id="statTotal">-</span>
                    <span class="stat-label-student">Total Students</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card-student active">
                <div class="stat-icon-student"><i class="bi bi-person-check-fill"></i></div>
                <div class="stat-content-student">
                    <span class="stat-value-student" id="statActive">-</span>
                    <span class="stat-label-student">Active</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card-student blocked">
                <div class="stat-icon-student"><i class="bi bi-person-x-fill"></i></div>
                <div class="stat-content-student">
                    <span class="stat-value-student" id="statBlocked">-</span>
                    <span class="stat-label-student">Blocked</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card-student colleges">
                <div class="stat-icon-student"><i class="bi bi-building"></i></div>
                <div class="stat-content-student">
                    <span class="stat-value-student" id="statColleges">-</span>
                    <span class="stat-label-student">Colleges</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Students Table -->
    <div class="student-card">
        <div class="student-card-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-list-ul"></i>
                <span>Student Records</span>
            </div>
            <button class="btn btn-refresh-student" onclick="refreshData()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
        <div class="student-card-body">
            <!-- Filter Row -->
            <div class="filter-row-student mb-3">
                <div class="filter-group-student">
                    <label class="filter-label-student"><i class="bi bi-funnel me-1"></i>Filters:</label>
                    <select id="filterCollege" class="filter-select-student">
                        <option value="">All Colleges</option>
                    </select>
                    <select id="filterCourse" class="filter-select-student">
                        <option value="">All Courses</option>
                    </select>
                    <select id="filterStatus" class="filter-select-student">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Blocked">Blocked</option>
                    </select>
                    <button class="btn btn-clear-filter-student" id="btnClearFilters" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-student mb-0" id="studentsTable">
                    <thead>
                        <tr>
                            <th>ID Number</th>
                            <th>Full Name</th>
                            <th>College</th>
                            <th>Course</th>
                            <th>Contact</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="spinner-border text-danger" role="status"></div>
                                <p class="text-muted mt-2 mb-0">Loading students...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Student Modal -->
<div class="modal fade" id="createStudentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-student">
            <form id="createStudentForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Add New Student</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label-student">Student ID Number <span class="text-danger">*</span></label>
                            <input type="text" name="StudentIdNumber" class="form-control-student" required placeholder="e.g., 2021-0001">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-student">First Name <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" class="form-control-student" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-student">Last Name <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" class="form-control-student" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-student">Middle Name</label>
                            <input type="text" name="MiddleName" class="form-control-student">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-student">Suffix</label>
                            <input type="text" name="Suffix" class="form-control-student" placeholder="Jr., III">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-student">College <span class="text-danger">*</span></label>
                            <input type="text" name="College" class="form-control-student" required placeholder="e.g., CCICT">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-student">Course</label>
                            <input type="text" name="Course" class="form-control-student" placeholder="e.g., BSIT">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-student">Email</label>
                            <input type="email" name="Email" class="form-control-student" placeholder="student@email.com">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-student">Contact No</label>
                            <input type="text" name="ContactNo" class="form-control-student" placeholder="09XX-XXX-XXXX">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-submit-student" id="createBtn">
                        <i class="bi bi-plus-circle me-1"></i>Add Student
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Student Modal -->
<div class="modal fade" id="editStudentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-student">
            <form id="editStudentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="StudentId" id="editStudentId">
                <div class="modal-header header-warning">
                    <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Edit Student</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label-student">Student ID Number</label>
                            <input type="text" name="StudentIdNumber" id="editIdNumber" class="form-control-student">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-student">First Name</label>
                            <input type="text" name="FirstName" id="editFirstName" class="form-control-student">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-student">Last Name</label>
                            <input type="text" name="LastName" id="editLastName" class="form-control-student">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-student">Middle Name</label>
                            <input type="text" name="MiddleName" id="editMiddleName" class="form-control-student">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-student">Suffix</label>
                            <input type="text" name="Suffix" id="editSuffix" class="form-control-student">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-student">College</label>
                            <input type="text" name="College" id="editCollege" class="form-control-student">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-student">Course</label>
                            <input type="text" name="Course" id="editCourse" class="form-control-student">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-student">Email</label>
                            <input type="email" name="Email" id="editEmail" class="form-control-student">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-student">Contact No</label>
                            <input type="text" name="ContactNo" id="editContactNo" class="form-control-student">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning" id="editBtn">
                        <i class="bi bi-check-circle me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Student Modal -->
<div class="modal fade" id="viewStudentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-student">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-badge me-2"></i>Student Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="student-profile-card">
                    <div class="student-avatar">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <h4 class="student-profile-name" id="viewFullName">-</h4>
                    <span class="student-profile-id" id="viewIdNumber">-</span>
                    <span class="badge-status-student" id="viewStatus">-</span>
                </div>
                <div class="student-details-grid">
                    <div class="student-detail-item">
                        <i class="bi bi-building"></i>
                        <div>
                            <span class="detail-label">College</span>
                            <span class="detail-value" id="viewCollege">-</span>
                        </div>
                    </div>
                    <div class="student-detail-item">
                        <i class="bi bi-book"></i>
                        <div>
                            <span class="detail-label">Course</span>
                            <span class="detail-value" id="viewCourse">-</span>
                        </div>
                    </div>
                    <div class="student-detail-item">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <span class="detail-label">Email</span>
                            <span class="detail-value" id="viewEmail">-</span>
                        </div>
                    </div>
                    <div class="student-detail-item">
                        <i class="bi bi-telephone"></i>
                        <div>
                            <span class="detail-label">Contact</span>
                            <span class="detail-value" id="viewContact">-</span>
                        </div>
                    </div>
                    <div class="student-detail-item">
                        <i class="bi bi-calendar-plus"></i>
                        <div>
                            <span class="detail-label">Date Added</span>
                            <span class="detail-value" id="viewDateAdded">-</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<style>
/* ===========================================
   Student Management - Red & White Theme
   =========================================== */

/* Page Icon */
.page-icon-student {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
    box-shadow: 0 8px 24px rgba(139, 0, 0, 0.25);
}

/* Add Button */
.btn-add-student {
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(139, 0, 0, 0.25);
}

.btn-add-student:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(139, 0, 0, 0.35);
    color: white;
}

/* Stat Cards */
.stat-card-student {
    background: white;
    border-radius: 16px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.stat-card-student::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
}

.stat-card-student.total::before { background: var(--primary-red); }
.stat-card-student.active::before { background: #22c55e; }
.stat-card-student.blocked::before { background: #ef4444; }
.stat-card-student.colleges::before { background: #3b82f6; }

.stat-card-student:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

.stat-icon-student {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
}

.stat-card-student.total .stat-icon-student { background: rgba(139, 0, 0, 0.1); color: var(--primary-red); }
.stat-card-student.active .stat-icon-student { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
.stat-card-student.blocked .stat-icon-student { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
.stat-card-student.colleges .stat-icon-student { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }

.stat-content-student { display: flex; flex-direction: column; }
.stat-value-student { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--text-dark); line-height: 1; }
.stat-label-student { font-size: 0.75rem; color: #6b7280; margin-top: 4px; }

/* Student Card */
.student-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.student-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    font-weight: 600;
}

.student-card-body { padding: 24px; }

.btn-refresh-student {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    transition: all 0.3s ease;
}

.btn-refresh-student:hover { background: rgba(255, 255, 255, 0.3); color: white; }

/* Filter Row */
.filter-row-student {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 14px 16px;
    background: linear-gradient(135deg, #fafafa 0%, #fff 100%);
    border-radius: 10px;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.filter-group-student { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
.filter-label-student { font-weight: 600; font-size: 0.85rem; color: var(--primary-red); margin: 0; }

.filter-select-student {
    padding: 8px 16px;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-size: 0.85rem;
    background: white;
    transition: all 0.3s ease;
    min-width: 140px;
}

.filter-select-student:focus { border-color: var(--primary-red); outline: none; box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1); }

.btn-clear-filter-student {
    background: transparent;
    border: 2px solid #e5e7eb;
    color: #6b7280;
    padding: 8px 12px;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.btn-clear-filter-student:hover { background: #ef4444; border-color: #ef4444; color: white; }

/* Table */
.table-student thead th {
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 14px 12px;
    border: none;
}

.table-student tbody td { padding: 14px 12px; vertical-align: middle; border-bottom: 1px solid rgba(0, 0, 0, 0.05); }
.table-student tbody tr:hover { background: rgba(139, 0, 0, 0.03); }

/* Status Badges */
.badge-status-student { padding: 4px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; }
.badge-status-student.active { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); color: white; }
.badge-status-student.blocked { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; }

/* Action Buttons */
.btn-action-student {
    width: 32px;
    height: 32px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: all 0.3s ease;
    border-width: 2px;
}

.btn-action-student:hover { transform: scale(1.1); }

.btn-action-student i { font-size: 0.85rem; }

.btn-action-student.btn-outline-danger { color: var(--primary-red); border-color: var(--primary-red); }
.btn-action-student.btn-outline-danger:hover { background: var(--primary-red); color: white; border-color: var(--primary-red); }

.btn-action-student.btn-outline-warning { color: #f59e0b; border-color: #f59e0b; }
.btn-action-student.btn-outline-warning:hover { background: #f59e0b; color: white; border-color: #f59e0b; }

.btn-action-student.btn-outline-secondary { color: #6b7280; border-color: #6b7280; }
.btn-action-student.btn-outline-secondary:hover { background: #6b7280; color: white; border-color: #6b7280; }

.btn-action-student.btn-outline-success { color: #22c55e; border-color: #22c55e; }
.btn-action-student.btn-outline-success:hover { background: #22c55e; color: white; border-color: #22c55e; }

/* Modal */
.modal-student { border-radius: 16px; overflow: hidden; border: none; }
.modal-student .modal-header { background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); color: white; border: none; padding: 20px 24px; }
.modal-student .modal-header.header-warning { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
.modal-student .modal-body { padding: 24px; }
.modal-student .modal-footer { border-top: 1px solid rgba(0, 0, 0, 0.05); padding: 16px 24px; }

/* Form Controls */
.form-label-student { font-weight: 600; font-size: 0.85rem; color: var(--text-dark); margin-bottom: 8px; display: block; }

.form-control-student {
    width: 100%;
    padding: 10px 14px;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.form-control-student:focus { border-color: var(--primary-red); outline: none; box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1); }

.btn-submit-student {
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
}

.btn-submit-student:hover { color: white; box-shadow: 0 4px 12px rgba(139, 0, 0, 0.3); }

/* Student Profile Card (View Modal) */
.student-profile-card {
    text-align: center;
    padding: 24px;
    background: linear-gradient(135deg, #fafafa 0%, #fff 100%);
    border-radius: 12px;
    margin-bottom: 20px;
}

.student-avatar {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    color: white;
    font-size: 2.5rem;
}

.student-profile-name {
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 4px;
}

.student-profile-id {
    display: block;
    color: var(--primary-red);
    font-weight: 600;
    font-family: monospace;
    margin-bottom: 12px;
}

/* Student Details Grid */
.student-details-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.student-detail-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #fafafa;
    border-radius: 8px;
}

.student-detail-item i {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.9rem;
}

.student-detail-item div { display: flex; flex-direction: column; }
.detail-label { font-size: 0.7rem; color: #6b7280; text-transform: uppercase; }
.detail-value { font-weight: 600; color: var(--text-dark); }

/* Responsive */
@@media (max-width: 991px) {
    .stat-card-student { padding: 16px; }
    .stat-value-student { font-size: 1.25rem; }
}

@@media (max-width: 768px) {
    .filter-row-student { padding: 12px; }
    .filter-group-student { width: 100%; }
    .filter-select-student { flex: 1; min-width: 100px; }
}
</style>


@section Scripts {
<script>
let studentsTable;
let allStudentsData = [];

$(document).ready(function() {
    initStudentsTable();
    setupFilterHandlers();
    setupFormHandlers();
    setupModalCleanup();
});

function initStudentsTable() {
    studentsTable = $('#studentsTable').DataTable({
        ajax: {
            url: '/Admin/Students/GetAll',
            dataSrc: function(json) {
                if (json.success && json.data) {
                    allStudentsData = json.data;
                    populateFilters(json.data);
                    updateStats(json.data);
                    return json.data;
                }
                return [];
            }
        },
        responsive: true,
        pageLength: 10,
        order: [[0, 'asc']],
        language: {
            search: "",
            searchPlaceholder: "Search...",
            lengthMenu: "Show _MENU_",
            info: "Showing _START_ to _END_ of _TOTAL_",
            emptyTable: '<div class="text-center py-5"><i class="bi bi-people text-muted" style="font-size: 3rem;"></i><p class="text-muted mt-3 mb-0">No students found</p></div>'
        },
        columns: [
            { 
                data: 'studentIdNumber',
                render: function(data) {
                    return '<strong class="text-danger">' + data + '</strong>';
                }
            },
            { 
                data: 'fullName',
                render: function(data) {
                    return '<strong>' + data + '</strong>';
                }
            },
            { 
                data: 'studentCollege',
                render: function(data) {
                    return '<span class="badge bg-secondary">' + (data || '-') + '</span>';
                }
            },
            { 
                data: 'studentCourse',
                render: function(data) {
                    return data || '<span class="text-muted">-</span>';
                }
            },
            { 
                data: null,
                render: function(data, type, row) {
                    var contact = row.studentContactNo || row.studentEmail;
                    return contact ? '<small>' + contact + '</small>' : '<span class="text-muted">-</span>';
                }
            },
            { 
                data: 'studentStatus',
                render: function(data) {
                    var statusClass = data ? 'active' : 'blocked';
                    var statusText = data ? 'Active' : 'Blocked';
                    return '<span class="badge-status-student ' + statusClass + '">' + statusText + '</span>';
                }
            },
            {
                data: null,
                orderable: false,
                render: function(data, type, row) {
                    var toggleBtnClass = row.studentStatus ? 'btn-outline-secondary' : 'btn-outline-success';
                    var toggleIcon = row.studentStatus ? 'person-slash' : 'person-check';
                    var toggleTitle = row.studentStatus ? 'Block' : 'Activate';
                    
                    return '<div class="d-flex gap-1">' +
                        '<button class="btn btn-sm btn-outline-danger btn-action-student btn-view-student" data-id="' + row.studentId + '" title="View"><i class="bi bi-eye-fill"></i></button>' +
                        '<button class="btn btn-sm btn-outline-warning btn-action-student btn-edit-student" data-id="' + row.studentId + '" title="Edit"><i class="bi bi-pencil-fill"></i></button>' +
                        '<button class="btn btn-sm ' + toggleBtnClass + ' btn-action-student btn-toggle-student" data-id="' + row.studentId + '" data-name="' + row.fullName + '" data-status="' + row.studentStatus + '" title="' + toggleTitle + '"><i class="bi bi-' + toggleIcon + '"></i></button>' +
                    '</div>';
                }
            }
        ]
    });
}

function populateFilters(data) {
    // Get unique colleges
    var colleges = [...new Set(data.map(function(s) { return s.studentCollege; }).filter(Boolean))].sort();
    var currentCollege = $('#filterCollege').val();
    $('#filterCollege').empty().append('<option value="">All Colleges</option>');
    colleges.forEach(function(c) {
        $('#filterCollege').append('<option value="' + c + '"' + (c === currentCollege ? ' selected' : '') + '>' + c + '</option>');
    });
    
    // Get unique courses
    var courses = [...new Set(data.map(function(s) { return s.studentCourse; }).filter(Boolean))].sort();
    var currentCourse = $('#filterCourse').val();
    $('#filterCourse').empty().append('<option value="">All Courses</option>');
    courses.forEach(function(c) {
        $('#filterCourse').append('<option value="' + c + '"' + (c === currentCourse ? ' selected' : '') + '>' + c + '</option>');
    });
}

function updateStats(data) {
    var total = data.length;
    var active = data.filter(function(s) { return s.studentStatus; }).length;
    var blocked = data.filter(function(s) { return !s.studentStatus; }).length;
    var colleges = [...new Set(data.map(function(s) { return s.studentCollege; }).filter(Boolean))].length;
    
    $('#statTotal').text(total);
    $('#statActive').text(active);
    $('#statBlocked').text(blocked);
    $('#statColleges').text(colleges);
}

function setupFilterHandlers() {
    $('#filterCollege').on('change', function() {
        var val = $(this).val();
        studentsTable.column(2).search(val ? '^' + val + '$' : '', true, false).draw();
    });
    
    $('#filterCourse').on('change', function() {
        var val = $(this).val();
        studentsTable.column(3).search(val ? val : '', false, false).draw();
    });
    
    $('#filterStatus').on('change', function() {
        var val = $(this).val();
        studentsTable.column(5).search(val ? val : '', false, false).draw();
    });
    
    $('#btnClearFilters').on('click', function() {
        $('#filterCollege, #filterCourse, #filterStatus').val('');
        studentsTable.search('').columns().search('').draw();
        showToast('Filters cleared', 'info');
    });
}

function setupFormHandlers() {
    // View student
    $(document).on('click', '.btn-view-student', function() {
        var id = $(this).data('id');
        $.get('/Admin/Students/Get/' + id, function(res) {
            if (res.success) {
                var s = res.data;
                $('#viewFullName').text(s.fullName);
                $('#viewIdNumber').text(s.studentIdNumber);
                $('#viewStatus').removeClass('active blocked').addClass(s.studentStatus ? 'active' : 'blocked').text(s.studentStatus ? 'Active' : 'Blocked');
                $('#viewCollege').text(s.studentCollege || '-');
                $('#viewCourse').text(s.studentCourse || '-');
                $('#viewEmail').text(s.studentEmail || '-');
                $('#viewContact').text(s.studentContactNo || '-');
                $('#viewDateAdded').text(s.studentDateAdded ? new Date(s.studentDateAdded).toLocaleDateString() : '-');
                new bootstrap.Modal('#viewStudentModal').show();
            } else {
                showToast(res.message, 'error');
            }
        });
    });

    // Edit student
    $(document).on('click', '.btn-edit-student', function() {
        var id = $(this).data('id');
        $.get('/Admin/Students/Get/' + id, function(res) {
            if (res.success) {
                var s = res.data;
                $('#editStudentId').val(s.studentId);
                $('#editIdNumber').val(s.studentIdNumber);
                $('#editFirstName').val(s.studentFirstName);
                $('#editLastName').val(s.studentLastName);
                $('#editMiddleName').val(s.studentMiddleName);
                $('#editSuffix').val(s.studentSuffix);
                $('#editCollege').val(s.studentCollege);
                $('#editCourse').val(s.studentCourse);
                $('#editEmail').val(s.studentEmail);
                $('#editContactNo').val(s.studentContactNo);
                new bootstrap.Modal('#editStudentModal').show();
            } else {
                showToast(res.message, 'error');
            }
        });
    });

    // Toggle status
    $(document).on('click', '.btn-toggle-student', function() {
        var id = $(this).data('id');
        var name = $(this).data('name');
        var isActive = $(this).data('status');
        var action = isActive ? 'block' : 'activate';
        
        Swal.fire({
            title: (isActive ? 'Block' : 'Activate') + ' Student?',
            html: 'Are you sure you want to ' + action + ' <strong>' + name + '</strong>?' + 
                  (isActive ? '<br><small class="text-muted">Blocked students cannot borrow equipment.</small>' : ''),
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: isActive ? '#6b7280' : '#22c55e',
            cancelButtonColor: '#6b7280',
            confirmButtonText: '<i class="bi bi-' + (isActive ? 'slash-circle' : 'check-circle') + ' me-1"></i>' + (isActive ? 'Block' : 'Activate'),
            cancelButtonText: 'Cancel'
        }).then(function(result) {
            if (result.isConfirmed) {
                $.post('/Admin/Students/ToggleStatus', { 
                    studentId: id, 
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
                }, function(res) {
                    if (res.success) {
                        showToast('Student ' + action + 'd successfully', 'success');
                        studentsTable.ajax.reload(null, false);
                    } else {
                        showToast(res.message, 'error');
                    }
                });
            }
        });
    });

    // Create form
    $('#createStudentForm').submit(function(e) {
        e.preventDefault();
        var $btn = $('#createBtn');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Adding...');
        
        $.post('/Admin/Students/Create', $(this).serialize(), function(res) {
            $btn.prop('disabled', false).html('<i class="bi bi-plus-circle me-1"></i>Add Student');
            if (res.success) {
                bootstrap.Modal.getInstance('#createStudentModal').hide();
                $('#createStudentForm')[0].reset();
                studentsTable.ajax.reload();
                showToast('Student added successfully', 'success');
            } else {
                showToast(res.message, 'error');
            }
        });
    });

    // Edit form
    $('#editStudentForm').submit(function(e) {
        e.preventDefault();
        var $btn = $('#editBtn');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');
        
        $.post('/Admin/Students/Update', $(this).serialize(), function(res) {
            $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Save Changes');
            if (res.success) {
                bootstrap.Modal.getInstance('#editStudentModal').hide();
                studentsTable.ajax.reload(null, false);
                showToast('Student updated successfully', 'success');
            } else {
                showToast(res.message, 'error');
            }
        });
    });
}

function setupModalCleanup() {
    $('#createStudentModal, #editStudentModal, #viewStudentModal').on('hidden.bs.modal', function() {
        $('.modal-backdrop').remove();
        $('body').removeClass('modal-open').css('padding-right', '');
    });
}

function refreshData() {
    showToast('Refreshing...', 'info');
    studentsTable.ajax.reload();
}

function showToast(message, type) {
    var bgColors = {
        success: 'linear-gradient(135deg, #22c55e, #16a34a)',
        error: 'linear-gradient(135deg, #ef4444, #dc2626)',
        warning: 'linear-gradient(135deg, #f59e0b, #d97706)',
        info: 'linear-gradient(135deg, #8b0000, #5c0000)'
    };
    
    Toastify({
        text: message,
        duration: 3000,
        gravity: "top",
        position: "right",
        style: {
            background: bgColors[type] || bgColors.info,
            borderRadius: '10px',
            boxShadow: '0 4px 12px rgba(0,0,0,0.15)'
        }
    }).showToast();
}
</script>
}
