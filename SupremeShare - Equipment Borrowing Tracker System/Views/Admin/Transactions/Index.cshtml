@{
    ViewData["Title"] = "Transactions";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-arrow-left-right me-2"></i>Transactions</h2>
        <div>
            <a href="/Admin/Transactions/Borrow" class="btn btn-success me-2">
                <i class="bi bi-box-arrow-up me-1"></i>New Borrow
            </a>
            <a href="/Admin/Transactions/Return" class="btn btn-warning">
                <i class="bi bi-box-arrow-in-down me-1"></i>Process Return
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card bg-primary text-white">
                <div class="card-body text-center py-3">
                    <h3 id="statBorrowedToday">-</h3>
                    <small>Borrowed Today</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-info text-white">
                <div class="card-body text-center py-3">
                    <h3 id="statActive">-</h3>
                    <small>Active Borrows</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-success text-white">
                <div class="card-body text-center py-3">
                    <h3 id="statReturnedToday">-</h3>
                    <small>Returned Today</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center py-3">
                    <h3 id="statOverdue">-</h3>
                    <small>Overdue</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-danger text-white">
                <div class="card-body text-center py-3">
                    <h3 id="statLost">-</h3>
                    <small>Lost Items</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-secondary text-white">
                <div class="card-body text-center py-3">
                    <button class="btn btn-light btn-sm" id="btnUpdateOverdue">
                        <i class="bi bi-clock-history"></i> Update Overdue
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <i class="bi bi-list-ul me-2"></i>Recent Transactions
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover" id="transactionsTable" style="width:100%">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Student</th>
                        <th>Date Borrowed</th>
                        <th>Items</th>
                        <th>Status</th>
                        <th>Processed By</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Transaction Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Transaction Details: <span id="detailCode"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Student:</strong> <span id="detailStudent"></span><br>
                        <strong>College:</strong> <span id="detailCollege"></span>
                    </div>
                    <div class="col-md-6">
                        <strong>Date Borrowed:</strong> <span id="detailDate"></span><br>
                        <strong>Remarks:</strong> <span id="detailRemarks"></span>
                    </div>
                </div>
                <h6>Borrowed Items:</h6>
                <table class="table table-sm" id="detailItemsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Equipment</th>
                            <th>Serial No</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Returned</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let transactionsTable;

$(document).ready(function() {
    loadStats();

    function loadStats() {
        $.get('/Admin/Transactions/Stats', function(res) {
            if (res.success) {
                $('#statBorrowedToday').text(res.data.borrowedToday);
                $('#statActive').text(res.data.activeBorrows);
                $('#statReturnedToday').text(res.data.returnedToday);
                $('#statOverdue').text(res.data.overdueCount);
                $('#statLost').text(res.data.lostCount);
            }
        });
    }

    // Initialize DataTable
    transactionsTable = $('#transactionsTable').DataTable({
        ajax: {
            url: '/Admin/Transactions/GetAll',
            dataSrc: function(json) {
                return json.success ? json.data : [];
            }
        },
        columns: [
            { data: 'transactionCode', render: function(data) { return `<strong>${data || '-'}</strong>`; } },
            { 
                data: null,
                render: function(data) {
                    return `${data.studentIdNumber}<br><small class="text-muted">${data.studentName}</small>`;
                }
            },
            { data: 'dateBorrowed' },
            { data: 'itemCount' },
            { 
                data: 'statuses',
                render: function(data) {
                    if (!data) return '-';
                    return data.split(', ').map(s => {
                        const cls = s === 'borrowed' ? 'bg-info' : s === 'returned' ? 'bg-success' : s === 'overdue' ? 'bg-warning' : 'bg-danger';
                        return `<span class="badge ${cls}">${s}</span>`;
                    }).join(' ');
                }
            },
            { data: 'processedBy' },
            {
                data: 'transactionId',
                render: function(data) {
                    return `<button class="btn btn-sm btn-outline-primary btn-view" data-id="${data}">
                                <i class="bi bi-eye"></i> View
                            </button>`;
                }
            }
        ],
        order: [[2, 'desc']],
        responsive: true,
        language: {
            emptyTable: "No transactions found",
            search: "Search:"
        }
    });

    // View details
    $('#transactionsTable').on('click', '.btn-view', function() {
        const id = $(this).data('id');
        $.get(`/Admin/Transactions/GetDetails/${id}`, function(res) {
            if (res.success) {
                const d = res.data;
                $('#detailCode').text(d.transactionCode);
                $('#detailStudent').text(`${d.student.studentIdNumber} - ${d.student.fullName}`);
                $('#detailCollege').text(d.student.studentCollege || '-');
                $('#detailDate').text(new Date(d.transactionDateBorrowed).toLocaleString());
                $('#detailRemarks').text(d.transactionRemarks || '-');

                let itemsHtml = '';
                d.items.forEach(item => {
                    const statusCls = item.borrowStatus === 'borrowed' ? 'bg-info' : 
                                     item.borrowStatus === 'returned' ? 'bg-success' : 
                                     item.borrowStatus === 'overdue' ? 'bg-warning' : 'bg-danger';
                    const returnedDate = item.borrowDateReturned ? new Date(item.borrowDateReturned).toLocaleDateString() : '-';
                    const conditionBadge = item.borrowReturnCondition === true ? '<span class="badge bg-success">Good</span>' :
                                          item.borrowReturnCondition === false ? '<span class="badge bg-danger">Damaged</span>' : '-';
                    
                    itemsHtml += `<tr>
                        <td>${item.equipmentName}</td>
                        <td>${item.serialNo}</td>
                        <td>${new Date(item.borrowDueDate).toLocaleDateString()}
                            ${item.daysOverdue > 0 ? `<br><small class="text-danger">${item.daysOverdue} days overdue</small>` : ''}
                        </td>
                        <td><span class="badge ${statusCls}">${item.borrowStatus}</span></td>
                        <td>${returnedDate} ${conditionBadge}</td>
                        <td>
                            ${item.borrowStatus === 'borrowed' || item.borrowStatus === 'overdue' ? 
                              `<button class="btn btn-sm btn-success btn-return" data-id="${item.borrowId}">Return</button>
                               <button class="btn btn-sm btn-danger btn-lost" data-id="${item.borrowId}">Lost</button>` : ''}
                        </td>
                    </tr>`;
                });
                $('#detailItemsTable tbody').html(itemsHtml);
                $('#detailsModal').modal('show');
            }
        });
    });

    // Quick return from modal
    $(document).on('click', '.btn-return', function() {
        const borrowId = $(this).data('id');
        const condition = confirm('Is the item in GOOD condition?\n\nClick OK for Good, Cancel for Damaged');
        $.post('/Admin/Transactions/ProcessReturn', {
            BorrowId: borrowId,
            Condition: condition,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        }, function(res) {
            alert(res.message);
            if (res.success) {
                $('#detailsModal').modal('hide');
                transactionsTable.ajax.reload();
                loadStats();
            }
        });
    });

    // Mark as lost
    $(document).on('click', '.btn-lost', function() {
        if (confirm('Mark this item as LOST? This will block the student from future borrowing.')) {
            $.post('/Admin/Transactions/MarkLost', {
                borrowId: $(this).data('id'),
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function(res) {
                alert(res.message);
                if (res.success) {
                    $('#detailsModal').modal('hide');
                    transactionsTable.ajax.reload();
                    loadStats();
                }
            });
        }
    });

    // Update overdue
    $('#btnUpdateOverdue').click(function() {
        $.post('/Admin/Transactions/UpdateOverdue', {
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        }, function(res) {
            alert(res.message);
            if (res.success) {
                transactionsTable.ajax.reload();
                loadStats();
            }
        });
    });
});
</script>
}
