function loadStudents() {
    $.get('/Admin/Students/GetAll', function(res) {
        if (res.success) {
            studentsData = res.data;
            
            // Populate filters
            const colleges = [...new Set(res.data.map(s => s.studentCollege).filter(c => c))];
            const courses = [...new Set(res.data.map(s => s.studentCourse).filter(c => c))];
            
            colleges.forEach(c => $('#filterCollege').append(`<option value="${c}">${c}</option>`));
            courses.forEach(c => $('#filterCourse').append(`<option value="${c}">${c}</option>`));
            
            renderStudentsTable(studentsData);
        }
    });
}

function filterStudents() {
    const search = $('#searchStudent').val().toLowerCase();
    const college = $('#filterCollege').val();
    const course = $('#filterCourse').val();
    
    let filtered = studentsData.filter(s => {
        const matchSearch = !search || 
            s.studentIdNumber.toLowerCase().includes(search) || 
            s.fullName.toLowerCase().includes(search);
        const matchCollege = !college || s.studentCollege === college;
        const matchCourse = !course || s.studentCourse === course;
        return matchSearch && matchCollege && matchCourse;
    });
    
    renderStudentsTable(filtered);
}

