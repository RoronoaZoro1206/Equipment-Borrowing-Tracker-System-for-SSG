@{
    ViewData["Title"] = "Borrow an Item";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="page-icon-borrow">
                <i class="bi bi-box-arrow-up"></i>
            </div>
            <div>
                <h2 class="page-title mb-0">New Borrow Transaction</h2>
                <p class="text-muted mb-0 small">Process equipment borrowing for students</p>
            </div>
        </div>
        <a href="/Admin/Transactions" class="btn btn-back-borrow">
            <i class="bi bi-arrow-left me-1"></i>Back to Transactions
        </a>
    </div>

    <div class="row g-4">
        <!-- Borrow Form -->
        <div class="col-lg-8">
            <div class="borrow-card">
                <div class="borrow-card-header">
                    <i class="bi bi-clipboard-check me-2"></i>Borrow Form
                </div>
                <div class="borrow-card-body">
                    <form id="borrowForm">
                        @Html.AntiForgeryToken()
                        
                        <!-- Step 1: Select Student -->
                        <div class="form-step mb-4">
                            <div class="step-header">
                                <span class="step-number">1</span>
                                <span class="step-title">Select Student (Borrower)</span>
                            </div>
                            <div class="step-content">
                                <div class="search-box">
                                    <i class="bi bi-search search-icon"></i>
                                    <input type="text" id="studentSearch" class="search-input" placeholder="Search by Student ID Number or Name...">
                                    <button type="button" class="btn btn-search" id="btnSearchStudent">Search</button>
                                </div>
                                <div id="studentResults" class="student-results"></div>
                                <div id="selectedStudent" class="selected-item d-none">
                                    <div class="selected-icon"><i class="bi bi-person-check-fill"></i></div>
                                    <div class="selected-info">
                                        <span class="selected-label">Selected Student</span>
                                        <span class="selected-value" id="studentInfo"></span>
                                    </div>
                                    <button type="button" class="btn-clear-selection" onclick="clearStudent()"><i class="bi bi-x-lg"></i></button>
                                    <input type="hidden" name="StudentId" id="studentId">
                                </div>
                            </div>
                        </div>

                        <!-- Step 2: Select Equipment -->
                        <div class="form-step mb-4">
                            <div class="step-header">
                                <span class="step-number">2</span>
                                <span class="step-title">Select Equipment</span>
                            </div>
                            <div class="step-content">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label-borrow">Equipment Type</label>
                                        <select id="equipmentSelect" class="form-select-borrow">
                                            <option value="">-- Select Equipment --</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-borrow">Available Unit</label>
                                        <select id="unitSelect" class="form-select-borrow" name="UnitId" disabled>
                                            <option value="">-- Select Unit --</option>
                                        </select>
                                    </div>
                                </div>
                                <div id="selectedUnit" class="selected-item success d-none mt-3">
                                    <div class="selected-icon success"><i class="bi bi-box-seam-fill"></i></div>
                                    <div class="selected-info">
                                        <span class="selected-label">Selected Unit</span>
                                        <span class="selected-value" id="unitInfo"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Set Due Date -->
                        <div class="form-step mb-4">
                            <div class="step-header">
                                <span class="step-number">3</span>
                                <span class="step-title">Set Due Date</span>
                            </div>
                            <div class="step-content">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-6">
                                        <label class="form-label-borrow">Due Date</label>
                                        <input type="datetime-local" name="DueDate" id="dueDate" class="form-control-borrow" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-borrow">Quick Select</label>
                                        <div class="quick-select-group">
                                            <button type="button" class="btn-quick" data-days="1">1 Day</button>
                                            <button type="button" class="btn-quick" data-days="3">3 Days</button>
                                            <button type="button" class="btn-quick" data-days="7">1 Week</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Submit -->
                        <button type="submit" class="btn btn-submit-borrow" id="btnSubmit" disabled>
                            <i class="bi bi-check-circle me-2"></i>Process Borrow Transaction
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Summary Panel -->
        <div class="col-lg-4">
            <div class="summary-card">
                <div class="summary-header">
                    <i class="bi bi-receipt me-2"></i>Transaction Summary
                </div>
                <div class="summary-body">
                    <div class="summary-row">
                        <span class="summary-label">Student:</span>
                        <span class="summary-value" id="summaryStudent">-</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Equipment:</span>
                        <span class="summary-value" id="summaryEquipment">-</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Serial No:</span>
                        <span class="summary-value" id="summarySerial">-</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Due Date:</span>
                        <span class="summary-value" id="summaryDue">-</span>
                    </div>
                </div>
            </div>

            <div class="instructions-card mt-3">
                <div class="instructions-header">
                    <i class="bi bi-lightbulb me-2"></i>Instructions
                </div>
                <div class="instructions-body">
                    <div class="instruction-item">
                        <span class="instruction-num">1</span>
                        <span>Search and select the student borrower</span>
                    </div>
                    <div class="instruction-item">
                        <span class="instruction-num">2</span>
                        <span>Choose equipment type and available unit</span>
                    </div>
                    <div class="instruction-item">
                        <span class="instruction-num">3</span>
                        <span>Set the due date for return</span>
                    </div>
                    <div class="instruction-item">
                        <span class="instruction-num">4</span>
                        <span>Click "Process Borrow Transaction"</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* ===========================================
   Borrow Page - Red & White Luxury Theme
   =========================================== */

/* Page Icon */
.page-icon-borrow {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
    box-shadow: 0 8px 24px rgba(139, 0, 0, 0.25);
}

/* Back Button */
.btn-back-borrow {
    background: white;
    color: var(--primary-red);
    border: 2px solid var(--primary-red);
    padding: 10px 20px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-back-borrow:hover {
    background: var(--primary-red);
    color: white;
}

/* Borrow Card */
.borrow-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.borrow-card-header {
    padding: 18px 24px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    font-weight: 600;
    font-size: 1rem;
}

.borrow-card-body {
    padding: 24px;
}

/* Form Steps */
.form-step {
    background: #fafafa;
    border-radius: 12px;
    padding: 20px;
    border: 1px solid rgba(0, 0, 0, 0.05);
}

.step-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid rgba(139, 0, 0, 0.1);
}

.step-number {
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
}

.step-title {
    font-weight: 600;
    color: var(--text-dark);
    font-size: 1rem;
}

.step-content {
    padding-left: 40px;
}

/* Search Box */
.search-box {
    display: flex;
    align-items: center;
    background: white;
    border: 2px solid #e5e7eb;
    border-radius: 10px;
    padding: 4px;
    transition: all 0.3s ease;
}

.search-box:focus-within {
    border-color: var(--primary-red);
    box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1);
}

.search-icon {
    padding: 0 12px;
    color: #9ca3af;
}

.search-input {
    flex: 1;
    border: none;
    outline: none;
    padding: 10px 0;
    font-size: 0.9rem;
}

.btn-search {
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-search:hover {
    box-shadow: 0 4px 12px rgba(139, 0, 0, 0.3);
    color: white;
}

/* Student Results */
.student-results {
    max-height: 200px;
    overflow-y: auto;
    margin-top: 12px;
}

.student-item {
    display: block;
    padding: 12px 16px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-bottom: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
}

.student-item:hover {
    border-color: var(--primary-red);
    background: rgba(139, 0, 0, 0.02);
    transform: translateX(4px);
}

.student-item .student-id {
    font-weight: 700;
    color: var(--primary-red);
}

.student-item .student-name {
    color: var(--text-dark);
}

.student-item .student-details {
    font-size: 0.8rem;
    color: #6b7280;
    margin-top: 4px;
}

.student-blocked {
    background: #fef2f2;
    border-color: #fecaca;
    cursor: not-allowed;
}

.student-blocked .blocked-badge {
    background: #ef4444;
    color: white;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
}

/* Selected Item */
.selected-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(59, 130, 246, 0.05) 100%);
    border: 2px solid #3b82f6;
    border-radius: 10px;
    margin-top: 12px;
}

.selected-item.success {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.1) 0%, rgba(34, 197, 94, 0.05) 100%);
    border-color: #22c55e;
}

.selected-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.1rem;
}

.selected-icon.success {
    background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
}

.selected-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.selected-label {
    font-size: 0.7rem;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.selected-value {
    font-weight: 600;
    color: var(--text-dark);
}

.btn-clear-selection {
    background: transparent;
    border: none;
    color: #6b7280;
    padding: 8px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-clear-selection:hover {
    background: #ef4444;
    color: white;
}

/* Form Controls */
.form-label-borrow {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-dark);
    margin-bottom: 8px;
    display: block;
}

.form-select-borrow,
.form-control-borrow {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid #e5e7eb;
    border-radius: 10px;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    background: white;
}

.form-select-borrow:focus,
.form-control-borrow:focus {
    border-color: var(--primary-red);
    outline: none;
    box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1);
}

.form-select-borrow:disabled {
    background: #f3f4f6;
    cursor: not-allowed;
}

/* Quick Select */
.quick-select-group {
    display: flex;
    gap: 8px;
}

.btn-quick {
    flex: 1;
    padding: 12px 16px;
    background: white;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-dark);
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-quick:hover {
    border-color: var(--primary-red);
    color: var(--primary-red);
}

.btn-quick.active {
    background: var(--primary-red);
    border-color: var(--primary-red);
    color: white;
}

/* Submit Button */
.btn-submit-borrow {
    width: 100%;
    padding: 16px 24px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(139, 0, 0, 0.25);
}

.btn-submit-borrow:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(139, 0, 0, 0.35);
}

.btn-submit-borrow:disabled {
    background: #d1d5db;
    box-shadow: none;
    cursor: not-allowed;
}

/* Summary Card */
.summary-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.summary-header {
    padding: 16px 20px;
    background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
    color: white;
    font-weight: 600;
}

.summary-body {
    padding: 20px;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.summary-row:last-child {
    border-bottom: none;
}

.summary-label {
    color: #6b7280;
    font-size: 0.85rem;
}

.summary-value {
    font-weight: 600;
    color: var(--text-dark);
    text-align: right;
}

/* Instructions Card */
.instructions-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.instructions-header {
    padding: 16px 20px;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: white;
    font-weight: 600;
}

.instructions-body {
    padding: 20px;
}

.instruction-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
}

.instruction-num {
    width: 24px;
    height: 24px;
    background: rgba(139, 0, 0, 0.1);
    color: var(--primary-red);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.75rem;
    flex-shrink: 0;
}

.instruction-item span:last-child {
    font-size: 0.85rem;
    color: #4b5563;
    line-height: 1.5;
}

/* Responsive */
@@media (max-width: 991px) {
    .step-content {
        padding-left: 0;
    }
}

@@media (max-width: 768px) {
    .quick-select-group {
        flex-direction: column;
    }
    
    .search-box {
        flex-wrap: wrap;
    }
    
    .search-input {
        width: 100%;
        order: 1;
    }
    
    .search-icon {
        order: 0;
    }
    
    .btn-search {
        order: 2;
        width: 100%;
        margin-top: 8px;
    }
}
</style>

@section Scripts {
<script>
$(document).ready(function() {
    // Set default due date to 7 days from now
    const defaultDue = new Date();
    defaultDue.setDate(defaultDue.getDate() + 7);
    $('#dueDate').val(defaultDue.toISOString().slice(0, 16));
    $('#summaryDue').text(defaultDue.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }));

    // Load equipment types
    $.get('/Admin/Equipment/GetAll', function(res) {
        if (res.success) {
            res.data.forEach(function(e) {
                if (e.availableStock > 0) {
                    $('#equipmentSelect').append('<option value="' + e.equipmentId + '" data-name="' + e.equipmentName + '">' + e.equipmentName + ' (' + e.availableStock + ' available)</option>');
                }
            });
        }
    });

    // Search student
    $('#btnSearchStudent').click(searchStudent);
    $('#studentSearch').keypress(function(e) { 
        if (e.which === 13) { 
            e.preventDefault(); 
            searchStudent(); 
        }
    });

    function searchStudent() {
        var q = $('#studentSearch').val().trim();
        if (q.length < 2) {
            showToast('Please enter at least 2 characters', 'warning');
            return;
        }
        
        $('#studentResults').html('<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-danger"></div> Searching...</div>');
        
        $.get('/Admin/Students/Search?q=' + encodeURIComponent(q), function(res) {
            if (res.success) {
                var html = '';
                res.data.forEach(function(s) {
                    if (s.studentStatus) {
                        html += '<a href="#" class="student-item" data-id="' + s.studentId + '" data-number="' + s.studentIdNumber + '" data-name="' + s.fullName + '">' +
                                    '<span class="student-id">' + s.studentIdNumber + '</span> - <span class="student-name">' + s.fullName + '</span>' +
                                    '<div class="student-details">' + s.studentCollege + (s.studentCourse ? ' - ' + s.studentCourse : '') + '</div>' +
                                '</a>';
                    } else {
                        html += '<div class="student-item student-blocked">' +
                                    '<span class="student-id">' + s.studentIdNumber + '</span> - <span class="student-name">' + s.fullName + '</span>' +
                                    '<span class="blocked-badge ms-2">BLOCKED</span>' +
                                    '<div class="student-details text-danger">Cannot borrow equipment</div>' +
                                '</div>';
                    }
                });
                $('#studentResults').html(html || '<div class="text-center text-muted py-3">No students found</div>');
            }
        });
    }

    // Select student
    $(document).on('click', '.student-item:not(.student-blocked)', function(e) {
        e.preventDefault();
        var id = $(this).data('id');
        var number = $(this).data('number');
        var name = $(this).data('name');
        
        $('#studentId').val(id);
        $('#studentInfo').text(number + ' - ' + name);
        $('#selectedStudent').removeClass('d-none');
        $('#studentResults').empty();
        $('#studentSearch').val('');
        $('#summaryStudent').text(name);
        
        showToast('Student selected', 'success');
        checkFormComplete();
    });

    // Equipment type change - load available units
    $('#equipmentSelect').change(function() {
        var equipmentId = $(this).val();
        var equipmentName = $(this).find(':selected').data('name');
        
        $('#unitSelect').empty().append('<option value="">-- Select Unit --</option>').prop('disabled', true);
        $('#selectedUnit').addClass('d-none');
        $('#summaryEquipment').text(equipmentName || '-');
        $('#summarySerial').text('-');

        if (equipmentId) {
            $.get('/Admin/Equipment/AvailableUnits/' + equipmentId, function(res) {
                if (res.success && res.data.length > 0) {
                    res.data.forEach(function(u) {
                        var condition = u.condition ? 'Good' : 'Damaged';
                        $('#unitSelect').append('<option value="' + u.eunitId + '" data-serial="' + u.eunitSerialNo + '">' + u.eunitSerialNo + ' (' + condition + ')</option>');
                    });
                    $('#unitSelect').prop('disabled', false);
                } else {
                    $('#unitSelect').append('<option value="">No available units</option>');
                }
            });
        }
        checkFormComplete();
    });

    // Unit selection
    $('#unitSelect').change(function() {
        var serial = $(this).find(':selected').data('serial');
        if ($(this).val()) {
            $('#unitInfo').text(serial);
            $('#selectedUnit').removeClass('d-none');
            $('#summarySerial').text(serial);
            showToast('Unit selected: ' + serial, 'success');
        } else {
            $('#selectedUnit').addClass('d-none');
            $('#summarySerial').text('-');
        }
        checkFormComplete();
    });

    // Due date quick select
    $('.btn-quick').click(function() {
        $('.btn-quick').removeClass('active');
        $(this).addClass('active');
        
        var days = $(this).data('days');
        var due = new Date();
        due.setDate(due.getDate() + days);
        $('#dueDate').val(due.toISOString().slice(0, 16));
        $('#summaryDue').text(due.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }));
        checkFormComplete();
    });

    $('#dueDate').change(function() {
        $('.btn-quick').removeClass('active');
        var date = new Date($(this).val());
        $('#summaryDue').text(date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }));
        checkFormComplete();
    });

    function checkFormComplete() {
        var studentId = $('#studentId').val();
        var unitId = $('#unitSelect').val();
        var dueDate = $('#dueDate').val();
        $('#btnSubmit').prop('disabled', !(studentId && unitId && dueDate));
    }

    // Submit form
    $('#borrowForm').submit(function(e) {
        e.preventDefault();
        
        var studentName = $('#summaryStudent').text();
        var equipment = $('#summaryEquipment').text();
        var serial = $('#summarySerial').text();
        
        Swal.fire({
            title: 'Confirm Borrow Transaction',
            html: '<div class="text-start">' +
                  '<p><strong>Student:</strong> ' + studentName + '</p>' +
                  '<p><strong>Equipment:</strong> ' + equipment + '</p>' +
                  '<p><strong>Serial No:</strong> ' + serial + '</p>' +
                  '<p><strong>Due Date:</strong> ' + $('#summaryDue').text() + '</p>' +
                  '</div>',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#8b0000',
            cancelButtonColor: '#6b7280',
            confirmButtonText: '<i class="bi bi-check-circle me-1"></i>Process Transaction',
            cancelButtonText: 'Cancel'
        }).then(function(result) {
            if (result.isConfirmed) {
                var $btn = $('#btnSubmit');
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Processing...');
                
                $.post('/Admin/Transactions/ProcessBorrow', $('#borrowForm').serialize(), function(res) {
                    if (res.success) {
                        Swal.fire({
                            title: 'Success!',
                            html: 'Transaction processed successfully.<br><strong>Code: ' + res.transactionCode + '</strong>',
                            icon: 'success',
                            confirmButtonColor: '#8b0000'
                        }).then(function() {
                            window.location.href = '/Admin/Transactions';
                        });
                    } else {
                        $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-2"></i>Process Borrow Transaction');
                        showToast(res.message, 'error');
                    }
                }).fail(function() {
                    $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-2"></i>Process Borrow Transaction');
                    showToast('An error occurred', 'error');
                });
            }
        });
    });
});

function clearStudent() {
    $('#studentId').val('');
    $('#studentInfo').text('');
    $('#selectedStudent').addClass('d-none');
    $('#summaryStudent').text('-');
    $('#btnSubmit').prop('disabled', true);
}

function showToast(message, type) {
    var bgColors = {
        success: 'linear-gradient(135deg, #22c55e, #16a34a)',
        error: 'linear-gradient(135deg, #ef4444, #dc2626)',
        warning: 'linear-gradient(135deg, #f59e0b, #d97706)',
        info: 'linear-gradient(135deg, #8b0000, #5c0000)'
    };
    
    Toastify({
        text: message,
        duration: 3000,
        gravity: "top",
        position: "right",
        style: {
            background: bgColors[type] || bgColors.info,
            borderRadius: '10px',
            boxShadow: '0 4px 12px rgba(0,0,0,0.15)'
        }
    }).showToast();
}
</script>
}
