<style>
/* ===========================================
   Borrow Page - Red & White Luxury Theme
   =========================================== */

/* Page Icon */
.page-icon-borrow {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
    box-shadow: 0 8px 24px rgba(139, 0, 0, 0.25);
}

/* Back Button */
.btn-back-borrow {
    background: white;
    color: var(--primary-red);
    border: 2px solid var(--primary-red);
    padding: 10px 20px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-back-borrow:hover {
    background: var(--primary-red);
    color: white;
}

/* Borrow Card */
.borrow-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.borrow-card-header {
    padding: 18px 24px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    font-weight: 600;
    font-size: 1rem;
}

.borrow-card-body {
    padding: 24px;
}

/* Form Steps */
.form-step {
    background: #fafafa;
    border-radius: 12px;
    padding: 20px;
    border: 1px solid rgba(0, 0, 0, 0.05);
}

.step-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid rgba(139, 0, 0, 0.1);
}

.step-number {
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
}

.step-title {
    font-weight: 600;
    color: var(--text-dark);
    font-size: 1rem;
}

.step-content {
    padding-left: 40px;
}

/* Search Box */
.search-box {
    display: flex;
    align-items: center;
    background: white;
    border: 2px solid #e5e7eb;
    border-radius: 10px;
    padding: 4px;
    transition: all 0.3s ease;
}

.search-box:focus-within {
    border-color: var(--primary-red);
    box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1);
}

.search-icon {
    padding: 0 12px;
    color: #9ca3af;
}

.search-input {
    flex: 1;
    border: none;
    outline: none;
    padding: 10px 0;
    font-size: 0.9rem;
}

.btn-search {
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-search:hover {
    box-shadow: 0 4px 12px rgba(139, 0, 0, 0.3);
    color: white;
}

/* Student Results */
.student-results {
    max-height: 200px;
    overflow-y: auto;
    margin-top: 12px;
}

.student-item {
    display: block;
    padding: 12px 16px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-bottom: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
}

.student-item:hover {
    border-color: var(--primary-red);
    background: rgba(139, 0, 0, 0.02);
    transform: translateX(4px);
}

.student-item .student-id {
    font-weight: 700;
    color: var(--primary-red);
}

.student-item .student-name {
    color: var(--text-dark);
}

.student-item .student-details {
    font-size: 0.8rem;
    color: #6b7280;
    margin-top: 4px;
}

.student-blocked {
    background: #fef2f2;
    border-color: #fecaca;
    cursor: not-allowed;
}

.student-blocked .blocked-badge {
    background: #ef4444;
    color: white;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
}

/* Selected Item */
.selected-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(59, 130, 246, 0.05) 100%);
    border: 2px solid #3b82f6;
    border-radius: 10px;
    margin-top: 12px;
}

.selected-item.success {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.1) 0%, rgba(34, 197, 94, 0.05) 100%);
    border-color: #22c55e;
}

.selected-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.1rem;
}

.selected-icon.success {
    background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
}

.selected-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.selected-label {
    font-size: 0.7rem;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.selected-value {
    font-weight: 600;
    color: var(--text-dark);
}

.btn-clear-selection {
    background: transparent;
    border: none;
    color: #6b7280;
    padding: 8px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-clear-selection:hover {
    background: #ef4444;
    color: white;
}

/* Form Controls */
.form-label-borrow {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-dark);
    margin-bottom: 8px;
    display: block;
}

.form-select-borrow,
.form-control-borrow {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid #e5e7eb;
    border-radius: 10px;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    background: white;
}

.form-select-borrow:focus,
.form-control-borrow:focus {
    border-color: var(--primary-red);
    outline: none;
    box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1);
}

.form-select-borrow:disabled {
    background: #f3f4f6;
    cursor: not-allowed;
}

/* Quick Select */
.quick-select-group {
    display: flex;
    gap: 8px;
}

.btn-quick {
    flex: 1;
    padding: 12px 16px;
    background: white;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-dark);
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-quick:hover {
    border-color: var(--primary-red);
    color: var(--primary-red);
}

.btn-quick.active {
    background: var(--primary-red);
    border-color: var(--primary-red);
    color: white;
}

/* Submit Button */
.btn-submit-borrow {
    width: 100%;
    padding: 16px 24px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(139, 0, 0, 0.25);
}

.btn-submit-borrow:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(139, 0, 0, 0.35);
}

.btn-submit-borrow:disabled {
    background: #d1d5db;
    box-shadow: none;
    cursor: not-allowed;
}

/* Summary Card */
.summary-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.summary-header {
    padding: 16px 20px;
    background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
    color: white;
    font-weight: 600;
}

.summary-body {
    padding: 20px;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.summary-row:last-child {
    border-bottom: none;
}

.summary-label {
    color: #6b7280;
    font-size: 0.85rem;
}

.summary-value {
    font-weight: 600;
    color: var(--text-dark);
    text-align: right;
}

/* Instructions Card */
.instructions-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.instructions-header {
    padding: 16px 20px;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: white;
    font-weight: 600;
}

.instructions-body {
    padding: 20px;
}

.instruction-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
}

.instruction-num {
    width: 24px;
    height: 24px;
    background: rgba(139, 0, 0, 0.1);
    color: var(--primary-red);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.75rem;
    flex-shrink: 0;
}

.instruction-item span:last-child {
    font-size: 0.85rem;
    color: #4b5563;
    line-height: 1.5;
}

/* Responsive */
@@media (max-width: 991px) {
    .step-content {
        padding-left: 0;
    }
}

@@media (max-width: 768px) {
    .quick-select-group {
        flex-direction: column;
    }
    
    .search-box {
        flex-wrap: wrap;
    }
    
    .search-input {
        width: 100%;
        order: 1;
    }
    
    .search-icon {
        order: 0;
    }
    
    .btn-search {
        order: 2;
        width: 100%;
        margin-top: 8px;
    }
}
