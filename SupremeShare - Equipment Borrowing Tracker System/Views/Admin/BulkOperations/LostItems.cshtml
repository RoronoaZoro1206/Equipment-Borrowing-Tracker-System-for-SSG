@using SupremeShare___Equipment_Borrowing_Tracker_System.Services
@model List<LostItemRecord>
@{
    ViewData["Title"] = "Lost Items Management";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-exclamation-triangle me-2 text-danger"></i>Lost Items Management</h2>
        <a href="/Admin/BulkOperations" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="alert alert-warning d-flex align-items-center">
        <i class="bi bi-info-circle me-2 fs-5"></i>
        <div>
            <strong>Lost Item Protocol:</strong> When an item is marked as lost, the student is automatically blocked from borrowing until manually unblocked by an administrator.
        </div>
    </div>

    <div class="card card-hover">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-ul me-2"></i>Lost Items Registry</span>
            <span class="badge bg-light text-danger">@Model.Count items</span>
        </div>
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <h5 class="empty-state-title">No Lost Items</h5>
                    <p class="empty-state-text">Great news! There are no lost items recorded in the system.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="lostItemsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Transaction</th>
                                <th>Student</th>
                                <th>Equipment</th>
                                <th class="hide-mobile">Borrow Date</th>
                                <th class="hide-mobile">Lost Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="fade-in">
                                    <td><code class="text-primary">@item.TransactionCode</code></td>
                                    <td>
                                        <strong>@item.StudentIdNumber</strong><br>
                                        <small class="text-muted">@item.StudentName</small>
                                    </td>
                                    <td>
                                        @item.EquipmentName<br>
                                        <small class="text-muted">@item.SerialNo</small>
                                    </td>
                                    <td class="hide-mobile">@item.BorrowDate.ToString("MMM dd, yyyy")</td>
                                    <td class="hide-mobile">@(item.LostDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                    <td>
                                        @if (item.StudentBlocked)
                                        {
                                            <span class="status-badge overdue pulse-alert">
                                                <i class="bi bi-lock-fill"></i> Blocked
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge available">
                                                <i class="bi bi-check-circle"></i> Active
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.StudentBlocked)
                                        {
                                            <button class="btn btn-sm btn-outline-success btn-action" 
                                                    onclick="unblockStudent(@item.StudentId, '@item.StudentIdNumber', '@item.StudentName')">
                                                <i class="bi bi-unlock"></i> <span class="d-none d-md-inline">Unblock</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Initialize DataTable
    $(document).ready(function() {
        if ($('#lostItemsTable tbody tr').length > 0) {
            DataTableConfig.init('#lostItemsTable', {
                order: [[4, 'desc']], // Sort by lost date
                columnDefs: [
                    { orderable: false, targets: [6] } // Disable sorting on actions column
                ]
            });
        }
    });

    async function unblockStudent(studentId, studentIdNumber, studentName) {
        const result = await Confirm.unblock(`${studentName} (${studentIdNumber})`);
        
        if (!result.confirmed) return;

        Loading.show('Unblocking student...');

        try {
            const response = await Api.post('/Admin/BulkOperations/UnblockStudent', {
                studentId: studentId,
                reason: result.reason
            });

            Loading.hide();

            if (response.success) {
                await Result.success('Student Unblocked', `<strong>${studentIdNumber}</strong> has been unblocked and can now borrow equipment.`);
                location.reload();
            } else {
                Toast.error(response.message || 'Failed to unblock student');
            }
        } catch (error) {
            Loading.hide();
            Toast.error('Error: ' + error.message);
        }
    }
</script>
}
