@{
    ViewData["Title"] = "Bulk Borrow";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-box-arrow-up me-2"></i>Bulk Borrow</h2>
        <a href="/Admin/BulkOperations" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="card card-hover">
        <div class="card-header bg-success text-white">
            <i class="bi bi-calendar-event me-2"></i>Event Bulk Borrow
        </div>
        <div class="card-body">
            <form id="bulkBorrowForm">
                @Html.AntiForgeryToken()
                <div class="row mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label class="form-label">Event Name</label>
                        <input type="text" class="form-control" id="eventName" placeholder="e.g., Science Fair 2025" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Due Date</label>
                        <input type="datetime-local" class="form-control" id="dueDate" required>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered" id="borrowItemsTable">
                        <thead class="table-light">
                            <tr>
                                <th width="40">#</th>
                                <th>Student ID Number</th>
                                <th>Equipment Unit ID</th>
                                <th width="60">
                                    <button type="button" class="btn btn-sm btn-success" onclick="addBorrowRow()">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="borrowItemsBody">
                            <tr class="fade-in">
                                <td>1</td>
                                <td><input type="text" class="form-control form-control-sm student-id" placeholder="Student ID Number"></td>
                                <td><input type="number" class="form-control form-control-sm unit-id" placeholder="Unit ID"></td>
                                <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mt-4">
                    <button type="button" class="btn btn-outline-primary" onclick="addMultipleRows()">
                        <i class="bi bi-plus-circle me-1"></i>Add 5 Rows
                    </button>
                    <button type="submit" class="btn btn-success" id="submitBtn">
                        <i class="bi bi-check-circle me-1"></i>Process Bulk Borrow
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let rowCounter = 1;

    function addBorrowRow() {
        rowCounter++;
        const tbody = document.getElementById('borrowItemsBody');
        const row = document.createElement('tr');
        row.className = 'fade-in';
        row.innerHTML = `
            <td>${rowCounter}</td>
            <td><input type="text" class="form-control form-control-sm student-id" placeholder="Student ID Number"></td>
            <td><input type="number" class="form-control form-control-sm unit-id" placeholder="Unit ID"></td>
            <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)"><i class="bi bi-trash"></i></button></td>
        `;
        tbody.appendChild(row);
        Toast.info(`Row ${rowCounter} added`);
    }

    function addMultipleRows() {
        for (let i = 0; i < 5; i++) addBorrowRow();
        Toast.success('5 rows added');
    }

    async function removeRow(btn) {
        const tbody = document.getElementById('borrowItemsBody');
        if (tbody.children.length > 1) {
            const confirmed = await Confirm.action('Remove Row', 'Are you sure you want to remove this row?', 'Remove', 'question');
            if (confirmed) {
                btn.closest('tr').remove();
                updateRowNumbers();
                Toast.warning('Row removed');
            }
        } else {
            Toast.error('Cannot remove the last row');
        }
    }

    function updateRowNumbers() {
        const rows = document.querySelectorAll('#borrowItemsBody tr');
        rows.forEach((row, index) => {
            row.cells[0].textContent = index + 1;
        });
        rowCounter = rows.length;
    }

    document.getElementById('bulkBorrowForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const eventName = document.getElementById('eventName').value;
        const dueDate = document.getElementById('dueDate').value;
        
        if (!eventName || !dueDate) {
            Toast.error('Please fill in all required fields');
            return;
        }

        const items = [];
        document.querySelectorAll('#borrowItemsBody tr').forEach(row => {
            const studentIdNumber = row.querySelector('.student-id').value.trim();
            const unitId = row.querySelector('.unit-id').value.trim();
            if (studentIdNumber && unitId) {
                items.push({ studentIdNumber, unitId: parseInt(unitId), dueDate });
            }
        });

        if (items.length === 0) {
            Toast.error('Please add at least one valid item');
            return;
        }

        // Confirm before processing
        const confirmed = await Confirm.action(
            'Process Bulk Borrow',
            `You are about to process <strong>${items.length}</strong> borrow transactions for <strong>${eventName}</strong>.<br><br>Continue?`,
            '<i class="bi bi-check-circle me-1"></i>Process',
            'question'
        );

        if (!confirmed) return;

        const submitBtn = document.getElementById('submitBtn');
        Loading.button(submitBtn, true);

        try {
            const result = await Api.post('/Admin/BulkOperations/ProcessBulkBorrow', { eventName, items });

            Loading.button(submitBtn, false);

            if (result.success) {
                await Result.bulkOperation(result.data);
                if (result.data.successCount > 0) {
                    Form.reset(document.getElementById('bulkBorrowForm'));
                }
            } else {
                Toast.error(result.message || 'Operation failed');
            }
        } catch (error) {
            Loading.button(submitBtn, false);
            Toast.error('Error processing request: ' + error.message);
        }
    });

    // Set default due date to tomorrow
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    tomorrow.setHours(17, 0, 0, 0);
    document.getElementById('dueDate').value = tomorrow.toISOString().slice(0, 16);
</script>
}
