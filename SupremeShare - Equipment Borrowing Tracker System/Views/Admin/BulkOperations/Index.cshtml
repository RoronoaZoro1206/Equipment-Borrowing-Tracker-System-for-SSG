@{
    ViewData["Title"] = "Bulk Operations & Advanced Features";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-stack me-2"></i>Bulk Operations & Advanced Features</h2>
        <a href="/Admin" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>

    <!-- Operation Cards -->
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <a href="/Admin/BulkOperations/BulkBorrow" class="text-decoration-none">
                <div class="card h-100 card-hover operation-card">
                    <div class="card-body text-center py-4">
                        <div class="operation-icon bg-success text-white mx-auto mb-3">
                            <i class="bi bi-box-arrow-up"></i>
                        </div>
                        <h5 class="mb-2">Bulk Borrow</h5>
                        <p class="text-muted small mb-3">Process multiple borrow transactions for events</p>
                        <span class="badge bg-success">Event Management</span>
                    </div>
                </div>
            </a>
        </div>
        
        <div class="col-md-6 col-lg-3">
            <a href="/Admin/BulkOperations/BulkReturn" class="text-decoration-none">
                <div class="card h-100 card-hover operation-card">
                    <div class="card-body text-center py-4">
                        <div class="operation-icon bg-warning text-dark mx-auto mb-3">
                            <i class="bi bi-box-arrow-in-down"></i>
                        </div>
                        <h5 class="mb-2">Bulk Return</h5>
                        <p class="text-muted small mb-3">Process multiple returns after events</p>
                        <span class="badge bg-warning text-dark">Event Cleanup</span>
                    </div>
                </div>
            </a>
        </div>
        
        <div class="col-md-6 col-lg-3">
            <a href="/Admin/BulkOperations/LostItems" class="text-decoration-none">
                <div class="card h-100 card-hover operation-card">
                    <div class="card-body text-center py-4">
                        <div class="operation-icon bg-danger text-white mx-auto mb-3">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <h5 class="mb-2">Lost Items</h5>
                        <p class="text-muted small mb-3">Manage lost items and blocked students</p>
                        <span class="badge bg-danger">Lost Protocol</span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-3">
            <a href="/Admin/BulkOperations/ConditionTracking" class="text-decoration-none">
                <div class="card h-100 card-hover operation-card">
                    <div class="card-body text-center py-4">
                        <div class="operation-icon bg-info text-white mx-auto mb-3">
                            <i class="bi bi-clipboard-check"></i>
                        </div>
                        <h5 class="mb-2">Condition Tracking</h5>
                        <p class="text-muted small mb-3">Track equipment condition changes</p>
                        <span class="badge bg-info">Maintenance</span>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Export Section -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card card-hover">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-download me-2"></i>Export Reports</span>
                    <small class="opacity-75">Download as Excel-compatible files</small>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <button class="btn btn-outline-danger w-100" onclick="exportReport('Overdue')">
                                <i class="bi bi-file-earmark-excel me-2"></i>
                                <span class="d-none d-sm-inline">Overdue Report</span>
                                <span class="d-sm-none">Overdue</span>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button class="btn btn-outline-primary w-100" onclick="exportReport('Equipment')">
                                <i class="bi bi-file-earmark-excel me-2"></i>
                                <span class="d-none d-sm-inline">Equipment Utilization</span>
                                <span class="d-sm-none">Equipment</span>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button class="btn btn-outline-secondary w-100" onclick="showAuditExportModal()">
                                <i class="bi bi-file-earmark-excel me-2"></i>
                                <span class="d-none d-sm-inline">Audit Log</span>
                                <span class="d-sm-none">Audit</span>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button class="btn btn-outline-success w-100" onclick="showStudentExportModal()">
                                <i class="bi bi-file-earmark-excel me-2"></i>
                                <span class="d-none d-sm-inline">Student History</span>
                                <span class="d-sm-none">Student</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Audit Export Modal -->
<div class="modal fade" id="auditExportModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-file-earmark-excel me-2"></i>Export Audit Log</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">From Date <small class="text-muted">(optional)</small></label>
                    <input type="date" class="form-control" id="auditFromDate">
                </div>
                <div class="mb-3">
                    <label class="form-label">To Date <small class="text-muted">(optional)</small></label>
                    <input type="date" class="form-control" id="auditToDate">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="exportAuditLog()">
                    <i class="bi bi-download me-1"></i>Export
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Student Export Modal -->
<div class="modal fade" id="studentExportModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-file-earmark-excel me-2"></i>Export Student History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Student ID <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" id="exportStudentId" placeholder="Enter Student ID (numeric)">
                    <small class="text-muted">Enter the internal student ID, not the ID number</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="exportStudentHistory()">
                    <i class="bi bi-download me-1"></i>Export
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .operation-card {
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
        border: 1px solid rgba(0,0,0,0.08);
    }
    .operation-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }
    .operation-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
    }
</style>

@section Scripts {
<script>
    function showAuditExportModal() {
        new bootstrap.Modal(document.getElementById('auditExportModal')).show();
    }

    function showStudentExportModal() {
        new bootstrap.Modal(document.getElementById('studentExportModal')).show();
    }

    async function exportReport(type) {
        Toast.info(`Generating ${type} report...`);
        try {
            window.location.href = `/Admin/BulkOperations/Export${type === 'Equipment' ? 'EquipmentUtilization' : type + 'Report'}`;
            setTimeout(() => Toast.success('Download started'), 1000);
        } catch (error) {
            Toast.error('Export failed: ' + error.message);
        }
    }

    function exportAuditLog() {
        const fromDate = document.getElementById('auditFromDate').value;
        const toDate = document.getElementById('auditToDate').value;
        let url = '/Admin/BulkOperations/ExportAuditLog';
        const params = [];
        if (fromDate) params.push(`fromDate=${fromDate}`);
        if (toDate) params.push(`toDate=${toDate}`);
        if (params.length > 0) url += '?' + params.join('&');
        
        Toast.info('Generating Audit Log report...');
        window.location.href = url;
        bootstrap.Modal.getInstance(document.getElementById('auditExportModal')).hide();
        setTimeout(() => Toast.success('Download started'), 1000);
    }

    function exportStudentHistory() {
        const studentId = document.getElementById('exportStudentId').value;
        if (!studentId) {
            Toast.error('Please enter a Student ID');
            return;
        }
        
        Toast.info('Generating Student History report...');
        window.location.href = `/Admin/BulkOperations/ExportStudentHistory/${studentId}`;
        bootstrap.Modal.getInstance(document.getElementById('studentExportModal')).hide();
        setTimeout(() => Toast.success('Download started'), 1000);
    }
</script>
}
