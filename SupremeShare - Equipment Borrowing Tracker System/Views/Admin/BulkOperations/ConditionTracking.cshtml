@using SupremeShare___Equipment_Borrowing_Tracker_System.Services
@model List<EquipmentConditionSummary>
@{
    ViewData["Title"] = "Equipment Condition Tracking";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clipboard-check me-2"></i>Equipment Condition Tracking</h2>
        <a href="/Admin/BulkOperations" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card card-hover bg-primary text-white">
                <div class="card-body text-center py-3">
                    <h3 class="mb-1">@Model.Sum(x => x.TotalUnits)</h3>
                    <small>Total Units</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-hover bg-success text-white">
                <div class="card-body text-center py-3">
                    <h3 class="mb-1">@Model.Sum(x => x.GoodUnits)</h3>
                    <small>Good Condition</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-hover bg-danger text-white">
                <div class="card-body text-center py-3">
                    <h3 class="mb-1">@Model.Sum(x => x.DamagedUnits)</h3>
                    <small>Damaged</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-hover bg-warning text-dark">
                <div class="card-body text-center py-3">
                    <h3 class="mb-1">@Model.Sum(x => x.LostUnits)</h3>
                    <small>Lost</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-hover">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <span><i class="bi bi-table me-2"></i>Equipment Condition Summary</span>
            <button class="btn btn-sm btn-light" onclick="refreshData()">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="conditionTable">
                    <thead class="table-light">
                        <tr>
                            <th>Equipment</th>
                            <th>Category</th>
                            <th class="text-center">Total</th>
                            <th class="text-center">Good</th>
                            <th class="text-center">Damaged</th>
                            <th class="text-center hide-mobile">Available</th>
                            <th class="text-center hide-mobile">Borrowed</th>
                            <th>Health</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var healthPercent = item.TotalUnits > 0 ? (item.GoodUnits * 100 / item.TotalUnits) : 0;
                            var healthClass = healthPercent >= 80 ? "success" : healthPercent >= 50 ? "warning" : "danger";
                            <tr class="fade-in">
                                <td><strong>@item.EquipmentName</strong></td>
                                <td><span class="badge bg-secondary">@item.Category</span></td>
                                <td class="text-center">@item.TotalUnits</td>
                                <td class="text-center"><span class="badge bg-success">@item.GoodUnits</span></td>
                                <td class="text-center">
                                    @if (item.DamagedUnits > 0)
                                    {
                                        <span class="badge bg-danger">@item.DamagedUnits</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center hide-mobile">
                                    <span class="badge bg-primary">@item.AvailableUnits</span>
                                </td>
                                <td class="text-center hide-mobile">
                                    @if (item.BorrowedUnits > 0)
                                    {
                                        <span class="badge bg-info">@item.BorrowedUnits</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td style="min-width: 120px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar bg-@healthClass" style="width: @healthPercent%"></div>
                                        </div>
                                        <small class="text-@healthClass fw-bold">@healthPercent%</small>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Legend -->
    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-4 justify-content-center">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-success rounded" style="width: 16px; height: 16px;"></div>
                    <small>Good (≥80%)</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-warning rounded" style="width: 16px; height: 16px;"></div>
                    <small>Fair (50-79%)</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-danger rounded" style="width: 16px; height: 16px;"></div>
                    <small>Poor (&lt;50%)</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        DataTableConfig.init('#conditionTable', {
            order: [[2, 'desc']], // Sort by total units
            columnDefs: [
                { orderable: false, targets: [7] } // Disable sorting on health column
            ]
        });
    });

    function refreshData() {
        Toast.info('Refreshing data...');
        location.reload();
    }
</script>
}
