@{
    ViewData["Title"] = "Student Borrowing History";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-lines-fill me-2 text-primary"></i>Student Borrowing History</h2>
        <a href="/Admin/Reports" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Reports
        </a>
    </div>

    <!-- Search Student -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-search me-2"></i>Search Student
        </div>
        <div class="card-body">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input type="text" id="studentSearch" class="form-control" placeholder="Enter Student ID Number or Name...">
                <button class="btn btn-primary" id="btnSearch">Search</button>
            </div>
            <div id="searchResults" class="list-group mt-2" style="max-height: 200px; overflow-y: auto;"></div>
        </div>
    </div>

    <!-- Selected Student Info -->
    <div class="card shadow-sm mb-4" id="studentInfoCard" style="display: none;">
        <div class="card-header bg-dark text-white">
            <i class="bi bi-person-badge me-2"></i>Student Information
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <strong>Student ID:</strong><br>
                    <span id="infoStudentId">-</span>
                </div>
                <div class="col-md-3">
                    <strong>Name:</strong><br>
                    <span id="infoStudentName">-</span>
                </div>
                <div class="col-md-3">
                    <strong>College:</strong><br>
                    <span id="infoStudentCollege">-</span>
                </div>
                <div class="col-md-3">
                    <strong>Status:</strong><br>
                    <span id="infoStudentStatus">-</span>
                </div>
            </div>
        </div>
    </div>

    <!-- History Summary -->
    <div class="row g-3 mb-4" id="summaryCards" style="display: none;">
        <div class="col-md-3">
            <div class="card bg-primary text-white text-center">
                <div class="card-body">
                    <h3 id="statTotalBorrows">0</h3>
                    <small>Total Borrows</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white text-center">
                <div class="card-body">
                    <h3 id="statReturned">0</h3>
                    <small>Returned</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white text-center">
                <div class="card-body">
                    <h3 id="statActive">0</h3>
                    <small>Active Borrows</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white text-center">
                <div class="card-body">
                    <h3 id="statOverdue">0</h3>
                    <small>Overdue</small>
                </div>
            </div>
        </div>
    </div>

    <!-- History Table -->
    <div class="card shadow-sm" id="historyCard" style="display: none;">
        <div class="card-header bg-dark text-white">
            <i class="bi bi-table me-2"></i>Borrowing History
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="historyTable">
                    <thead class="table-light">
                        <tr>
                            <th>Transaction Code</th>
                            <th>Equipment</th>
                            <th>Serial No</th>
                            <th>Date Borrowed</th>
                            <th>Due Date</th>
                            <th>Date Returned</th>
                            <th>Condition</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- No Student Selected -->
    <div class="text-center text-muted py-5" id="noStudentMessage">
        <i class="bi bi-search fs-1"></i>
        <p class="mt-3">Search for a student to view their borrowing history</p>
    </div>
</div>

@section Scripts {
<script>
let selectedStudentId = null;

$(document).ready(function() {
    $('#btnSearch').click(searchStudent);
    $('#studentSearch').keypress(function(e) { if (e.which === 13) searchStudent(); });
});

function searchStudent() {
    const q = $('#studentSearch').val().trim();
    if (q.length < 2) return;

    $.get(`/Admin/Students/Search?q=${encodeURIComponent(q)}`, function(res) {
        if (res.success && res.data.length > 0) {
            let html = '';
            res.data.forEach(s => {
                const statusBadge = s.studentStatus ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Blocked</span>';
                html += `<a href="#" class="list-group-item list-group-item-action student-result" 
                            data-id="${s.studentId}" data-number="${s.studentIdNumber}" 
                            data-name="${s.fullName}" data-college="${s.studentCollege}"
                            data-status="${s.studentStatus}">
                            <strong>${s.studentIdNumber}</strong> - ${s.fullName} ${statusBadge}
                            <small class="text-muted d-block">${s.studentCollege}</small>
                        </a>`;
            });
            $('#searchResults').html(html);
        } else {
            $('#searchResults').html('<div class="list-group-item text-muted">No students found</div>');
        }
    });
}

$(document).on('click', '.student-result', function(e) {
    e.preventDefault();
    selectedStudentId = $(this).data('id');
    
    // Update student info
    $('#infoStudentId').text($(this).data('number'));
    $('#infoStudentName').text($(this).data('name'));
    $('#infoStudentCollege').text($(this).data('college'));
    $('#infoStudentStatus').html($(this).data('status') ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Blocked</span>');
    
    // Show cards
    $('#studentInfoCard, #summaryCards, #historyCard').show();
    $('#noStudentMessage').hide();
    $('#searchResults').empty();
    
    // Load history
    loadHistory(selectedStudentId);
});

function loadHistory(studentId) {
    $.get(`/Admin/Reports/GetStudentHistory/${studentId}`, function(res) {
        if (res.success) {
            renderHistory(res.data);
            updateSummary(res.data);
        }
    });
}

let historyDataTable = null;

function renderHistory(data) {
    // Initialize DataTable if not already
    if (!historyDataTable) {
        historyDataTable = $('#historyTable').DataTable({
            order: [[3, 'desc']], // Sort by date borrowed descending
            pageLength: 25,
            columnDefs: [
                { orderable: true, targets: '_all' }
            ]
        });
    }
    
    historyDataTable.clear();
    data.forEach(item => {
        const statusClass = item.status === 'returned' ? 'bg-success' : 
                           item.status === 'overdue' ? 'bg-danger' : 'bg-info';
        const conditionClass = item.returnCondition === 'Good' ? 'text-success' : 
                              item.returnCondition === 'Damaged' ? 'text-danger' : 'text-muted';
        
        historyDataTable.row.add([
            `<code>${item.transactionCode}</code>`,
            `${item.equipmentName}<br><small class="text-muted">${item.category}</small>`,
            `<strong>${item.serialNo}</strong>`,
            item.dateBorrowed,
            item.dueDate,
            item.dateReturned || '-',
            `<span class="${conditionClass}">${item.returnCondition || '-'}</span>`,
            `<span class="badge ${statusClass}">${item.status}</span>`
        ]);
    });
    historyDataTable.draw();
}

function updateSummary(data) {
    $('#statTotalBorrows').text(data.length);
    $('#statReturned').text(data.filter(d => d.status === 'returned').length);
    $('#statActive').text(data.filter(d => d.status === 'borrowed').length);
    $('#statOverdue').text(data.filter(d => d.status === 'overdue').length);
}
</script>
}
