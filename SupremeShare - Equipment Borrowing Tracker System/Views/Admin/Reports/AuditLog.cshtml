function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function updateStats(data) {
    var total = data.length;
    var today = new Date().toISOString().split('T')[0];
    var todayCount = data.filter(function(d) { return d.loggedAt.startsWith(today); }).length;
    var users = [...new Set(data.map(function(d) { return d.username; }).filter(Boolean))].length;
    var actions = [...new Set(data.map(function(d) { return d.action; }))].length;
    
    $('#statTotal').text(total);
    $('#statToday').text(todayCount);
    $('#statUsers').text(users);
    $('#statActions').text(actions);
}

function populateUserFilter(data) {
    var users = [...new Set(data.map(function(d) { return d.username; }).filter(Boolean))].sort();
    var current = $('#filterUser').val();
    $('#filterUser').empty().append('<option value="">All Users</option>');
    users.forEach(function(u) {
        $('#filterUser').append('<option value="' + u + '"' + (u === current ? ' selected' : '') + '>' + u + '</option>');
    });
}

function setupFilterHandlers() {
    $('#filterAction').on('change', function() {
        var val = $(this).val();
        auditTable.column(2).search(val ? val : '', false, false).draw();
    });
    
    $('#filterUser').on('change', function() {
        var val = $(this).val();
        auditTable.column(1).search(val ? val : '', false, false).draw();
    });
    
    $('#btnClearFilters').on('click', function() {
        $('#filterAction, #filterUser').val('');
        auditTable.search('').columns().search('').draw();
        showToast('Filters cleared', 'info');
    });
    
    // View details
    $(document).on('click', '.btn-view-audit', function() {
        var data = $(this).data();
        $('#detailTimestamp').text(data.timestamp);
        $('#detailUser').text(data.user);
        $('#detailAction').html('<span class="badge-action ' + getActionClass(data.action) + '">' + data.action + '</span>');
        $('#detailOldData').text(formatJson(data.old));
        $('#detailNewData').text(formatJson(data.new));
        new bootstrap.Modal('#detailModal').show();
    });
}

function formatJson(str) {
    if (!str || str === '-') return '-';
    try {
        var obj = JSON.parse(str);
        return JSON.stringify(obj, null, 2);
    } catch (e) {
        return str;
    }
}

function setupModalCleanup() {
    $('#detailModal').on('hidden.bs.modal', function() {
        $('.modal-backdrop').remove();
        $('body').removeClass('modal-open').css('padding-right', '');
    });
}

