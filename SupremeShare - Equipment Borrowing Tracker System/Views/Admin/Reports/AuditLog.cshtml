<style>
/* ===========================================
   Audit Log - Red & White Luxury Theme
   =========================================== */

/* Page Icon */
.page-icon-audit {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
    box-shadow: 0 8px 24px rgba(139, 0, 0, 0.25);
}

/* Back Button */
.btn-back-audit {
    background: white;
    color: var(--primary-red);
    border: 2px solid var(--primary-red);
    padding: 10px 20px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-back-audit:hover {
    background: var(--primary-red);
    color: white;
}

/* Stat Cards */
.stat-card-audit {
    background: white;
    border-radius: 16px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.stat-card-audit::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
}

.stat-card-audit.total::before { background: var(--primary-red); }
.stat-card-audit.today::before { background: #3b82f6; }
.stat-card-audit.users::before { background: #22c55e; }
.stat-card-audit.actions::before { background: #f59e0b; }

.stat-card-audit:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

.stat-icon-audit {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
}

.stat-card-audit.total .stat-icon-audit { background: rgba(139, 0, 0, 0.1); color: var(--primary-red); }
.stat-card-audit.today .stat-icon-audit { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
.stat-card-audit.users .stat-icon-audit { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
.stat-card-audit.actions .stat-icon-audit { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }

.stat-content-audit { display: flex; flex-direction: column; }
.stat-value-audit { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--text-dark); line-height: 1; }
.stat-label-audit { font-size: 0.75rem; color: #6b7280; margin-top: 4px; }

/* Audit Card */
.audit-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.audit-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    font-weight: 600;
    flex-wrap: wrap;
    gap: 12px;
}

.audit-card-body { padding: 24px; }

.btn-refresh-audit {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    transition: all 0.3s ease;
}

.btn-refresh-audit:hover { background: rgba(255, 255, 255, 0.3); color: white; }

/* Filter Row */
.filter-row-audit {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 14px 16px;
    background: linear-gradient(135deg, #fafafa 0%, #fff 100%);
    border-radius: 10px;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.filter-group-audit { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
.filter-label-audit { font-weight: 600; font-size: 0.85rem; color: var(--primary-red); margin: 0; }

.filter-select-audit {
    padding: 8px 16px;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-size: 0.85rem;
    background: white;
    transition: all 0.3s ease;
    min-width: 140px;
}

.filter-select-audit:focus { border-color: var(--primary-red); outline: none; box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1); }

.btn-clear-filter-audit {
    background: transparent;
    border: 2px solid #e5e7eb;
    color: #6b7280;
    padding: 8px 12px;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.btn-clear-filter-audit:hover { background: #ef4444; border-color: #ef4444; color: white; }

/* Table */
.table-audit thead th {
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 14px 12px;
    border: none;
}

.table-audit tbody td { padding: 12px; vertical-align: middle; border-bottom: 1px solid rgba(0, 0, 0, 0.05); font-size: 0.85rem; }
.table-audit tbody tr:hover { background: rgba(139, 0, 0, 0.03); }

/* Action Badges */
.badge-action { padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; }
.badge-action.login { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); color: white; }
.badge-action.logout { background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%); color: white; }
.badge-action.borrow { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; }
.badge-action.return { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); color: white; }
.badge-action.lost { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; }
.badge-action.user { background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white; }
.badge-action.student { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; }
.badge-action.equipment { background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); color: white; }
.badge-action.unit { background: linear-gradient(135deg, #ec4899 0%, #db2777 100%); color: white; }
.badge-action.default { background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); color: white; }

/* Data Preview */
.data-preview { font-family: monospace; font-size: 0.75rem; color: #6b7280; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.data-preview.old { color: #ef4444; }
.data-preview.new { color: #22c55e; }

/* View Button */
.btn-view-audit {
    padding: 4px 10px;
    border-radius: 6px;
    transition: all 0.3s ease;
    border: 2px solid var(--primary-red);
    color: var(--primary-red);
    background: transparent;
    font-size: 0.75rem;
}

.btn-view-audit:hover { background: var(--primary-red); color: white; }

/* Modal */
.modal-audit { border-radius: 16px; overflow: hidden; border: none; }
.modal-audit .modal-header { background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); color: white; border: none; padding: 20px 24px; }
.modal-audit .modal-body { padding: 24px; }
.modal-audit .modal-footer { border-top: 1px solid rgba(0, 0, 0, 0.05); padding: 16px 24px; }

/* Audit Detail Grid */
.audit-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
}

.audit-detail-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: #fafafa;
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.05);
}

.audit-detail-item.full-width { grid-column: span 2; }

.audit-detail-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1rem;
}

.audit-detail-content { display: flex; flex-direction: column; }
.audit-detail-label { font-size: 0.7rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px; }
.audit-detail-value { font-weight: 600; color: var(--text-dark); }

/* Audit Data Cards */
.audit-data-card {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.1);
}

.audit-data-header {
    padding: 12px 16px;
    font-weight: 600;
    font-size: 0.85rem;
}

.audit-data-card.old .audit-data-header { background: rgba(239, 68, 68, 0.1); color: #dc2626; }
.audit-data-card.new .audit-data-header { background: rgba(34, 197, 94, 0.1); color: #16a34a; }

.audit-data-body {
    padding: 16px;
    background: #fafafa;
    max-height: 200px;
    overflow-y: auto;
}

.audit-data-body pre {
    margin: 0;
    font-size: 0.8rem;
    white-space: pre-wrap;
    word-break: break-all;
    color: var(--text-dark);
}

/* Responsive */
@@media (max-width: 991px) {
    .stat-card-audit { padding: 16px; }
    .stat-value-audit { font-size: 1.25rem; }
}

@@media (max-width: 768px) {
    .filter-row-audit { padding: 12px; }
    .filter-group-audit { width: 100%; }
    .filter-select-audit { flex: 1; min-width: 100px; }
    .audit-detail-grid { grid-template-columns: 1fr; }
    .audit-detail-item.full-width { grid-column: span 1; }
}
</style>


