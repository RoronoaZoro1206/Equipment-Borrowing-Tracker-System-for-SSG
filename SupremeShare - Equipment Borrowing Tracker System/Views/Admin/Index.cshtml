@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<!-- Hero Banner -->
<div class="dashboard-hero">
    <div class="hero-bg" style="background-image: url('/File_Images/admin-MAIN.png');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <div class="hero-logo">
            <img src="~/File_Images/533693089_1177970501030425_4668075712780998242_n.jpg" alt="SSG Logo" />
        </div>
        <div class="hero-text">
            <h1>Supreme Student Government</h1>
            <p>Cebu Technological University - Main Campus</p>
        </div>
    </div>
    <div class="hero-stripe"></div>
</div>

<!-- Dashboard Stats -->
<div class="dashboard-section">
    <div class="section-header">
        <h2 class="section-title"><i class="bi bi-grid-3x3-gap-fill"></i> Dashboard</h2>
    </div>
    
    <div class="row g-3 mb-4">
        <div class="col">
            <div class="status-card borrowed">
                <div class="status-icon"><i class="bi bi-box-arrow-up-right"></i></div>
                <div class="status-label">Borrowed</div>
                <div class="status-value">@(ViewBag.BorrowedCount ?? 0)</div>
            </div>
        </div>
        <div class="col">
            <div class="status-card available">
                <div class="status-icon"><i class="bi bi-check-circle"></i></div>
                <div class="status-label">Available</div>
                <div class="status-value">@(ViewBag.AvailableCount ?? 0)</div>
            </div>
        </div>
        <div class="col">
            <div class="status-card review">
                <div class="status-icon"><i class="bi bi-hourglass-split"></i></div>
                <div class="status-label">For Review</div>
                <div class="status-value">@(ViewBag.ForReviewCount ?? 0)</div>
            </div>
        </div>
        <div class="col">
            <div class="status-card maintenance">
                <div class="status-icon"><i class="bi bi-tools"></i></div>
                <div class="status-label">Maintenance</div>
                <div class="status-value">@(ViewBag.MaintenanceCount ?? 0)</div>
            </div>
        </div>
        <div class="col">
            <div class="status-card lost">
                <div class="status-icon"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="status-label">Lost/Missing</div>
                <div class="status-value">@(ViewBag.LostCount ?? 0)</div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4">
    <!-- Borrowers per College -->
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="bi bi-pie-chart-fill"></i> Borrowers per College</h5>
                <button class="btn-refresh" onclick="refreshChart('collegeChart')">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            <div class="chart-body">
                <canvas id="collegeChart"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Equipment per Category -->
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="bi bi-bar-chart-fill"></i> Equipment per Category</h5>
                <button class="btn-refresh" onclick="refreshChart('categoryChart')">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            <div class="chart-body">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Good vs Damaged -->
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="bi bi-bar-chart-fill"></i> Good vs Damaged Units</h5>
                <button class="btn-refresh" onclick="refreshChart('conditionChart')">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            <div class="chart-body">
                <canvas id="conditionChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row g-4 mt-2">
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="bi bi-graph-up"></i> Monthly Transactions</h5>
            </div>
            <div class="chart-body">
                <canvas id="monthlyChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="bi bi-clock-history"></i> Recent Activity</h5>
            </div>
            <div class="chart-body activity-list">
                <div class="activity-empty">
                    <i class="bi bi-inbox"></i>
                    <p>No recent activity</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // Theme colors
        const themeColors = {
            primary: '#8B0000',
            primaryLight: '#A52A2A',
            gold: '#D4AF37',
            green: '#059669',
            red: '#DC2626',
            blue: '#3B82F6',
            orange: '#F59E0B',
            purple: '#8B5CF6',
            teal: '#14B8A6'
        };

        let collegeChart, categoryChart, conditionChart, monthlyChart;

        $(document).ready(function() {
            loadChartData();
            loadRecentActivity();
            setupSignalR();
        });

        function setupSignalR() {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/dashboard")
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .build();

            connection.on("StatsUpdated", function() {
                loadDashboardStats();
                loadChartData();
            });

            connection.on("NewTransaction", function(data) {
                addActivityItem(data);
                loadDashboardStats();
            });

            // Handle overdue alerts with toast notification
            connection.on("OverdueAlert", function(count) {
                if (count > 0) {
                    Toastify({
                        text: "⚠️ " + count + " item(s) are now overdue!",
                        duration: 5000,
                        gravity: "top",
                        position: "right",
                        style: { background: "linear-gradient(135deg, #ef4444, #dc2626)" }
                    }).showToast();
                }
                loadDashboardStats();
                loadChartData();
            });

            connection.start().catch(err => console.error('SignalR Error:', err));
        }

        function loadDashboardStats() {
            $.get('/Admin/Reports/GetDashboardStats', function(res) {
                if (res.success) {
                    $('.status-card.borrowed .status-value').text(res.data.borrowedCount);
                    $('.status-card.available .status-value').text(res.data.availableCount);
                    $('.status-card.review .status-value').text(res.data.forReviewCount);
                    $('.status-card.maintenance .status-value').text(res.data.maintenanceCount);
                    $('.status-card.lost .status-value').text(res.data.lostCount);
                }
            });
        }

        function loadChartData() {
            $.get('/Admin/Reports/GetChartData', function(res) {
                if (res.success && res.data) {
                    // Handle both camelCase and PascalCase from API
                    const data = res.data;
                    renderCollegeChart(data.collegeData || data.CollegeData || []);
                    renderCategoryChart(data.categoryData || data.CategoryData || []);
                    renderConditionChart(data.conditionData || data.ConditionData || { good: 0, damaged: 0 });
                    renderMonthlyChart(
                        data.monthlyBorrows || data.MonthlyBorrows || [], 
                        data.monthlyReturns || data.MonthlyReturns || []
                    );
                }
            }).fail(function(err) {
                console.error('Failed to load chart data:', err);
            });
        }

        function renderCollegeChart(data) {
            if (collegeChart) collegeChart.destroy();
            const ctx = document.getElementById('collegeChart').getContext('2d');
            // Handle both camelCase and PascalCase
            const labels = data.map(d => d.label || d.Label || 'Unknown');
            const values = data.map(d => d.value ?? d.Value ?? 0);
            const colors = [themeColors.gold, themeColors.teal, themeColors.green, themeColors.primary, themeColors.orange, themeColors.blue, themeColors.purple];

            collegeChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{ data: values, backgroundColor: colors.slice(0, labels.length), borderWidth: 0, hoverOffset: 4 }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false, cutout: '60%',
                    plugins: { legend: { position: 'right', labels: { padding: 15, usePointStyle: true, font: { size: 11 } } } }
                }
            });
        }

        function renderCategoryChart(data) {
            if (categoryChart) categoryChart.destroy();
            const ctx = document.getElementById('categoryChart').getContext('2d');
            // Handle both camelCase and PascalCase
            const labels = data.map(d => d.label || d.Label || 'Unknown');
            const values = data.map(d => d.value ?? d.Value ?? 0);
            categoryChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{ label: 'Units', data: values, backgroundColor: themeColors.teal, borderRadius: 4, barThickness: 20 }]
                },
                options: {
                    indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true, grid: { display: false } }, y: { grid: { display: false } } }
                }
            });
        }

        function renderConditionChart(data) {
            if (conditionChart) conditionChart.destroy();
            const ctx = document.getElementById('conditionChart').getContext('2d');
            // Handle both camelCase and PascalCase
            const goodCount = data.good ?? data.Good ?? 0;
            const damagedCount = data.damaged ?? data.Damaged ?? 0;
            conditionChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Good', 'Damaged'],
                    datasets: [{ label: 'Units', data: [goodCount, damagedCount], backgroundColor: [themeColors.green, themeColors.red], borderRadius: 6, barThickness: 60 }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { grid: { display: false } }, y: { beginAtZero: true, grid: { color: '#f0f0f0' } } }
                }
            });
        }

        function renderMonthlyChart(borrows, returns) {
            if (monthlyChart) monthlyChart.destroy();
            const ctx = document.getElementById('monthlyChart').getContext('2d');
            const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            
            // Map data to months - handle both camelCase and PascalCase
            const borrowData = months.map(m => {
                const found = borrows.find(b => (b.month || b.Month) === m);
                return found ? (found.count ?? found.Count ?? 0) : 0;
            });
            const returnData = months.map(m => {
                const found = returns.find(r => (r.month || r.Month) === m);
                return found ? (found.count ?? found.Count ?? 0) : 0;
            });

            monthlyChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: months,
                    datasets: [
                        { label: 'Borrowed', data: borrowData, borderColor: themeColors.primary, backgroundColor: 'rgba(139, 0, 0, 0.1)', fill: true, tension: 0.4 },
                        { label: 'Returned', data: returnData, borderColor: themeColors.green, backgroundColor: 'rgba(5, 150, 105, 0.1)', fill: true, tension: 0.4 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'top', labels: { usePointStyle: true } } },
                    scales: { x: { grid: { display: false } }, y: { beginAtZero: true, grid: { color: '#f0f0f0' } } }
                }
            });
        }

        function loadRecentActivity() {
            $.get('/Admin/Reports/GetAuditLogs?page=1&pageSize=5', function(res) {
                if (res.success && res.data.length > 0) {
                    let html = '';
                    res.data.forEach(item => {
                        html += `<div class="activity-item">
                            <small class="text-muted">${item.loggedAt}</small>
                            <p class="mb-0">${item.action}</p>
                            <small class="text-muted">by ${item.username || 'System'}</small>
                        </div>`;
                    });
                    $('.activity-list').html(html);
                }
            });
        }

        function addActivityItem(data) {
            const html = `<div class="activity-item new-activity">
                <small class="text-muted">${data.timestamp}</small>
                <p class="mb-0">${data.action}: ${data.transactionCode}</p>
                <small class="text-muted">${data.studentName}</small>
            </div>`;
            $('.activity-list').prepend(html);
            $('.activity-list .activity-item:gt(4)').remove();
            $('.activity-empty').hide();
        }

        function refreshChart(chartId) {
            loadChartData();
        }
    </script>
    <style>
        .activity-item { padding: 10px; border-bottom: 1px solid #eee; }
        .activity-item:last-child { border-bottom: none; }
        .new-activity { background-color: #fffde7; animation: fadeIn 0.5s; }
        @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
}
