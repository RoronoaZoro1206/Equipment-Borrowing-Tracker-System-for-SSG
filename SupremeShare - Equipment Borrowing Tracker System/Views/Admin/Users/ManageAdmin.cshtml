@{
    ViewData["Title"] = "Manage Admin";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-person-badge me-2"></i>Manage Admin</h2>
            <p class="text-muted mb-0">View and manage active admin accounts</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAdminModal">
            <i class="bi bi-plus-lg me-1"></i>Add an Admin
        </button>
    </div>

    <!-- Filter/Sort Controls -->
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-md-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-filter me-2"></i>
                        <select id="sortOrder" class="form-select form-select-sm">
                            <option value="desc">Descending</option>
                            <option value="asc">Ascending</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="sortBy" class="form-select form-select-sm">
                        <option value="date">Date Added</option>
                        <option value="name">Name</option>
                        <option value="position">Position</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Search admins...">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Admin Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="adminsTable" style="width:100%">
                    <thead class="table-dark">
                        <tr>
                            <th>No.</th>
                            <th>Username</th>
                            <th>Full Name</th>
                            <th>Role</th>
                            <th>Position</th>
                            <th>E-mail</th>
                            <th>Contact No.</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Admin Modal -->
<div class="modal fade" id="addAdminModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form id="addAdminForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Role" value="admin">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-person-plus-fill me-2"></i>Add New Admin</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Note:</strong> The admin account will be created in <strong>deactivated</strong> status. 
                        A temporary password will be generated when you activate the account.
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">First Name <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" class="form-control" required placeholder="Enter first name">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Last Name <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" class="form-control" required placeholder="Enter last name">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Middle Name</label>
                            <input type="text" name="MiddleName" class="form-control" placeholder="Optional">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="email" name="Email" class="form-control" required placeholder="admin@example.com">
                            <small class="text-muted">Username will be generated from email</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Position <span class="text-danger">*</span></label>
                            <select name="Position" class="form-select" required>
                                <option value="">-- Select Position --</option>
                                <option value="President">President</option>
                                <option value="Vice President">Vice President</option>
                                <option value="Secretary">Secretary</option>
                                <option value="Treasurer">Treasurer</option>
                                <option value="Auditor">Auditor</option>
                                <option value="P.R.O.">P.R.O.</option>
                                <option value="Business Manager">Business Manager</option>
                                <option value="Councilor">Councilor</option>
                                <option value="SSG Adviser">SSG Adviser</option>
                                <option value="Staff">Staff</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contact Number</label>
                            <input type="text" name="ContactNo" class="form-control" placeholder="09XX XXX XXXX">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Suffix</label>
                            <input type="text" name="Suffix" class="form-control" placeholder="Jr., Sr., III, etc.">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Add Admin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Admin Added Success Modal -->
<div class="modal fade" id="adminAddedModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                </div>
                <h4 class="text-success mb-3">Admin Added Successfully!</h4>
                <p class="text-muted">The admin account has been created and is waiting for activation.</p>
                
                <div class="alert alert-warning text-start">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    A temporary password will be generated when you activate this account.
                </div>
                
                <div class="card bg-light text-start mb-4">
                    <div class="card-body">
                        <p class="mb-2"><i class="bi bi-person me-2"></i><strong>Name:</strong> <span id="addedAdminName"></span></p>
                        <p class="mb-2"><i class="bi bi-briefcase me-2"></i><strong>Position:</strong> <span id="addedAdminPosition"></span></p>
                        <p class="mb-2"><i class="bi bi-envelope me-2"></i><strong>Email:</strong> <span id="addedAdminEmail"></span></p>
                        <p class="mb-0"><i class="bi bi-toggle-off me-2"></i><strong>Status:</strong> <span class="badge bg-warning text-dark">Deactivated (Pending Activation)</span></p>
                        <p class="mb-0 mt-2"><i class="bi bi-key me-2"></i><strong>Password:</strong> <em>Will be generated during activation</em></p>
                    </div>
                </div>
                
                <button type="button" class="btn btn-success btn-lg" data-bs-dismiss="modal">
                    <i class="bi bi-check me-1"></i>OK
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Activation Success Modal (shows temporary password) -->
<div class="modal fade" id="activationSuccessModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                </div>
                <h4 class="text-success mb-3">Admin Activated Successfully!</h4>
                
                <div class="alert alert-danger text-start">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>IMPORTANT:</strong> Save these credentials immediately!
                    <br><small>The password will only be shown once and cannot be recovered.</small>
                </div>
                
                <div class="card border-primary text-start mb-4">
                    <div class="card-body">
                        <p class="mb-2"><i class="bi bi-envelope me-2"></i><strong>Email:</strong> <span id="activatedEmail"></span></p>
                        <p class="mb-3">
                            <i class="bi bi-key me-2"></i><strong>Temporary Password:</strong> 
                            <code id="temporaryPassword" class="bg-danger text-white px-2 py-1 rounded fs-5"></code>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="copyPassword()">
                                <i class="bi bi-clipboard"></i> Copy
                            </button>
                        </p>
                        <hr>
                        <p class="mb-0"><i class="bi bi-check-circle text-success me-2"></i><strong>Status:</strong> <span class="badge bg-success">Active - Ready to Login</span></p>
                    </div>
                </div>
                
                <div class="alert alert-info text-start">
                    <i class="bi bi-lightbulb me-2"></i>
                    <strong>Note:</strong> The admin should change this password after first login.
                </div>
                
                <button type="button" class="btn btn-primary btn-lg" data-bs-dismiss="modal" id="btnSavedPassword">
                    <i class="bi bi-check-lg me-1"></i>I HAVE SAVED THE PASSWORD
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Deactivation Confirmation Modal -->
<div class="modal fade" id="deactivateConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Deactivation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-person-x text-danger" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Are you sure you want to deactivate this admin?</h5>
                <p class="text-muted mb-0">
                    <strong id="deactivateAdminName"></strong> will no longer be able to log in.
                </p>
                <p class="text-muted">They will be moved to the Deactivated Admin list.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-danger" id="confirmDeactivateBtn">
                    <i class="bi bi-person-x me-1"></i>Deactivate
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let adminsTable;
let pendingDeactivateId = null;

$(document).ready(function() {
    // Initialize DataTable
    adminsTable = DataTableConfig.init('#adminsTable', {
        ajax: {
            url: '/Admin/Users/GetActiveAdmins',
            dataSrc: json => json.success ? json.data : []
        },
        columns: [
            { 
                data: null,
                render: (data, type, row, meta) => meta.row + 1
            },
            { data: 'userUsername', render: data => `<strong>${data}</strong>` },
            { data: 'fullName' },
            { 
                data: 'userRole',
                render: data => `<span class="badge bg-danger">Admin</span>`
            },
            { data: 'userPosition' },
            { data: 'userEmail', defaultContent: '<span class="text-muted">-</span>' },
            { data: 'userContactNo', defaultContent: '<span class="text-muted">-</span>' },
            {
                data: 'userId',
                orderable: false,
                render: function(data, type, row) {
                    return `
                        <button class="btn btn-sm btn-danger btn-deactivate" 
                                data-id="${data}" 
                                data-name="${row.fullName}"
                                title="Deactivate Admin">
                            <i class="bi bi-person-x me-1"></i>Deactivate
                        </button>`;
                }
            }
        ],
        order: [[0, 'asc']]
    });

    // Custom search
    $('#searchInput').on('keyup', function() {
        adminsTable.search(this.value).draw();
    });

    // Add Admin Form Submit
    $('#addAdminForm').submit(async function(e) {
        e.preventDefault();
        const btn = this.querySelector('button[type="submit"]');
        Loading.button(btn, true);
        
        try {
            const res = await $.post('/Admin/Users/AddAdmin', $(this).serialize());
            Loading.button(btn, false);
            
            if (res.success) {
                bootstrap.Modal.getInstance('#addAdminModal').hide();
                this.reset();
                
                // Show success modal with details
                $('#addedAdminName').text(res.data.fullName);
                $('#addedAdminPosition').text(res.data.position);
                $('#addedAdminEmail').text(res.data.email);
                new bootstrap.Modal('#adminAddedModal').show();
                
                // Refresh table (won't show new admin since they're inactive)
                adminsTable.ajax.reload(null, false);
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.button(btn, false);
            Toast.error('Failed to add admin');
        }
    });

    // Deactivate Admin Click
    $('#adminsTable').on('click', '.btn-deactivate', function() {
        pendingDeactivateId = $(this).data('id');
        const name = $(this).data('name');
        $('#deactivateAdminName').text(name);
        new bootstrap.Modal('#deactivateConfirmModal').show();
    });

    // Confirm Deactivate
    $('#confirmDeactivateBtn').click(async function() {
        if (!pendingDeactivateId) return;
        
        const btn = this;
        Loading.button(btn, true);
        
        try {
            const res = await $.post('/Admin/Users/DeactivateAdmin', { 
                userId: pendingDeactivateId, 
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
            });
            Loading.button(btn, false);
            
            if (res.success) {
                bootstrap.Modal.getInstance('#deactivateConfirmModal').hide();
                Toast.success(res.message);
                adminsTable.ajax.reload(null, false);
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.button(btn, false);
            Toast.error('Failed to deactivate admin');
        }
        
        pendingDeactivateId = null;
    });
});

function copyPassword() {
    const password = document.getElementById('temporaryPassword').textContent;
    navigator.clipboard.writeText(password).then(() => {
        Toast.success('Password copied to clipboard!');
    });
}
</script>
}
