@{
    ViewData["Title"] = "Deactivated Admin/s";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-person-x me-2"></i>Deactivated Admin/s</h2>
            <p class="text-muted mb-0">View and reactivate deactivated admin accounts</p>
        </div>
        <a href="/Admin/Users/ManageAdmin" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i>Back to Active Admins
        </a>
    </div>

    <!-- Info Alert -->
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>
        <strong>Note:</strong> Only admin accounts with <strong>inactive status</strong> are shown here. 
        Once you click <strong>Activate</strong>, a temporary password will be generated and the admin will be able to log in again.
    </div>

    <!-- Filter/Sort Controls -->
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-md-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-filter me-2"></i>
                        <select id="sortOrder" class="form-select form-select-sm">
                            <option value="desc">Descending</option>
                            <option value="asc">Ascending</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="sortBy" class="form-select form-select-sm">
                        <option value="date">Date Added</option>
                        <option value="name">Name</option>
                        <option value="position">Position</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Search deactivated admins...">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Deactivated Admin Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="deactivatedAdminsTable" style="width:100%">
                    <thead class="table-dark">
                        <tr>
                            <th>No.</th>
                            <th>Username</th>
                            <th>Full Name</th>
                            <th>Role</th>
                            <th>Position</th>
                            <th>E-mail</th>
                            <th>Contact No.</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Activation Confirmation Modal -->
<div class="modal fade" id="activateConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-person-check me-2"></i>Confirm Activation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-person-check text-success" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Are you sure you want to activate this admin?</h5>
                <p class="text-muted mb-0">
                    <strong id="activateAdminName"></strong> will be able to log in again.
                </p>
                <div class="alert alert-warning mt-3 text-start">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Important:</strong> A new temporary password will be generated. Make sure to save it!
                </div>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-success" id="confirmActivateBtn">
                    <i class="bi bi-person-check me-1"></i>Activate
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Activation Success Modal (shows temporary password) - Maroon Theme -->
<div class="modal fade" id="activationSuccessModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: none; box-shadow: 0 20px 60px rgba(139, 0, 0, 0.15);">
            <div class="modal-body text-center py-5 px-4">
                <div class="mb-4">
                    <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #8B0000 0%, #5c0000 100%); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-check-lg text-white" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <h4 style="color: #8B0000; font-family: 'Playfair Display', serif; font-weight: 700;" class="mb-3">Admin Activated Successfully!</h4>
                
                <div class="text-start mb-4 p-3" style="background: rgba(139, 0, 0, 0.08); border-left: 4px solid #8B0000; border-radius: 8px;">
                    <i class="bi bi-exclamation-triangle-fill me-2" style="color: #8B0000;"></i>
                    <strong style="color: #8B0000;">IMPORTANT:</strong> <span style="color: #374151;">Save these credentials immediately!</span>
                    <br><small class="text-muted">The password will only be shown once and cannot be recovered.</small>
                </div>
                
                <div class="text-start mb-4 p-3" style="background: #fafafa; border: 1px solid rgba(139, 0, 0, 0.15); border-radius: 12px;">
                    <p class="mb-2"><i class="bi bi-envelope me-2" style="color: #8B0000;"></i><strong>Email:</strong> <span id="activatedEmail"></span></p>
                    <p class="mb-3">
                        <i class="bi bi-key me-2" style="color: #8B0000;"></i><strong>Temporary Password:</strong> 
                        <code id="temporaryPassword" style="background: linear-gradient(135deg, #8B0000 0%, #5c0000 100%); color: white; padding: 4px 12px; border-radius: 6px; font-size: 1rem;"></code>
                        <button type="button" class="btn btn-sm ms-2" style="border: 2px solid #8B0000; color: #8B0000; border-radius: 6px;" onclick="copyPassword()">
                            <i class="bi bi-clipboard"></i> Copy
                        </button>
                    </p>
                    <hr style="border-color: rgba(139, 0, 0, 0.1);">
                    <p class="mb-0"><i class="bi bi-check-circle me-2" style="color: #8B0000;"></i><strong>Status:</strong> <span class="badge" style="background: linear-gradient(135deg, #8B0000 0%, #5c0000 100%);">Active - Ready to Login</span></p>
                </div>
                
                <div class="text-start mb-4 p-3" style="background: rgba(139, 0, 0, 0.05); border-radius: 8px;">
                    <i class="bi bi-lightbulb me-2" style="color: #8B0000;"></i>
                    <strong>Note:</strong> <span class="text-muted">The admin should change this password after first login.</span>
                </div>
                
                <button type="button" class="btn btn-lg" style="background: linear-gradient(135deg, #8B0000 0%, #5c0000 100%); color: white; border: none; border-radius: 10px; padding: 12px 32px; font-weight: 600; box-shadow: 0 4px 15px rgba(139, 0, 0, 0.3);" data-bs-dismiss="modal" id="btnSavedPassword">
                    <i class="bi bi-check-lg me-1"></i>I HAVE SAVED THE PASSWORD
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let deactivatedAdminsTable;
let pendingActivateId = null;

$(document).ready(function() {
    // Initialize DataTable
    deactivatedAdminsTable = DataTableConfig.init('#deactivatedAdminsTable', {
        ajax: {
            url: '/Admin/Users/GetInactiveAdmins',
            dataSrc: json => json.success ? json.data : []
        },
        columns: [
            { 
                data: null,
                render: (data, type, row, meta) => meta.row + 1
            },
            { data: 'userUsername', render: data => `<strong>${data}</strong>` },
            { data: 'fullName' },
            { 
                data: 'userRole',
                render: data => `<span class="badge bg-secondary">Admin</span>`
            },
            { data: 'userPosition' },
            { data: 'userEmail', defaultContent: '<span class="text-muted">-</span>' },
            { data: 'userContactNo', defaultContent: '<span class="text-muted">-</span>' },
            {
                data: 'userId',
                orderable: false,
                render: function(data, type, row) {
                    return `
                        <button class="btn btn-sm btn-success btn-activate" 
                                data-id="${data}" 
                                data-name="${row.fullName}"
                                data-email="${row.userEmail || ''}"
                                title="Activate Admin">
                            <i class="bi bi-person-check me-1"></i>Activate
                        </button>`;
                }
            }
        ],
        order: [[0, 'asc']],
        language: {
            emptyTable: "No deactivated admins found"
        }
    });

    // Custom search
    $('#searchInput').on('keyup', function() {
        deactivatedAdminsTable.search(this.value).draw();
    });

    // Activate Admin Click
    $('#deactivatedAdminsTable').on('click', '.btn-activate', function() {
        pendingActivateId = $(this).data('id');
        const name = $(this).data('name');
        $('#activateAdminName').text(name);
        new bootstrap.Modal('#activateConfirmModal').show();
    });

    // Confirm Activate
    $('#confirmActivateBtn').click(async function() {
        if (!pendingActivateId) return;
        
        const btn = this;
        Loading.button(btn, true);
        
        try {
            const res = await $.post('/Admin/Users/ActivateAdmin', { 
                userId: pendingActivateId, 
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
            });
            Loading.button(btn, false);
            
            if (res.success) {
                bootstrap.Modal.getInstance('#activateConfirmModal').hide();
                
                // Show activation success modal with credentials
                $('#activatedEmail').text(res.data.email);
                $('#temporaryPassword').text(res.data.temporaryPassword);
                new bootstrap.Modal('#activationSuccessModal').show();
                
                // Refresh table (admin will be removed since they're now active)
                deactivatedAdminsTable.ajax.reload(null, false);
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.button(btn, false);
            Toast.error('Failed to activate admin');
        }
        
        pendingActivateId = null;
    });
});

function copyPassword() {
    const password = document.getElementById('temporaryPassword').textContent;
    navigator.clipboard.writeText(password).then(() => {
        Toast.success('Password copied to clipboard!');
    });
}
</script>
@Html.AntiForgeryToken()
}
