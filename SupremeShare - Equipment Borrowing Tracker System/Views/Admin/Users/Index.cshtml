@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill me-2"></i>User Management</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
            <i class="bi bi-plus-lg me-1"></i>Add User
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover" id="usersTable" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>Username</th>
                        <th>Full Name</th>
                        <th>Role</th>
                        <th>Position</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="createUserForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus"></i> Add New User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Username <span class="text-danger">*</span></label>
                            <input type="text" name="Username" class="form-control" required placeholder="Enter username">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Password <span class="text-danger">*</span></label>
                            <input type="password" name="Password" class="form-control" required minlength="8" placeholder="Min. 8 characters">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">First Name <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" class="form-control" required placeholder="Enter first name">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Name <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" class="form-control" required placeholder="Enter last name">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Role</label>
                            <select name="Role" class="form-select">
                                <option value="support_admin">Support Admin</option>
                                <option value="admin">Admin</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Position</label>
                            <input type="text" name="Position" class="form-control" value="Support Staff" placeholder="e.g., Support Staff">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" class="form-control" placeholder="user@example.com">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contact No</label>
                            <input type="text" name="ContactNo" class="form-control" placeholder="09XX XXX XXXX">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editUserForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="UserId" id="editUserId">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"><i class="bi bi-pencil-square"></i> Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Username</label>
                            <input type="text" name="Username" id="editUsername" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Role</label>
                            <select name="Role" id="editRole" class="form-select">
                                <option value="support_admin">Support Admin</option>
                                <option value="admin">Admin</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">First Name</label>
                            <input type="text" name="FirstName" id="editFirstName" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Name</label>
                            <input type="text" name="LastName" id="editLastName" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Position</label>
                            <input type="text" name="Position" id="editPosition" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" id="editEmail" class="form-control">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Contact No</label>
                            <input type="text" name="ContactNo" id="editContactNo" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <form id="resetPasswordForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="resetUserId">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"><i class="bi bi-key"></i> Reset Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">New Password <span class="text-danger">*</span></label>
                    <input type="password" name="newPassword" class="form-control" required minlength="8" placeholder="Min. 8 characters">
                    <small class="text-muted">Password must be at least 8 characters long.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-arrow-repeat me-1"></i>Reset
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
let usersTable;

$(document).ready(function() {
    // Initialize DataTable with DataTableConfig helper
    usersTable = DataTableConfig.init('#usersTable', {
        ajax: {
            url: '/Admin/Users/GetAll',
            dataSrc: json => json.success ? json.data : []
        },
        columns: [
            { data: 'userUsername', render: data => `<strong>${data}</strong>` },
            { data: 'fullName' },
            { 
                data: 'userRole',
                render: data => `<span class="badge ${data === 'admin' ? 'bg-danger' : 'bg-info'}">${data}</span>`
            },
            { data: 'userPosition' },
            { data: 'userEmail', defaultContent: '<span class="text-muted">-</span>' },
            { 
                data: 'userStatus',
                render: data => `<span class="status-badge ${data ? 'available' : 'overdue'}">${data ? 'Active' : 'Inactive'}</span>`
            },
            { data: 'userDateCreated' },
            {
                data: 'userId',
                orderable: false,
                render: function(data, type, row) {
                    return `
                        <div class="btn-action-group">
                            <button class="btn btn-sm btn-outline-primary btn-action btn-edit" data-id="${data}" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-warning btn-action btn-reset-password" data-id="${data}" title="Reset Password">
                                <i class="bi bi-key"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-${row.userStatus ? 'secondary' : 'success'} btn-action btn-toggle" 
                                    data-id="${data}" data-name="${row.fullName}" data-status="${row.userStatus}"
                                    title="${row.userStatus ? 'Deactivate' : 'Activate'}">
                                <i class="bi bi-${row.userStatus ? 'pause' : 'play'}"></i>
                            </button>
                        </div>`;
                }
            }
        ],
        order: [[6, 'desc']]
    });

    // Edit user
    $('#usersTable').on('click', '.btn-edit', async function() {
        const id = $(this).data('id');
        Loading.show('Loading user data...');
        
        try {
            const res = await Api.get(`/Admin/Users/Get/${id}`);
            Loading.hide();
            
            if (res.success) {
                const u = res.data;
                $('#editUserId').val(u.userId);
                $('#editUsername').val(u.userUsername);
                $('#editRole').val(u.userRole);
                $('#editFirstName').val(u.userFirstName);
                $('#editLastName').val(u.userLastName);
                $('#editPosition').val(u.userPosition);
                $('#editEmail').val(u.userEmail);
                $('#editContactNo').val(u.userContactNo);
                new bootstrap.Modal('#editUserModal').show();
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.hide();
            Toast.error('Failed to load user data');
        }
    });

    // Reset password
    $('#usersTable').on('click', '.btn-reset-password', function() {
        $('#resetUserId').val($(this).data('id'));
        new bootstrap.Modal('#resetPasswordModal').show();
    });

    // Toggle status with SweetAlert2
    $('#usersTable').on('click', '.btn-toggle', async function() {
        const id = $(this).data('id');
        const name = $(this).data('name');
        const isActive = $(this).data('status');
        
        const action = isActive ? 'deactivate' : 'activate';
        const confirmed = await Confirm.action(
            `${isActive ? 'Deactivate' : 'Activate'} User`,
            `Are you sure you want to ${action} <strong>${name}</strong>?`,
            `<i class="bi bi-${isActive ? 'pause' : 'play'} me-1"></i>${isActive ? 'Deactivate' : 'Activate'}`,
            'question'
        );
        
        if (!confirmed) return;
        
        Loading.show('Updating status...');
        
        try {
            const res = await $.post('/Admin/Users/ToggleStatus', { 
                userId: id, 
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
            });
            Loading.hide();
            
            if (res.success) {
                Toast.success(`User ${action}d successfully`);
                usersTable.ajax.reload(null, false);
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.hide();
            Toast.error('Failed to update status');
        }
    });

    // Form submissions with Toast notifications
    $('#createUserForm').submit(async function(e) {
        e.preventDefault();
        const btn = this.querySelector('button[type="submit"]');
        Loading.button(btn, true);
        
        try {
            const res = await $.post('/Admin/Users/Create', $(this).serialize());
            Loading.button(btn, false);
            
            if (res.success) {
                bootstrap.Modal.getInstance('#createUserModal').hide();
                this.reset();
                usersTable.ajax.reload();
                Toast.success('User created successfully');
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.button(btn, false);
            Toast.error('Failed to create user');
        }
    });

    $('#editUserForm').submit(async function(e) {
        e.preventDefault();
        const btn = this.querySelector('button[type="submit"]');
        Loading.button(btn, true);
        
        try {
            const res = await $.post('/Admin/Users/Update', $(this).serialize());
            Loading.button(btn, false);
            
            if (res.success) {
                bootstrap.Modal.getInstance('#editUserModal').hide();
                usersTable.ajax.reload(null, false);
                Toast.success('User updated successfully');
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.button(btn, false);
            Toast.error('Failed to update user');
        }
    });

    $('#resetPasswordForm').submit(async function(e) {
        e.preventDefault();
        const btn = this.querySelector('button[type="submit"]');
        Loading.button(btn, true);
        
        try {
            const res = await $.post('/Admin/Users/ResetPassword', $(this).serialize());
            Loading.button(btn, false);
            
            if (res.success) {
                bootstrap.Modal.getInstance('#resetPasswordModal').hide();
                this.reset();
                Toast.success('Password reset successfully');
            } else {
                Toast.error(res.message);
            }
        } catch (error) {
            Loading.button(btn, false);
            Toast.error('Failed to reset password');
        }
    });
});
</script>
}
