function updateStats(data) {
    var total = data.length;
    var active = data.filter(function(u) { return u.userStatus; }).length;
    var admins = data.filter(function(u) { return u.userRole === 'admin'; }).length;
    var support = data.filter(function(u) { return u.userRole === 'support_admin'; }).length;
    
    $('#statTotal').text(total);
    $('#statActive').text(active);
    $('#statAdmins').text(admins);
    $('#statSupport').text(support);
}

function setupFilterHandlers() {
    $('#filterRole').on('change', function() {
        var val = $(this).val();
        usersTable.column(2).search(val ? val : '', false, false).draw();
    });
    
    $('#filterStatus').on('change', function() {
        var val = $(this).val();
        usersTable.column(5).search(val ? val : '', false, false).draw();
    });
    
    $('#btnClearFilters').on('click', function() {
        $('#filterRole, #filterStatus').val('');
        usersTable.search('').columns().search('').draw();
        showToast('Filters cleared', 'info');
    });
}

