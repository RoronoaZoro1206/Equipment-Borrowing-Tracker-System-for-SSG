@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="page-icon-user">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h2 class="page-title mb-0">User Management</h2>
                <p class="text-muted mb-0 small">Manage system users and access control</p>
            </div>
        </div>
        <button class="btn btn-add-user" data-bs-toggle="modal" data-bs-target="#createUserModal">
            <i class="bi bi-plus-lg me-1"></i>Add User
        </button>
    </div>

    <!-- Info Alert about new pages -->
    <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <strong>Tip:</strong> Use the <strong>Users</strong> submenu on the left sidebar for role-specific management:
        <ul class="mb-0 mt-2">
            <li><strong>Manage Admin</strong> - Add and manage admin accounts</li>
            <li><strong>Manage Support Admin</strong> - Add and manage support admin accounts</li>
            <li><strong>Deactivated Admin/Support Admin</strong> - Reactivate inactive accounts (with password generation)</li>
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card-user total">
                <div class="stat-icon-user"><i class="bi bi-people-fill"></i></div>
                <div class="stat-content-user">
                    <span class="stat-value-user" id="statTotal">-</span>
                    <span class="stat-label-user">Total Users</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card-user active">
                <div class="stat-icon-user"><i class="bi bi-person-check-fill"></i></div>
                <div class="stat-content-user">
                    <span class="stat-value-user" id="statActive">-</span>
                    <span class="stat-label-user">Active</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card-user admins">
                <div class="stat-icon-user"><i class="bi bi-shield-fill-check"></i></div>
                <div class="stat-content-user">
                    <span class="stat-value-user" id="statAdmins">-</span>
                    <span class="stat-label-user">Admins</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card-user support">
                <div class="stat-icon-user"><i class="bi bi-headset"></i></div>
                <div class="stat-content-user">
                    <span class="stat-value-user" id="statSupport">-</span>
                    <span class="stat-label-user">Support Admin</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="user-card">
        <div class="user-card-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-list-ul"></i>
                <span>User Accounts</span>
            </div>
            <button class="btn btn-refresh-user" onclick="refreshData()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
        <div class="user-card-body">
            <!-- Filter Row -->
            <div class="filter-row-user mb-3">
                <div class="filter-group-user">
                    <label class="filter-label-user"><i class="bi bi-funnel me-1"></i>Filters:</label>
                    <select id="filterRole" class="filter-select-user">
                        <option value="">All Roles</option>
                        <option value="admin">Admin</option>
                        <option value="support_admin">Support Admin</option>
                    </select>
                    <select id="filterStatus" class="filter-select-user">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                    <button class="btn btn-clear-filter-user" id="btnClearFilters" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-user mb-0" id="usersTable">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Full Name</th>
                            <th>Role</th>
                            <th>Position</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="spinner-border text-danger" role="status"></div>
                                <p class="text-muted mt-2 mb-0">Loading users...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-user">
            <form id="createUserForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Add New User</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-user">Username <span class="text-danger">*</span></label>
                            <input type="text" name="Username" class="form-control-user" required placeholder="Enter username">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">Password <span class="text-danger">*</span></label>
                            <input type="password" name="Password" class="form-control-user" required minlength="8" placeholder="Min. 8 characters">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">First Name <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" class="form-control-user" required placeholder="Enter first name">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">Last Name <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" class="form-control-user" required placeholder="Enter last name">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">Role <span class="text-danger">*</span></label>
                            <select name="Role" class="form-select-user">
                                <option value="support_admin">Support Admin</option>
                                <option value="admin">Admin</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">Position</label>
                            <input type="text" name="Position" class="form-control-user" value="Support Staff" placeholder="e.g., Support Staff">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">Email</label>
                            <input type="email" name="Email" class="form-control-user" placeholder="user@example.com">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">Contact No</label>
                            <input type="text" name="ContactNo" class="form-control-user" placeholder="09XX-XXX-XXXX">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-submit-user" id="createBtn">
                        <i class="bi bi-plus-circle me-1"></i>Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-user">
            <form id="editUserForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="UserId" id="editUserId">
                <div class="modal-header header-warning">
                    <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-user">Username</label>
                            <input type="text" name="Username" id="editUsername" class="form-control-user">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">Role</label>
                            <select name="Role" id="editRole" class="form-select-user">
                                <option value="support_admin">Support Admin</option>
                                <option value="admin">Admin</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">First Name</label>
                            <input type="text" name="FirstName" id="editFirstName" class="form-control-user">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">Last Name</label>
                            <input type="text" name="LastName" id="editLastName" class="form-control-user">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">Position</label>
                            <input type="text" name="Position" id="editPosition" class="form-control-user">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-user">Email</label>
                            <input type="email" name="Email" id="editEmail" class="form-control-user">
                        </div>
                        <div class="col-12">
                            <label class="form-label-user">Contact No</label>
                            <input type="text" name="ContactNo" id="editContactNo" class="form-control-user">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning" id="editBtn">
                        <i class="bi bi-check-circle me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-user">
            <form id="resetPasswordForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="resetUserId">
                <div class="modal-header header-warning">
                    <h5 class="modal-title"><i class="bi bi-key me-2"></i>Reset Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="reset-password-info mb-3">
                        <i class="bi bi-info-circle text-warning me-2"></i>
                        <span>Enter a new password for this user. Password must be at least 8 characters.</span>
                    </div>
                    <label class="form-label-user">New Password <span class="text-danger">*</span></label>
                    <input type="password" name="newPassword" class="form-control-user" required minlength="8" placeholder="Enter new password">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning" id="resetBtn">
                        <i class="bi bi-arrow-repeat me-1"></i>Reset Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<style>
/* ===========================================
   User Management - Red & White Theme
   =========================================== */

/* Page Icon */
.page-icon-user {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
    box-shadow: 0 8px 24px rgba(139, 0, 0, 0.25);
}

/* Add Button */
.btn-add-user {
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(139, 0, 0, 0.25);
}

.btn-add-user:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(139, 0, 0, 0.35);
    color: white;
}

/* Stat Cards */
.stat-card-user {
    background: white;
    border-radius: 16px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.stat-card-user::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
}

.stat-card-user.total::before { background: var(--primary-red); }
.stat-card-user.active::before { background: #22c55e; }
.stat-card-user.admins::before { background: #ef4444; }
.stat-card-user.support::before { background: #3b82f6; }

.stat-card-user:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

.stat-icon-user {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
}

.stat-card-user.total .stat-icon-user { background: rgba(139, 0, 0, 0.1); color: var(--primary-red); }
.stat-card-user.active .stat-icon-user { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
.stat-card-user.admins .stat-icon-user { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
.stat-card-user.support .stat-icon-user { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }

.stat-content-user { display: flex; flex-direction: column; }
.stat-value-user { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--text-dark); line-height: 1; }
.stat-label-user { font-size: 0.75rem; color: #6b7280; margin-top: 4px; }

/* User Card */
.user-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.user-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    font-weight: 600;
}

.user-card-body { padding: 24px; }

.btn-refresh-user {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    transition: all 0.3s ease;
}

.btn-refresh-user:hover { background: rgba(255, 255, 255, 0.3); color: white; }

/* Filter Row */
.filter-row-user {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 14px 16px;
    background: linear-gradient(135deg, #fafafa 0%, #fff 100%);
    border-radius: 10px;
    border: 1px solid rgba(139, 0, 0, 0.08);
}

.filter-group-user { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
.filter-label-user { font-weight: 600; font-size: 0.85rem; color: var(--primary-red); margin: 0; }

.filter-select-user {
    padding: 8px 16px;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-size: 0.85rem;
    background: white;
    transition: all 0.3s ease;
    min-width: 140px;
}

.filter-select-user:focus { border-color: var(--primary-red); outline: none; box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1); }

.btn-clear-filter-user {
    background: transparent;
    border: 2px solid #e5e7eb;
    color: #6b7280;
    padding: 8px 12px;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.btn-clear-filter-user:hover { background: #ef4444; border-color: #ef4444; color: white; }

/* Table */
.table-user thead th {
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 14px 12px;
    border: none;
}

.table-user tbody td { padding: 14px 12px; vertical-align: middle; border-bottom: 1px solid rgba(0, 0, 0, 0.05); }
.table-user tbody tr:hover { background: rgba(139, 0, 0, 0.03); }

/* Role Badges */
.badge-role { padding: 4px 12px; border-radius: 6px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; }
.badge-role.admin { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; }
.badge-role.support_admin { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; }

/* Status Badges */
.badge-status-user { padding: 4px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; }
.badge-status-user.active { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); color: white; }
.badge-status-user.inactive { background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%); color: white; }

/* Action Buttons */
.btn-action-user {
    width: 32px;
    height: 32px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: all 0.3s ease;
    border-width: 2px;
}

.btn-action-user:hover { transform: scale(1.1); }

.btn-action-user i { font-size: 0.85rem; }

.btn-action-user.btn-outline-warning { color: #f59e0b; border-color: #f59e0b; }
.btn-action-user.btn-outline-warning:hover { background: #f59e0b; color: white; border-color: #f59e0b; }

.btn-action-user.btn-outline-info { color: #06b6d4; border-color: #06b6d4; }
.btn-action-user.btn-outline-info:hover { background: #06b6d4; color: white; border-color: #06b6d4; }

.btn-action-user.btn-outline-secondary { color: #6b7280; border-color: #6b7280; }
.btn-action-user.btn-outline-secondary:hover { background: #6b7280; color: white; border-color: #6b7280; }

.btn-action-user.btn-outline-success { color: #22c55e; border-color: #22c55e; }
.btn-action-user.btn-outline-success:hover { background: #22c55e; color: white; border-color: #22c55e; }

/* Modal */
.modal-user { border-radius: 16px; overflow: hidden; border: none; }
.modal-user .modal-header { background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%); color: white; border: none; padding: 20px 24px; }
.modal-user .modal-header.header-warning { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
.modal-user .modal-body { padding: 24px; }
.modal-user .modal-footer { border-top: 1px solid rgba(0, 0, 0, 0.05); padding: 16px 24px; }

/* Form Controls */
.form-label-user { font-weight: 600; font-size: 0.85rem; color: var(--text-dark); margin-bottom: 8px; display: block; }

.form-control-user,
.form-select-user {
    width: 100%;
    padding: 10px 14px;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.form-control-user:focus,
.form-select-user:focus { border-color: var(--primary-red); outline: none; box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1); }

.btn-submit-user {
    background: linear-gradient(135deg, var(--primary-red) 0%, #5c0000 100%);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
}

.btn-submit-user:hover { color: white; box-shadow: 0 4px 12px rgba(139, 0, 0, 0.3); }

/* Reset Password Info */
.reset-password-info {
    padding: 12px 16px;
    background: rgba(245, 158, 11, 0.1);
    border-radius: 8px;
    font-size: 0.85rem;
    color: #92400e;
}

/* Responsive */
@@media (max-width: 991px) {
    .stat-card-user { padding: 16px; }
    .stat-value-user { font-size: 1.25rem; }
}

@@media (max-width: 768px) {
    .filter-row-user { padding: 12px; }
    .filter-group-user { width: 100%; }
    .filter-select-user { flex: 1; min-width: 100px; }
}
</style>

@section Scripts {
<script>
let usersTable;
let allUsersData = [];

$(document).ready(function() {
    loadUsers();
    setupFilterHandlers();
});

function loadUsers() {
    $.get('/Admin/Users/GetAll', function(res) {
        if (res.success) {
            allUsersData = res.data;
            updateStats(res.data);
            renderTable(res.data);
        }
    });
}

function updateStats(data) {
    $('#statTotal').text(data.length);
    $('#statActive').text(data.filter(u => u.userStatus).length);
    $('#statAdmins').text(data.filter(u => u.userRole === 'admin').length);
    $('#statSupport').text(data.filter(u => u.userRole === 'support_admin').length);
}

function renderTable(data) {
    const tbody = $('#usersTable tbody');
    tbody.empty();
    
    if (data.length === 0) {
        tbody.html('<tr><td colspan="8" class="text-center py-4 text-muted">No users found</td></tr>');
        return;
    }
    
    data.forEach(function(u) {
        const statusClass = u.userStatus ? 'active' : 'inactive';
        const statusText = u.userStatus ? 'Active' : 'Inactive';
        const roleClass = u.userRole.replace('_', '-');
        const roleName = u.userRole === 'admin' ? 'Admin' : 'Support Admin';
        
        tbody.append(`
            <tr>
                <td><strong>${u.userUsername}</strong></td>
                <td>${u.fullName || '-'}</td>
                <td><span class="badge-role ${roleClass}">${roleName}</span></td>
                <td>${u.userPosition || '-'}</td>
                <td>${u.userEmail || '-'}</td>
                <td><span class="badge-status-user ${statusClass}">${statusText}</span></td>
                <td><small>${new Date(u.userDateCreated).toLocaleDateString()}</small></td>
                <td>
                    <div class="d-flex gap-1">
                        <button class="btn btn-action-user btn-outline-warning" onclick="editUser(${u.userId})" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-action-user btn-outline-info" onclick="resetPassword(${u.userId})" title="Reset Password">
                            <i class="bi bi-key"></i>
                        </button>
                        ${u.userStatus ? 
                            `<button class="btn btn-action-user btn-outline-secondary" onclick="toggleStatus(${u.userId}, false)" title="Deactivate">
                                <i class="bi bi-toggle-on"></i>
                            </button>` :
                            `<button class="btn btn-action-user btn-outline-success" onclick="toggleStatus(${u.userId}, true)" title="Activate">
                                <i class="bi bi-toggle-off"></i>
                            </button>`
                        }
                    </div>
                </td>
            </tr>
        `);
    });
}

function setupFilterHandlers() {
    $('#filterRole, #filterStatus').change(applyFilters);
    $('#btnClearFilters').click(function() {
        $('#filterRole, #filterStatus').val('');
        applyFilters();
    });
}

function applyFilters() {
    let filtered = [...allUsersData];
    
    const role = $('#filterRole').val();
    const status = $('#filterStatus').val();
    
    if (role) filtered = filtered.filter(u => u.userRole === role);
    if (status) filtered = filtered.filter(u => (status === 'Active') === u.userStatus);
    
    renderTable(filtered);
}

function refreshData() {
    loadUsers();
    Toast.info('Data refreshed');
}

function editUser(userId) {
    const user = allUsersData.find(u => u.userId === userId);
    if (!user) return;
    
    $('#editUserId').val(user.userId);
    $('#editUsername').val(user.userUsername);
    $('#editRole').val(user.userRole);
    $('#editFirstName').val(user.userFirstName);
    $('#editLastName').val(user.userLastName);
    $('#editPosition').val(user.userPosition);
    $('#editEmail').val(user.userEmail);
    $('#editContactNo').val(user.userContactNo);
    
    new bootstrap.Modal('#editUserModal').show();
}

function resetPassword(userId) {
    $('#resetUserId').val(userId);
    new bootstrap.Modal('#resetPasswordModal').show();
}

async function toggleStatus(userId, activate) {
    const action = activate ? 'activate' : 'deactivate';
    const confirmed = await Confirm.action(
        `${activate ? 'Activate' : 'Deactivate'} User`,
        `Are you sure you want to ${action} this user?`,
        activate ? 'Activate' : 'Deactivate'
    );
    
    if (!confirmed) return;
    
    $.post(`/Admin/Users/${activate ? 'Activate' : 'Deactivate'}`, { userId: userId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function(res) {
        if (res.success) {
            Toast.success(res.message);
            loadUsers();
        } else {
            Toast.error(res.message);
        }
    });
}

// Form submissions
$('#createUserForm').submit(function(e) {
    e.preventDefault();
    const btn = $('#createBtn');
    Loading.button(btn[0], true);
    
    $.post('/Admin/Users/Create', $(this).serialize(), function(res) {
        Loading.button(btn[0], false);
        if (res.success) {
            bootstrap.Modal.getInstance('#createUserModal').hide();
            $('#createUserForm')[0].reset();
            Toast.success('User created successfully');
            loadUsers();
        } else {
            Toast.error(res.message);
        }
    });
});

$('#editUserForm').submit(function(e) {
    e.preventDefault();
    const btn = $('#editBtn');
    Loading.button(btn[0], true);
    
    $.post('/Admin/Users/Update', $(this).serialize(), function(res) {
        Loading.button(btn[0], false);
        if (res.success) {
            bootstrap.Modal.getInstance('#editUserModal').hide();
            Toast.success('User updated successfully');
            loadUsers();
        } else {
            Toast.error(res.message);
        }
    });
});

$('#resetPasswordForm').submit(function(e) {
    e.preventDefault();
    const btn = $('#resetBtn');
    Loading.button(btn[0], true);
    
    $.post('/Admin/Users/ResetPassword', $(this).serialize(), function(res) {
        Loading.button(btn[0], false);
        if (res.success) {
            bootstrap.Modal.getInstance('#resetPasswordModal').hide();
            $('#resetPasswordForm')[0].reset();
            Toast.success('Password reset successfully');
        } else {
            Toast.error(res.message);
        }
    });
});

// SignalR real-time updates listener
document.addEventListener('signalr:update', function(e) {
    if (e.detail.type === 'user' || e.detail.type === 'all' || e.detail.type === 'stats') {
        console.log('[Users] SignalR update received:', e.detail.type);
        loadUsers();
    }
});

// Expose loadUsers globally for SignalR client compatibility
window.loadUsers = loadUsers;
</script>
}
