@{
    var userRole = (Context.Session.GetString("UserRole") ?? "").ToLower();
    var isAuthenticated = Context.Session.GetInt32("UserId") != null;
    var currentPath = Context.Request.Path.ToString().ToLower();
    
    // Determine which sidebar to show based on role or path
    var showAdminSidebar = userRole == "admin" || currentPath.StartsWith("/admin");
    var showSupportSidebar = userRole == "support_admin" && !currentPath.StartsWith("/admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_HeadPartial" />
</head>
<body class="admin-body">
    <!-- Top Navbar -->
    <partial name="_MainNavbarPartial" />
    
    <div class="admin-wrapper">
        <!-- Sidebar based on role -->
        @if (isAuthenticated && showAdminSidebar)
        {
            <partial name="_AdminSidebarPartial" />
        }
        else if (isAuthenticated && showSupportSidebar)
        {
            <partial name="_SupportAdminSidebarPartial" />
        }
        else if (isAuthenticated && userRole == "support_admin")
        {
            <partial name="_SupportAdminSidebarPartial" />
        }
        else if (isAuthenticated)
        {
            <!-- Fallback: show admin sidebar for authenticated users -->
            <partial name="_AdminSidebarPartial" />
        }
        
        <!-- Main Content -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>
    
    <!-- Sidebar Overlay for mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    
    <partial name="_CommonScripts" />
    
    <script>
        // Sidebar toggle for mobile
        document.getElementById('sidebarToggle')?.addEventListener('click', function() {
            document.getElementById('adminSidebar')?.classList.toggle('show');
            document.getElementById('sidebarOverlay')?.classList.toggle('show');
        });
        
        document.getElementById('sidebarOverlay')?.addEventListener('click', function() {
            document.getElementById('adminSidebar')?.classList.remove('show');
            this.classList.remove('show');
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
