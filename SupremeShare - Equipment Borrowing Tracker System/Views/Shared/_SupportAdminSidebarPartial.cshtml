@{
    var currentPath = Context.Request.Path.ToString().ToLower();
}

<aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
        <span class="sidebar-title">Support Admin</span>
    </div>
    
    <nav class="sidebar-nav">
        <ul class="sidebar-menu">
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath == "/supportadmin" || currentPath == "/supportadmin/index" ? "active" : "")" 
                   href="/SupportAdmin">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            
            <li class="sidebar-section">Daily Operations</li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.Contains("/supportadmin/transactions/borrow") ? "active" : "")" 
                   href="/SupportAdmin/Transactions/Borrow">
                    <i class="bi bi-box-arrow-up"></i>
                    <span>Process Borrow</span>
                </a>
            </li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.Contains("/supportadmin/transactions/return") ? "active" : "")" 
                   href="/SupportAdmin/Transactions/Return">
                    <i class="bi bi-box-arrow-in-down"></i>
                    <span>Process Return</span>
                </a>
            </li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath == "/supportadmin/transactions" ? "active" : "")" 
                   href="/SupportAdmin/Transactions">
                    <i class="bi bi-list-ul"></i>
                    <span>View Transactions</span>
                </a>
            </li>
            
            <li class="sidebar-section">Reference Data (View Only)</li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.Contains("/supportadmin/students") ? "active" : "")" 
                   href="/SupportAdmin/Students">
                    <i class="bi bi-mortarboard"></i>
                    <span>Students</span>
                </a>
            </li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.Contains("/supportadmin/equipment") ? "active" : "")" 
                   href="/SupportAdmin/Equipment">
                    <i class="bi bi-box-seam"></i>
                    <span>Equipment</span>
                </a>
            </li>
        </ul>
    </nav>
</aside>
