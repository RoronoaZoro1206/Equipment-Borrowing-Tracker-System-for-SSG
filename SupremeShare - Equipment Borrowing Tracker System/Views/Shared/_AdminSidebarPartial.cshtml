@{
    var currentPath = Context.Request.Path.ToString().ToLower();
}

<aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
        <span class="sidebar-title">Admin Panel</span>
    </div>
    
    <nav class="sidebar-nav">
        <ul class="sidebar-menu">
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath == "/admin" || currentPath == "/admin/index" ? "active" : "")" 
                   href="/Admin">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            
            <li class="sidebar-section">Management</li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.StartsWith("/admin/equipment") ? "active" : "")" 
                   href="/Admin/Equipment">
                    <i class="bi bi-box-seam"></i>
                    <span>Equipment</span>
                </a>
            </li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.StartsWith("/admin/transactions") ? "active" : "")" 
                   href="/Admin/Transactions">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Transactions</span>
                </a>
            </li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.StartsWith("/admin/students") ? "active" : "")" 
                   href="/Admin/Students">
                    <i class="bi bi-mortarboard"></i>
                    <span>Students</span>
                </a>
            </li>
            
            <li class="sidebar-section">Administration</li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.StartsWith("/admin/users") ? "active" : "")" 
                   href="/Admin/Users">
                    <i class="bi bi-person-gear"></i>
                    <span>User Management</span>
                </a>
            </li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.StartsWith("/admin/auditlog") ? "active" : "")" 
                   href="/Admin/AuditLog">
                    <i class="bi bi-journal-text"></i>
                    <span>Audit Logs</span>
                </a>
            </li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.StartsWith("/admin/reports") ? "active" : "")" 
                   href="/Admin/Reports">
                    <i class="bi bi-graph-up"></i>
                    <span>Reports</span>
                </a>
            </li>
            
            <li class="sidebar-section">Advanced</li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.StartsWith("/admin/bulkoperations") ? "active" : "")" 
                   href="/Admin/BulkOperations">
                    <i class="bi bi-stack"></i>
                    <span>Bulk Operations</span>
                </a>
            </li>
            
            <li class="sidebar-section">Account</li>
            
            <li class="sidebar-item">
                <a class="sidebar-link @(currentPath.StartsWith("/admin/account") || currentPath == "/account" ? "active" : "")" 
                   href="/Admin/Account">
                    <i class="bi bi-person-circle"></i>
                    <span>My Account</span>
                </a>
            </li>
        </ul>
    </nav>
</aside>
