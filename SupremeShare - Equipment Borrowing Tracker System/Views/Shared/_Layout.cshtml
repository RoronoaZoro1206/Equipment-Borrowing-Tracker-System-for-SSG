<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SupremeShare - Premium Equipment Management Solution" />
    <title>@ViewData["Title"] - SupremeShare</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (Context.Session.GetInt32("UserId") == null)
    {
        <!-- Public Navigation -->
        <nav class="navbar navbar-expand-lg navbar-premium fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Logo" class="navbar-logo" style="margin-right: 15px; position: relative; top: 2px;" />
                    Supreme<span>Share</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item ms-lg-3">
                            <a class="nav-link btn-nav-login" asp-controller="Auth" asp-action="Login">
                                Sign In
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    }
    else
    {
        <!-- Authenticated Navigation -->
        <nav class="navbar navbar-expand-lg navbar-premium">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Dashboard" asp-action="Index">
                    <img src="~/images/logo.png" alt="Logo" class="navbar-logo me-2" />
                    Supreme<span>Share</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>
                                @Context.Session.GetString("FullName")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    }

    <main>
        @RenderBody()
    </main>

    @if (Context.Session.GetInt32("UserId") == null)
    {
        <!-- Public Footer -->
        <footer class="footer-premium">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 mb-4 mb-lg-0">
                        <div class="footer-brand">Supreme<span>Share</span></div>
                        <p class="footer-text">
                            Streamlined equipment management for modern organizations.
                        </p>
                    </div>
                    <div class="col-lg-8">
                        <div class="row">
                            <div class="col-6 col-md-4">
                                <h6 class="text-white mb-3">Platform</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2"><a href="#features" class="text-decoration-none" style="color: inherit;">Features</a></li>
                                    <li class="mb-2"><a href="#" class="text-decoration-none" style="color: inherit;">Security</a></li>
                                </ul>
                            </div>
                            <div class="col-6 col-md-4">
                                <h6 class="text-white mb-3">Access</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2"><a asp-controller="Auth" asp-action="Login" class="text-decoration-none" style="color: inherit;">Sign In</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p class="mb-0">&copy; @DateTime.Now.Year SupremeShare. All rights reserved.</p>
                </div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
